<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Account - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
    <link rel="stylesheet" href="/css/user/profile.css" />
</head>

<body>

    <%- include('partials/header') %>

    <main class="dashboard-wrapper">
        <div class="dashboard-container">
            
            <!-- Breadcrumbs -->
            <div class="breadcrumbs">
                <a href="/">Home</a>
                <span>&rsaquo;</span>
                <a href="/user/profile">My Account</a>
                <span>&rsaquo;</span>
                <strong>My Account</strong>
            </div>

            <!-- Dashboard Header -->
            <div class="dashboard-header">
                <div class="dashboard-tagline">Account Dashboard</div>
                <h1 class="dashboard-title">My Account</h1>
                <p class="dashboard-subtitle">
                    Manage your profile, addresses, orders, wallet, and security settings in one elegant space.
                </p>
            </div>

            <!-- Main Layout Grid -->
            <div class="dashboard-grid">
                
                <!-- Sidebar -->
                <aside class="sidebar-nav">
                    <a href="/user/profile" class="nav-item active">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        Profile Information
                    </a>

                    <a href="/user/addresses" class="nav-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        Saved Addresses
                    </a>

                    <a href="/user/profile/change-password" class="nav-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        Security Settings
                    </a>

                    <a href="#" class="nav-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                            <line x1="1" y1="10" x2="23" y2="10"></line>
                        </svg>
                        My Wallet
                    </a>

                    <a href="#" class="nav-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        My Referrals
                    </a>

                    <form action="/user/logout" method="POST" style="margin-top: 12px;">
                        <button type="submit" class="nav-item signout-btn">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Sign Out
                        </button>
                    </form>
                </aside>

                <!-- Content Area -->
                <section class="content-area">

                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert-success-banner" style="background: rgba(46, 213, 115, 0.12); border: 1px solid rgba(46, 213, 115, 0.35); color: #2ed573; padding: 14px 20px; border-radius: 10px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; font-size: 14px; font-weight: 500;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                            <span><%= success %></span>
                        </div>
                    <% } %>
                    
                    <div class="section-header">
                        <div>
                            <h2 class="section-title">Profile Information</h2>
                            <p class="section-subtitle">Manage your personal details and account preferences.</p>
                        </div>
                        <a href="/user/profile/edit" class="edit-btn">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 20h9"></path>
                                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                            </svg>
                            Edit Profile
                        </a>
                    </div>

                    <!-- Profile Details Card -->
                    <div class="profile-card">
                        
                        <div class="avatar-wrapper">
                            <img 
                                src="<%= user.imgUrl || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name) + '&background=111111&color=ffffff&size=150' %>" 
                                alt="<%= user.name %>" 
                                class="avatar-img"
                            />
                            <div class="avatar-badge">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                    <circle cx="12" cy="13" r="4"></circle>
                                </svg>
                            </div>
                        </div>

                        <div class="details-grid">
                            
                            <div class="detail-item">
                                <span class="detail-label">Full Name</span>
                                <span class="detail-value"><%= user.name.toUpperCase() %></span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">Email Address</span>
                                <span class="detail-value">
                                    <%= user.email %>
                                    <a href="/user/profile/change-email" title="Change Email" style="color: #111111; margin-left: 6px;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 20h9"></path>
                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                        </svg>
                                    </a>
                                </span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">Phone Number</span>
                                <span class="detail-value"><%= user.phone || 'Not added' %></span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">Member Since</span>
                                <span class="detail-value">
                                    <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-GB') : 'N/A' %>
                                </span>
                            </div>

                        </div>

                    </div>

                </section>

            </div>

        </div>
    </main>

    <%- include('partials/footer') %>

</body>

</html>