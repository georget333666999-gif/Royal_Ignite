<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Address - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
    <link rel="stylesheet" href="/css/user/profile.css" />
</head>

<body>

    <%- include('partials/header') %>

    <div class="modal-overlay">
        <div class="modal-card">
            
            <a href="/user/addresses" class="modal-close" title="Close">&times;</a>

            <h2 class="modal-title">Edit Address</h2>

            <% if (error) { %>
                <div class="error-badge"><%= error %></div>
            <% } %>

            <form action="/user/addresses/edit/<%= address._id %>" method="POST">
                
                <div class="modal-form-grid">
                    
                    <div class="form-group">
                        <label for="fullName">Full Name *</label>
                        <input
                            type="text"
                            id="fullName"
                            name="fullName"
                            class="form-input"
                            value="<%= address.fullName %>"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="phone">Phone Number *</label>
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            class="form-input"
                            value="<%= address.phone %>"
                            maxlength="10"
                            required
                        />
                    </div>

                    <div class="form-group" style="grid-column: span 2;">
                        <label for="addressLine">Address / Street / House *</label>
                        <textarea
                            id="addressLine"
                            name="addressLine"
                            class="form-input"
                            style="height: 70px; resize: none;"
                            required
                        ><%= address.addressLine %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="city">City / Town *</label>
                        <input
                            type="text"
                            id="city"
                            name="city"
                            class="form-input"
                            value="<%= address.city %>"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="state">State *</label>
                        <input
                            type="text"
                            id="state"
                            name="state"
                            class="form-input"
                            value="<%= address.state %>"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="pincode">Pincode *</label>
                        <input
                            type="text"
                            id="pincode"
                            name="pincode"
                            class="form-input"
                            value="<%= address.pincode %>"
                            maxlength="6"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="country">Country *</label>
                        <input
                            type="text"
                            id="country"
                            name="country"
                            class="form-input"
                            value="<%= address.country %>"
                            required
                        />
                    </div>

                </div>

                <div class="form-group" style="margin-bottom: 24px;">
                    <label style="display: inline-flex; align-items: center; gap: 8px; cursor: pointer;">
                        <input
                            type="checkbox"
                            name="isDefault"
                            value="true"
                            <%= address.isDefault ? "checked" : "" %>
                            style="width: 16px; height: 16px;"
                        />
                        Set as default delivery address
                    </label>
                </div>

                <!-- Footer Actions -->
                <div class="modal-actions">
                    <a href="/user/addresses" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-save">SAVE CHANGES</button>
                </div>

            </form>

        </div>
    </div>

    <%- include('partials/footer') %>

</body>

</html>
