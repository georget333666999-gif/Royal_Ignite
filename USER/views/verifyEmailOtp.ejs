<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify New Email - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
</head>

<body>

    <%- include('partials/header') %>

    <main class="auth-wrapper">
        <div class="gold-card" style="text-align: center;">
            
            <h1 class="auth-title">Verify New Email</h1>
            <p class="auth-subtitle">
                Enter the 6-digit OTP sent to: <strong><%= pendingEmail %></strong>
            </p>

            <% if (error) { %>
                <div class="error-badge"><%= error %></div>
            <% } %>

            <form action="/user/profile/verify-email-otp" method="POST">
                
                <div class="form-group" style="text-align: left;">
                    <input
                        type="text"
                        id="otpCode"
                        name="otpCode"
                        class="form-input"
                        placeholder="Enter 6-digit OTP"
                        maxlength="6"
                        minlength="6"
                        style="text-align: center; font-size: 20px; letter-spacing: 6px; font-weight: bold;"
                        required
                    />
                </div>

                <button type="submit" class="primary-btn">
                    CONFIRM & CHANGE EMAIL &rarr;
                </button>

            </form>

            <div class="auth-switch" style="margin-top: 24px;">
                <a href="/user/profile/change-email">&larr; Re-enter Email</a>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>

</body>

</html>
