<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Email Address - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
</head>

<body>

    <%- include('partials/header') %>

    <main class="auth-wrapper">
        <div class="gold-card">
            
            <h1 class="auth-title">Change Email Address</h1>
            <p class="auth-subtitle">
                Enter your new email address. We will send an OTP code to verify ownership.
            </p>

            <% if (typeof currentEmail !== "undefined" && currentEmail) { %>
                <div style="margin-bottom: 20px; font-size: 13px; color: #a8a196; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); padding: 10px 14px; border-radius: 8px;">
                    Current Email: <strong style="color: #ede8e1;"><%= currentEmail %></strong>
                </div>
            <% } %>

            <% if (typeof error !== "undefined" && error) { %>
                <div class="error-badge"><%= error %></div>
            <% } %>

            <form action="/user/profile/change-email" method="POST" id="changeEmailForm" novalidate>
                
                <div class="form-group">
                    <label for="newEmail">New Email Address *</label>
                    <input
                        type="email"
                        id="newEmail"
                        name="newEmail"
                        class="form-input"
                        placeholder="e.g. new.email@example.com"
                        value="<%= typeof newEmail !== 'undefined' ? newEmail : '' %>"
                        data-validate="email"
                        data-current-email="<%= typeof currentEmail !== 'undefined' ? currentEmail : '' %>"
                        required
                    />
                </div>

                <button type="submit" class="primary-btn">
                    SEND VERIFICATION OTP &rarr;
                </button>

            </form>

            <div class="auth-switch" style="margin-top: 24px;">
                <a href="/user/profile/edit">&larr; Back to Edit Profile</a>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/validation.js"></script>

</body>

</html>
