<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Security Settings - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
    <link rel="stylesheet" href="/css/user/profile.css" />
</head>

<body class="profile-page">

    <%- include('partials/header') %>

    <main class="dashboard-wrapper">
        <div class="dashboard-container">
            
            <!-- Breadcrumbs -->
            <div class="breadcrumbs">
                <a href="/">Home</a>
                <span class="breadcrumb-separator">&rsaquo;</span>
                <a href="/user/profile">My Account</a>
                <span class="breadcrumb-separator">&rsaquo;</span>
                <span class="breadcrumb-current">Security Settings</span>
            </div>

            <!-- Dashboard Header -->
            <div class="dashboard-header">
                <div class="dashboard-tagline">
                    <span class="tagline-dot"></span>
                    Account Security
                </div>
                <h1 class="dashboard-title">Security Settings</h1>
                <p class="dashboard-subtitle">
                    Manage your credentials, password, and security preferences to keep your Royal Ignite account safe.
                </p>
            </div>

            <!-- Global Notifications / Alerts -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="profile-alert profile-alert-success">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                    <span><%= success %></span>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="profile-alert profile-alert-error">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <!-- Main Layout Grid -->
            <div class="dashboard-grid">
                
                <!-- Sidebar Navigation -->
                <aside class="sidebar-nav">
                    <div class="sidebar-menu">
                        <a href="/user/profile" class="nav-item">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <span>Profile Information</span>
                        </a>

                        <a href="/user/addresses" class="nav-item">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>Saved Addresses</span>
                        </a>

                        <a href="/user/profile/change-password" class="nav-item active">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <span>Security Settings</span>
                        </a>

                        <a href="#" class="nav-item">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                <line x1="1" y1="10" x2="23" y2="10"></line>
                            </svg>
                            <span>My Wallet</span>
                        </a>

                        <a href="#" class="nav-item">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            <span>My Referrals</span>
                        </a>
                    </div>

                    <div class="sidebar-footer">
                        <form action="/user/logout" method="POST">
                            <button type="submit" class="nav-item signout-btn">
                                <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                                <span>Sign Out</span>
                            </button>
                        </form>
                    </div>
                </aside>

                <!-- Content Area -->
                <section class="content-area">
                    
                    <% if (typeof user !== 'undefined' && user && user.googleId) { %>
                        
                        <!-- Google OAuth Managed State -->
                        <div class="security-panel">
                            <div class="google-managed-card">
                                <div class="google-icon-circle">
                                    <svg width="32" height="32" viewBox="0 0 24 24">
                                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                                    </svg>
                                </div>

                                <h2 class="google-managed-title">Managed by Google</h2>
                                <p class="google-managed-desc">
                                    Your Royal Ignite account is secured and authenticated exclusively through <strong>Google Sign-In</strong>. You do not have a local password on this platform.
                                </p>

                                <div class="google-info-box">
                                    <div class="google-info-title">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d48833" stroke-width="2">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                        </svg>
                                        Google Account Security & 2FA
                                    </div>
                                    <div class="google-info-desc">
                                        To update your password, two-factor authentication, or security questions, please manage your account via <a href="https://myaccount.google.com/security" target="_blank" rel="noopener noreferrer">Google Security Settings &nearr;</a>
                                    </div>
                                </div>

                                <a href="/user/profile" class="btn-update-pwd" style="text-decoration: none;">
                                    RETURN TO ACCOUNT
                                </a>
                            </div>
                        </div>

                    <% } else { %>

                        <!-- Standard Change Password Form Panel -->
                        <div class="security-panel">
                            
                            <!-- Header Inside Panel -->
                            <div class="security-panel-header">
                                <div class="security-icon-badge">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                </div>
                                <div class="security-header-text">
                                    <h2 class="security-panel-title">Update Password</h2>
                                    <p class="security-panel-subtitle">Ensure your account is protected with a strong, distinct password.</p>
                                </div>
                            </div>

                            <div class="security-form-container">
                                <form action="/user/profile/change-password" method="POST" id="changePasswordForm" class="security-form" novalidate>
                                    
                                    <!-- Current Password -->
                                    <div class="form-group">
                                        <label for="currentPassword">Current Password *</label>
                                        <input
                                            type="password"
                                            id="currentPassword"
                                            name="currentPassword"
                                            class="form-input"
                                            placeholder="Enter your current password"
                                            data-validate="currentPassword"
                                            required
                                        />
                                    </div>

                                    <!-- New Password -->
                                    <div class="form-group">
                                        <label for="newPassword">New Password *</label>
                                        <input
                                            type="password"
                                            id="newPassword"
                                            name="newPassword"
                                            class="form-input"
                                            placeholder="Minimum 8 characters (letters & numbers)"
                                            data-validate="newPassword"
                                            required
                                        />
                                    </div>

                                    <!-- Confirm New Password -->
                                    <div class="form-group">
                                        <label for="confirmPassword">Confirm New Password *</label>
                                        <input
                                            type="password"
                                            id="confirmPassword"
                                            name="confirmPassword"
                                            class="form-input"
                                            placeholder="Re-enter your new password"
                                            data-validate="confirmPassword"
                                            required
                                        />
                                    </div>

                                    <!-- Security Guidelines Box -->
                                    <div class="security-guidelines-box">
                                        <div class="guidelines-title">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                            </svg>
                                            Password Requirements
                                        </div>
                                        <ul class="guidelines-list">
                                            <li class="guidelines-item">
                                                <span class="guidelines-bullet"></span>
                                                Must be at least 8 characters in length
                                            </li>
                                            <li class="guidelines-item">
                                                <span class="guidelines-bullet"></span>
                                                Must contain at least one letter and one number
                                            </li>
                                            <li class="guidelines-item">
                                                <span class="guidelines-bullet"></span>
                                                Must be different from your current password
                                            </li>
                                            <li class="guidelines-item">
                                                <span class="guidelines-bullet"></span>
                                                Confirmation must match your new password
                                            </li>
                                        </ul>
                                    </div>

                                    <!-- Form Action Buttons -->
                                    <div class="security-actions">
                                        <button type="submit" class="btn-update-pwd">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                            </svg>
                                            SAVE NEW PASSWORD
                                        </button>
                                        <a href="/user/profile" class="btn-back-profile">
                                            Cancel
                                        </a>
                                    </div>

                                </form>
                            </div>

                        </div>

                    <% } %>

                </section>

            </div>

        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/validation.js"></script>

</body>

</html>
