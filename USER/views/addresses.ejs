<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Saved Addresses - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
    <link rel="stylesheet" href="/css/user/profile.css" />
    <!-- SweetAlert2 for Quiet Luxury Pop-ups -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .royal-luxury-swal {
            background: #141312 !important;
            border: 1px solid rgba(212, 136, 51, 0.28) !important;
            border-radius: 16px !important;
            padding: 26px 22px !important;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75) !important;
            color: #f0ece6 !important;
            font-family: 'Instrument Sans', sans-serif !important;
        }
        .royal-swal-title {
            font-family: 'DM Serif Display', serif !important;
            color: #ffffff !important;
            font-size: 22px !important;
            letter-spacing: 0.3px !important;
            margin-bottom: 8px !important;
        }
        .royal-swal-confirm-btn {
            border-radius: 8px !important;
            font-weight: 600 !important;
            font-size: 13px !important;
            letter-spacing: 0.4px !important;
            padding: 10px 22px !important;
            box-shadow: none !important;
            cursor: pointer !important;
        }
        .royal-swal-cancel-btn {
            border-radius: 8px !important;
            font-weight: 500 !important;
            font-size: 13px !important;
            letter-spacing: 0.4px !important;
            padding: 10px 20px !important;
            background: #27272a !important;
            color: #d4d4d8 !important;
            box-shadow: none !important;
            cursor: pointer !important;
        }
        .royal-swal-cancel-btn:hover {
            background: #3f3f46 !important;
            color: #ffffff !important;
        }
    </style>
</head>

<body>

    <%- include('partials/header') %>

    <main class="dashboard-wrapper">
        <div class="dashboard-container">
            
            <!-- Breadcrumbs -->
            <div class="breadcrumbs">
                <a href="/">Home</a>
                <span>&rsaquo;</span>
                <a href="/user/profile">My Account</a>
                <span>&rsaquo;</span>
                <strong>Saved Addresses</strong>
            </div>

            <!-- Dashboard Header -->
            <div class="dashboard-header">
                <div class="dashboard-tagline">ACCOUNT DASHBOARD</div>
                <h1 class="dashboard-title">Saved Addresses</h1>
                <p class="dashboard-subtitle">
                    Manage your delivery addresses for faster and seamless checkout experiences. Add new locations or update your default preferences.
                </p>
            </div>

            <!-- Main Layout Grid -->
            <div class="dashboard-grid">
                
                <!-- Sidebar -->
                <aside class="sidebar-nav">
                    <a href="/user/profile" class="nav-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        Profile Information
                    </a>

                    <a href="/user/addresses" class="nav-item active">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        Saved Addresses
                    </a>

                    <% if (typeof user === 'undefined' || !user || !user.googleId) { %>
                        <a href="/user/profile/change-password" class="nav-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            Security Settings
                        </a>
                    <% } %>

                    <a href="#" class="nav-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                            <line x1="1" y1="10" x2="23" y2="10"></line>
                        </svg>
                        My Wallet
                    </a>

                    <a href="#" class="nav-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        My Referrals
                    </a>

                    <form action="/user/logout" method="POST" style="margin-top: 12px;">
                        <button type="submit" class="nav-item signout-btn">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Sign Out
                        </button>
                    </form>
                </aside>

                <!-- Content Area -->
                <section class="content-area">
                    
                    <div class="section-header">
                        <div>
                            <h2 class="section-title">My Addresses</h2>
                            <p class="section-subtitle">Save and manage your preferred delivery locations.</p>
                        </div>
                        <a href="/user/addresses/add" class="edit-btn">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Add New Address
                        </a>
                    </div>

                    <!-- Address Cards Grid -->
                    <% if (addresses.length === 0) { %>
                        <div class="profile-card" style="justify-content: center; text-align: center; padding: 60px;">
                            <p style="font-size: 16px; color: #444444;">No delivery addresses saved yet. Click above to add your first address!</p>
                        </div>
                    <% } else { %>
                        <div class="address-grid">
                            <% addresses.forEach(address => { %>
                                <div class="address-card <%= address.isDefault ? 'default-card' : '' %>">
                                    
                                    <div>
                                        <div class="card-header-flex">
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <h3 class="address-name"><%= address.fullName %></h3>
                                                <% if (address.addressType) { %>
                                                    <span style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); padding: 2px 8px; border-radius: 10px; font-size: 10px; color: #a8a29a; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;"><%= address.addressType %></span>
                                                <% } %>
                                            </div>
                                            <% if (address.isDefault) { %>
                                                <span class="badge-default">DEFAULT</span>
                                            <% } %>
                                        </div>

                                        <div class="address-details">
                                            <p><%= address.addressLine %></p>
                                            <p><%= address.city %>, <%= address.state %></p>
                                            <p><%= address.country %> - <%= address.pincode %></p>
                                            <p class="address-phone">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                                </svg>
                                                <%= address.phone %>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="card-action-bar">
                                        <div style="display: flex; gap: 8px;">
                                            <a href="/user/addresses/edit/<%= address._id %>" class="btn-edit-addr">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M12 20h9"></path>
                                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                                </svg>
                                                Edit
                                            </a>

                                            <form action="/user/addresses/delete/<%= address._id %>" method="POST" style="display: inline;" class="delete-address-form" data-name="<%= address.fullName %>">
                                                <button type="submit" class="btn-delete-addr">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <polyline points="3 6 5 6 21 6"></polyline>
                                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                    </svg>
                                                    DELETE
                                                </button>
                                            </form>
                                        </div>

                                        <% if (!address.isDefault) { %>
                                            <form action="/user/addresses/default/<%= address._id %>" method="POST" style="display: inline;">
                                                <button type="submit" class="btn-set-default">
                                                    Set as Default
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>

                                </div>
                            <% }) %>
                        </div>
                    <% } %>

                </section>

            </div>

        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        // Luxury SweetAlert2 confirmation for deleting an address
        document.addEventListener('submit', function (e) {
            const form = e.target;
            if (!form.classList || !form.classList.contains('delete-address-form')) return;
            if (form.dataset.confirmed === 'true') return;

            e.preventDefault();
            const recipientName = form.dataset.name ? ` for <strong>${form.dataset.name}</strong>` : '';

            Swal.fire({
                title: 'Delete Address?',
                html: `Are you sure you want to remove this delivery address${recipientName}?<br><span style="font-size: 13px; color: #a1a1aa; display: block; margin-top: 8px;">This action cannot be undone.</span>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#27272a',
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel',
                reverseButtons: true,
                iconColor: '#ef4444',
                customClass: {
                    popup: 'royal-luxury-swal',
                    title: 'royal-swal-title',
                    confirmButton: 'royal-swal-confirm-btn',
                    cancelButton: 'royal-swal-cancel-btn'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.dataset.confirmed = 'true';
                    form.submit();
                }
            });
        });

        // Flash message toast notification
        <% if (typeof success !== 'undefined' && success) { %>
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: '<%= success %>',
                showConfirmButton: false,
                timer: 3500,
                timerProgressBar: true,
                background: '#141312',
                color: '#f0ece6',
                iconColor: '#d48833'
            });
        <% } %>
    </script>

</body>

</html>