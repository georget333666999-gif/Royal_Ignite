<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
</head>

<body>

    <%- include('partials/header') %>

    <main class="auth-wrapper">
        <div class="gold-card" style="text-align: center;">
            
            <!-- Key Icon Pill -->
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; background: rgba(255, 255, 255, 0.4); border-radius: 12px; margin-bottom: 16px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#050505" stroke-width="1.8">
                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.778-7.778zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
                </svg>
            </div>

            <h1 class="auth-title">Forgot Password</h1>
            <p class="auth-subtitle">
                Enter your email address and we'll send you a code to reset your password.
            </p>

            <% if (error) { %>
                <div class="error-badge"><%= error %></div>
            <% } %>

            <% if (success) { %>
                <div class="success-badge"><%= success %></div>
            <% } %>

            <form action="/user/forgot-password" method="POST" style="text-align: left;" novalidate>
                
                <div class="form-group">
                    <label for="email">Email Address *</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-input"
                        placeholder="e.g. john@example.com"
                        data-validate="email"
                        required
                    />
                </div>

                <button type="submit" class="primary-btn">
                    SEND CODE &rarr;
                </button>

            </form>

            <div class="auth-switch" style="margin-top: 24px;">
                <a href="/user/login">&larr; Back to Login</a>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/validation.js"></script>

</body>

</html>
