<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Two-Step Verification - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
</head>

<body>

    <%- include('partials/header') %>

    <main class="auth-wrapper">
        <div class="gold-card" style="text-align: center;">
            
            <h1 class="auth-title">Two-Step Verification</h1>
            <p class="auth-subtitle">
                Enter the 6-digit code sent to your email
            </p>

            <% if (error) { %>
                <div class="error-badge"><%= error %></div>
            <% } %>

            <form action="/user/verify-otp" method="POST">
                
                <div class="form-group" style="text-align: left;">
                    <input
                        type="text"
                        id="otpCode"
                        name="otpCode"
                        class="form-input"
                        placeholder="Enter 6-digit OTP"
                        maxlength="6"
                        minlength="6"
                        style="text-align: center; font-size: 20px; letter-spacing: 6px; font-weight: bold;"
                        required
                    />
                </div>

                <button type="submit" class="primary-btn">
                    VERIFY IDENTITY &rarr;
                </button>

            </form>

            <div class="auth-switch" style="margin-top: 24px;">
                Didn't receive the code?
                <form action="/user/resend-otp" method="POST" id="resendForm" style="display: inline;">
                    <button type="submit" id="resendButton" style="background: none; border: none; font-weight: 600; color: #050505; cursor: pointer; text-decoration: underline;" disabled>
                        Resend Code
                    </button>
                </form>
            </div>

            <div style="margin-top: 16px; display: inline-flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, 0.4); padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 500;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>EXPIRES IN <strong id="timer">01:00</strong></span>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        let otpTimeLeft = 60;
        const timerElement = document.getElementById("timer");
        const resendButton = document.getElementById("resendButton");

        function updateOtpTimer() {
            const minutes = Math.floor(otpTimeLeft / 60);
            const seconds = otpTimeLeft % 60;

            timerElement.textContent =
                String(minutes).padStart(2, "0") + ":" + String(seconds).padStart(2, "0");

            if (otpTimeLeft <= 0) {
                clearInterval(otpTimer);
                timerElement.textContent = "00:00";
                return;
            }
            otpTimeLeft--;
        }

        updateOtpTimer();
        const otpTimer = setInterval(updateOtpTimer, 1000);

        let resendTimeLeft = 30;

        function updateResendTimer() {
            if (resendTimeLeft <= 0) {
                clearInterval(resendTimer);
                resendButton.disabled = false;
                resendButton.textContent = "Resend Code";
                return;
            }
            resendButton.disabled = true;
            resendButton.textContent = `Resend Code (${resendTimeLeft}s)`;
            resendTimeLeft--;
        }

        updateResendTimer();
        const resendTimer = setInterval(updateResendTimer, 1000);
    </script>

</body>

</html>