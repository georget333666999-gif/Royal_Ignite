    <!-- Footer Partial -->
    <%- include('./partials/footer.ejs') %>

    <!-- Checkout Scripts -->
    <script>
        // BFCache handling: Force fresh state if user navigated back
        window.addEventListener('pageshow', function (event) {
            const isBackForward = event.persisted || 
                (window.performance && window.performance.navigation && window.performance.navigation.type === 2) ||
                (window.performance && window.performance.getEntriesByType && window.performance.getEntriesByType("navigation")[0]?.type === "back_forward");

            if (isBackForward) {
                window.location.reload();
            }
        });

        // Select an address card
        function selectAddress(addressId, cardElement) {
            document.getElementById('selectedAddressId').value = addressId;
            document.querySelectorAll('.address-select-card').forEach(card => card.classList.remove('selected'));
            if (cardElement) cardElement.classList.add('selected');
        }

        // Add Address Modal controls
        function openAddAddressModal() {
            if (typeof checkoutAddressValidator !== 'undefined') {
                checkoutAddressValidator.clearAll('add');
            }
            const form = document.getElementById('addAddressForm');
            if (form) form.reset();
            document.getElementById('addAddressModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeAddAddressModal() {
            if (typeof checkoutAddressValidator !== 'undefined') {
                checkoutAddressValidator.clearAll('add');
            }
            document.getElementById('addAddressModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        // Edit Address Modal controls
        function openEditAddressModal(addressId, addrData) {
            if (typeof checkoutAddressValidator !== 'undefined') {
                checkoutAddressValidator.clearAll('edit');
            }
            document.getElementById('editAddressId').value = addressId;
            document.getElementById('editFullName').value = addrData.fullName || '';
            document.getElementById('editPhone').value = addrData.phone || '';
            document.getElementById('editAddressLine').value = addrData.addressLine || '';
            document.getElementById('editCity').value = addrData.city || '';
            document.getElementById('editState').value = addrData.state || '';
            document.getElementById('editPincode').value = addrData.pincode || '';
            document.getElementById('editAddressType').value = addrData.addressType || 'Home';
            document.getElementById('editIsDefault').checked = Boolean(addrData.isDefault);

            document.getElementById('editAddressModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeEditAddressModal() {
            if (typeof checkoutAddressValidator !== 'undefined') {
                checkoutAddressValidator.clearAll('edit');
            }
            document.getElementById('editAddressModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        // ==========================================
        // Unified Checkout Address Validation
        // ==========================================
        const checkoutAddressValidator = {
            nameRegex: /^[a-zA-Z\s]{2,50}$/,
            phoneRegex: /^[6-9]\d{9}$/,
            placeRegex: /^[a-zA-Z\s.'-]{2,50}$/,
            pincodeRegex: /^[1-9][0-9]{5}$/,
            fields: ['FullName', 'Phone', 'AddressLine', 'City', 'State', 'Pincode', 'AddressType'],

            showError(prefix, field, message) {
                const inputId = prefix + field;
                const errId = 'err-' + inputId;
                const inputEl = document.getElementById(inputId);
                const errorEl = document.getElementById(errId);
                if (inputEl) {
                    inputEl.classList.add('input-error');
                }
                if (errorEl) {
                    errorEl.textContent = message;
                    errorEl.style.display = 'block';
                }
            },

            clearError(prefix, field) {
                const inputId = prefix + field;
                const errId = 'err-' + inputId;
                const inputEl = document.getElementById(inputId);
                const errorEl = document.getElementById(errId);
                if (inputEl) {
                    inputEl.classList.remove('input-error');
                }
                if (errorEl) {
                    errorEl.textContent = '';
                    errorEl.style.display = 'none';
                }
            },

            clearAll(prefix) {
                this.fields.forEach(f => this.clearError(prefix, f));
            },

            validateFullName(prefix) {
                const el = document.getElementById(prefix + 'FullName');
                const val = (el?.value || '').trim();
                if (!val) {
                    this.showError(prefix, 'FullName', 'Recipient full name is required.');
                    return false;
                }
                if (val.length < 2 || val.length > 50) {
                    this.showError(prefix, 'FullName', 'Name must be between 2 and 50 characters.');
                    return false;
                }
                if (!this.nameRegex.test(val)) {
                    this.showError(prefix, 'FullName', 'Full name must contain only letters and spaces.');
                    return false;
                }
                this.clearError(prefix, 'FullName');
                return true;
            },

            validatePhone(prefix) {
                const el = document.getElementById(prefix + 'Phone');
                const val = (el?.value || '').trim();
                if (!val) {
                    this.showError(prefix, 'Phone', '10-digit mobile number is required.');
                    return false;
                }
                if (!this.phoneRegex.test(val)) {
                    this.showError(prefix, 'Phone', 'Must be a valid 10-digit mobile starting with 6-9.');
                    return false;
                }
                if (/^(\d)\1{9}$/.test(val)) {
                    this.showError(prefix, 'Phone', 'Please enter a valid, non-repetitive phone number.');
                    return false;
                }
                this.clearError(prefix, 'Phone');
                return true;
            },

            validateAddressLine(prefix) {
                const el = document.getElementById(prefix + 'AddressLine');
                const val = (el?.value || '').trim();
                if (!val) {
                    this.showError(prefix, 'AddressLine', 'Street / estate address is required.');
                    return false;
                }
                if (val.length < 5) {
                    this.showError(prefix, 'AddressLine', 'Address must be at least 5 characters.');
                    return false;
                }
                if (val.length > 200) {
                    this.showError(prefix, 'AddressLine', 'Address cannot exceed 200 characters.');
                    return false;
                }
                if (!/[a-zA-Z0-9]/.test(val)) {
                    this.showError(prefix, 'AddressLine', 'Address must contain valid building or street details.');
                    return false;
                }
                this.clearError(prefix, 'AddressLine');
                return true;
            },

            validateCity(prefix) {
                const el = document.getElementById(prefix + 'City');
                const val = (el?.value || '').trim();
                if (!val) {
                    this.showError(prefix, 'City', 'City is required.');
                    return false;
                }
                if (val.length < 2 || val.length > 50) {
                    this.showError(prefix, 'City', 'City must be between 2 and 50 characters.');
                    return false;
                }
                if (!this.placeRegex.test(val)) {
                    this.showError(prefix, 'City', 'City must contain only letters and valid punctuation.');
                    return false;
                }
                this.clearError(prefix, 'City');
                return true;
            },

            validateState(prefix) {
                const el = document.getElementById(prefix + 'State');
                const val = (el?.value || '').trim();
                if (!val) {
                    this.showError(prefix, 'State', 'State is required.');
                    return false;
                }
                if (val.length < 2 || val.length > 50) {
                    this.showError(prefix, 'State', 'State must be between 2 and 50 characters.');
                    return false;
                }
                if (!this.placeRegex.test(val)) {
                    this.showError(prefix, 'State', 'State must contain only letters and valid punctuation.');
                    return false;
                }
                this.clearError(prefix, 'State');
                return true;
            },

            validatePincode(prefix) {
                const el = document.getElementById(prefix + 'Pincode');
                const val = (el?.value || '').trim();
                if (!val) {
                    this.showError(prefix, 'Pincode', 'Postal PIN code is required.');
                    return false;
                }
                if (!this.pincodeRegex.test(val)) {
                    this.showError(prefix, 'Pincode', 'Must be a valid 6-digit postal code (cannot start with 0).');
                    return false;
                }
                this.clearError(prefix, 'Pincode');
                return true;
            },

            validateAddressType(prefix) {
                const el = document.getElementById(prefix + 'AddressType');
                const val = (el?.value || '').trim();
                if (!['Home', 'Work', 'Other'].includes(val)) {
                    this.showError(prefix, 'AddressType', 'Please select a valid address category.');
                    return false;
                }
                this.clearError(prefix, 'AddressType');
                return true;
            },

            validateForm(prefix) {
                const validName = this.validateFullName(prefix);
                const validPhone = this.validatePhone(prefix);
                const validAddress = this.validateAddressLine(prefix);
                const validCity = this.validateCity(prefix);
                const validState = this.validateState(prefix);
                const validPincode = this.validatePincode(prefix);
                const validType = this.validateAddressType(prefix);

                // Focus first failing field
                if (!validName) document.getElementById(prefix + 'FullName')?.focus();
                else if (!validPhone) document.getElementById(prefix + 'Phone')?.focus();
                else if (!validAddress) document.getElementById(prefix + 'AddressLine')?.focus();
                else if (!validCity) document.getElementById(prefix + 'City')?.focus();
                else if (!validState) document.getElementById(prefix + 'State')?.focus();
                else if (!validPincode) document.getElementById(prefix + 'Pincode')?.focus();

                return validName && validPhone && validAddress && validCity && validState && validPincode && validType;
            },

            attachListeners(prefix) {
                const phoneInput = document.getElementById(prefix + 'Phone');
                if (phoneInput) {
                    phoneInput.addEventListener('input', () => {
                        phoneInput.value = phoneInput.value.replace(/\D/g, '').slice(0, 10);
                        this.clearError(prefix, 'Phone');
                    });
                    phoneInput.addEventListener('blur', () => this.validatePhone(prefix));
                }

                const pincodeInput = document.getElementById(prefix + 'Pincode');
                if (pincodeInput) {
                    pincodeInput.addEventListener('input', () => {
                        pincodeInput.value = pincodeInput.value.replace(/\D/g, '').slice(0, 6);
                        this.clearError(prefix, 'Pincode');
                    });
                    pincodeInput.addEventListener('blur', () => this.validatePincode(prefix));
                }

                const nameInput = document.getElementById(prefix + 'FullName');
                if (nameInput) {
                    nameInput.addEventListener('input', () => this.clearError(prefix, 'FullName'));
                    nameInput.addEventListener('blur', () => this.validateFullName(prefix));
                }

                const addressInput = document.getElementById(prefix + 'AddressLine');
                if (addressInput) {
                    addressInput.addEventListener('input', () => this.clearError(prefix, 'AddressLine'));
                    addressInput.addEventListener('blur', () => this.validateAddressLine(prefix));
                }

                const cityInput = document.getElementById(prefix + 'City');
                if (cityInput) {
                    cityInput.addEventListener('input', () => this.clearError(prefix, 'City'));
                    cityInput.addEventListener('blur', () => this.validateCity(prefix));
                }

                const stateInput = document.getElementById(prefix + 'State');
                if (stateInput) {
                    stateInput.addEventListener('input', () => this.clearError(prefix, 'State'));
                    stateInput.addEventListener('blur', () => this.validateState(prefix));
                }

                const typeSelect = document.getElementById(prefix + 'AddressType');
                if (typeSelect) {
                    typeSelect.addEventListener('change', () => this.validateAddressType(prefix));
                }
            }
        };

        const editAddressValidators = checkoutAddressValidator;

        // Attach live input and blur validation for both modals
        document.addEventListener('DOMContentLoaded', function () {
            checkoutAddressValidator.attachListeners('add');
            checkoutAddressValidator.attachListeners('edit');
        });

        // Handle Add Address Submission (AJAX)
        async function handleAddAddressSubmit(event) {
            event.preventDefault();

            // Client-side JS validation
            const isValid = checkoutAddressValidator.validateForm('add');
            if (!isValid) {
                return;
            }

            const form = event.target;
            const btn = document.getElementById('btnSaveNewAddress');
            btn.disabled = true;
            btn.textContent = 'Saving...';

            const formData = new FormData(form);
            const dataObj = Object.fromEntries(formData.entries());

            try {
                const response = await fetch('/checkout/address/add', {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(dataObj)
                });

                const data = await response.json();

                if (data.success && data.address) {
                    closeAddAddressModal();
                    form.reset();
                    // Reload page with new address selected
                    window.location.reload();
                } else {
                    btn.disabled = false;
                    btn.textContent = 'Save & Select Address';
                    Swal.fire({
                        icon: 'error',
                        title: 'Notice',
                        text: data.message || 'Unable to save address.',
                        background: '#141312',
                        color: '#eae6df',
                        confirmButtonColor: '#F6BD64'
                    });
                }
            } catch (err) {
                console.error("Add address error:", err);
                btn.disabled = false;
                btn.textContent = 'Save & Select Address';
                Swal.fire({
                    icon: 'error',
                    title: 'Notice',
                    text: 'An error occurred while saving your address.',
                    background: '#141312',
                    color: '#eae6df',
                    confirmButtonColor: '#F6BD64'
                });
            }
        }

        // Handle Edit Address Submission (AJAX)
        async function handleEditAddressSubmit(event) {
            event.preventDefault();

            // Client-side JS validation
            const isValid = checkoutAddressValidator.validateForm('edit');
            if (!isValid) {
                return;
            }

            const form = event.target;
            const addressId = document.getElementById('editAddressId').value;
            const btn = document.getElementById('btnSaveEditedAddress');
            btn.disabled = true;
            btn.textContent = 'Updating...';

            const formData = new FormData(form);
            const dataObj = Object.fromEntries(formData.entries());

            try {
                const response = await fetch(`/checkout/address/edit/${addressId}`, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(dataObj)
                });

                const data = await response.json();

                if (data.success && data.address) {
                    closeEditAddressModal();
                    window.location.reload();
                } else {
                    btn.disabled = false;
                    btn.textContent = 'Update Address';
                    Swal.fire({
                        icon: 'error',
                        title: 'Notice',
                        text: data.message || 'Unable to update address.',
                        background: '#141312',
                        color: '#eae6df',
                        confirmButtonColor: '#F6BD64'
                    });
                }
            } catch (err) {
                console.error("Edit address error:", err);
                btn.disabled = false;
                btn.textContent = 'Update Address';
                Swal.fire({
                    icon: 'error',
                    title: 'Notice',
                    text: 'An error occurred while updating your address.',
                    background: '#141312',
                    color: '#eae6df',
                    confirmButtonColor: '#F6BD64'
                });
            }
        }

        const RAZORPAY_KEY_ID = '<%= razorpayKeyId || "" %>';
        const USER_FULL_NAME = '<%= (user && (user.name || user.fullName)) ? (user.name || user.fullName).replace(/'/g, "\\'") : "" %>';
        const USER_EMAIL = '<%= (user && user.email) ? user.email : "" %>';
        const USER_PHONE = '<%= (user && user.phone) ? user.phone : "" %>';
        const CURRENT_TOTAL = <%= Number(financials ? financials.totalAmount : 0) %>;
        const WALLET_BALANCE = <%= Number(typeof walletBalance !== 'undefined' ? walletBalance : 0) %>;

        function selectPaymentMethod(method) {
            const codItem = document.getElementById('paymentMethodCOD');
            const rzpItem = document.getElementById('paymentMethodRazorpay');
            const walletItem = document.getElementById('paymentMethodWallet');
            const radioInnerCOD = document.getElementById('radioInnerCOD');
            const radioInnerRzp = document.getElementById('radioInnerRazorpay');
            const radioInnerWallet = document.getElementById('radioInnerWallet');
            const badgeCOD = document.getElementById('badgeCOD');
            const badgeRzp = document.getElementById('badgeRazorpay');
            const badgeWallet = document.getElementById('badgeWallet');
            const btn = document.getElementById('btnPlaceOrder');

            if (method === 'Wallet') {
                if (WALLET_BALANCE < CURRENT_TOTAL) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Insufficient Balance',
                        text: `Your current wallet balance is ₹${WALLET_BALANCE.toLocaleString('en-IN')}, but your acquisition total is ₹${CURRENT_TOTAL.toLocaleString('en-IN')}. Please select Online Payment or COD.`,
                        background: '#141312',
                        color: '#eae6df',
                        confirmButtonColor: '#F6BD64'
                    });
                    return;
                }
            }

            document.getElementById('selectedPaymentMethod').value = method;

            // Reset selection highlights
            if (codItem) codItem.classList.remove('selected');
            if (rzpItem) rzpItem.classList.remove('selected');
            if (walletItem) walletItem.classList.remove('selected');
            if (radioInnerCOD) radioInnerCOD.style.background = 'transparent';
            if (radioInnerRzp) radioInnerRzp.style.background = 'transparent';
            if (radioInnerWallet) radioInnerWallet.style.background = 'transparent';

            if (method === 'COD') {
                if (codItem) codItem.classList.add('selected');
                if (radioInnerCOD) radioInnerCOD.style.background = 'var(--co-gold)';
                if (badgeCOD) {
                    badgeCOD.textContent = 'SELECTED';
                    badgeCOD.style.display = 'inline-block';
                }
                if (badgeRzp) {
                    badgeRzp.textContent = 'CARDS / UPI / NETBANKING';
                    badgeRzp.style.color = '#60a5fa';
                    badgeRzp.style.borderColor = 'rgba(96, 165, 250, 0.4)';
                    badgeRzp.style.background = 'rgba(96, 165, 250, 0.08)';
                }
                if (badgeWallet) {
                    badgeWallet.textContent = `BALANCE: ₹${WALLET_BALANCE.toLocaleString('en-IN')}`;
                    badgeWallet.style.color = '#10b981';
                    badgeWallet.style.borderColor = 'rgba(16, 185, 129, 0.4)';
                    badgeWallet.style.background = 'rgba(16, 185, 129, 0.08)';
                }
                if (btn) {
                    btn.innerHTML = `
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <span>Place Order (COD)</span>
                    `;
                }
            } else if (method === 'Razorpay') {
                if (rzpItem) rzpItem.classList.add('selected');
                if (radioInnerRzp) radioInnerRzp.style.background = 'var(--co-gold)';
                if (badgeRzp) {
                    badgeRzp.textContent = 'SELECTED';
                    badgeRzp.style.color = 'var(--co-gold)';
                    badgeRzp.style.borderColor = 'var(--co-gold)';
                    badgeRzp.style.background = 'rgba(246, 189, 100, 0.12)';
                }
                if (badgeCOD) {
                    badgeCOD.textContent = '';
                    badgeCOD.style.display = 'none';
                }
                if (badgeWallet) {
                    badgeWallet.textContent = `BALANCE: ₹${WALLET_BALANCE.toLocaleString('en-IN')}`;
                    badgeWallet.style.color = '#10b981';
                    badgeWallet.style.borderColor = 'rgba(16, 185, 129, 0.4)';
                    badgeWallet.style.background = 'rgba(16, 185, 129, 0.08)';
                }
                if (btn) {
                    btn.innerHTML = `
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                            <line x1="1" y1="10" x2="23" y2="10"></line>
                        </svg>
                        <span>Proceed to Online Payment (₹${CURRENT_TOTAL.toLocaleString('en-IN')})</span>
                    `;
                }
            } else if (method === 'Wallet') {
                if (walletItem) walletItem.classList.add('selected');
                if (radioInnerWallet) radioInnerWallet.style.background = 'var(--co-gold)';
                if (badgeWallet) {
                    badgeWallet.textContent = 'SELECTED';
                    badgeWallet.style.color = 'var(--co-gold)';
                    badgeWallet.style.borderColor = 'var(--co-gold)';
                    badgeWallet.style.background = 'rgba(246, 189, 100, 0.12)';
                }
                if (badgeCOD) {
                    badgeCOD.textContent = '';
                    badgeCOD.style.display = 'none';
                }
                if (badgeRzp) {
                    badgeRzp.textContent = 'CARDS / UPI / NETBANKING';
                    badgeRzp.style.color = '#60a5fa';
                    badgeRzp.style.borderColor = 'rgba(96, 165, 250, 0.4)';
                    badgeRzp.style.background = 'rgba(96, 165, 250, 0.08)';
                }
                if (btn) {
                    btn.innerHTML = `
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                            <path d="M7 15h0M2 10h20"></path>
                        </svg>
                        <span>Pay via Atelier Wallet (₹${CURRENT_TOTAL.toLocaleString('en-IN')})</span>
                    `;
                }
            }
        }

        async function handleApplyCoupon() {
            const input = document.getElementById('couponCodeInput');
            const code = input ? input.value.trim() : '';
            if (!code) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Coupon Code Required',
                    text: 'Please type a valid privilege coupon code.',
                    background: '#141312',
                    color: '#eae6df',
                    confirmButtonColor: '#F6BD64'
                });
                return;
            }

            const btn = document.getElementById('btnApplyCoupon');
            if (btn) btn.disabled = true;

            try {
                const response = await fetch('/checkout/coupon/apply', {
                    method: 'POST',
                    headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code })
                });
                const data = await response.json();
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Privilege Applied',
                        text: data.message,
                        background: '#141312',
                        color: '#eae6df',
                        confirmButtonColor: '#F6BD64',
                        timer: 1400,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    if (btn) btn.disabled = false;
                    Swal.fire({
                        icon: 'error',
                        title: 'Coupon Error',
                        text: data.message || 'Unable to apply coupon code.',
                        background: '#141312',
                        color: '#eae6df',
                        confirmButtonColor: '#F6BD64'
                    });
                }
            } catch (err) {
                console.error('Apply coupon error:', err);
                if (btn) btn.disabled = false;
                Swal.fire({
                    icon: 'error',
                    title: 'Network Notice',
                    text: 'Unable to contact coupon concierge. Please try again.',
                    background: '#141312',
                    color: '#eae6df',
                    confirmButtonColor: '#F6BD64'
                });
            }
        }

        async function handleRemoveCoupon() {
            try {
                const response = await fetch('/checkout/coupon/remove', {
                    method: 'POST',
                    headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Notice',
                        text: data.message || 'Unable to remove coupon.',
                        background: '#141312',
                        color: '#eae6df',
                        confirmButtonColor: '#F6BD64'
                    });
                }
            } catch (err) {
                console.error('Remove coupon error:', err);
            }
        }

        function applyPresetCoupon(code) {
            const input = document.getElementById('couponCodeInput');
            if (input) {
                input.value = code;
                handleApplyCoupon();
            }
        }

        // Handle Place Order Submission (COD or Razorpay)
        async function handlePlaceOrder(event) {
            event.preventDefault();

            const selectedAddressId = document.getElementById('selectedAddressId').value;
            if (!selectedAddressId) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Address Required',
                    text: 'Please choose or add a delivery address before placing your order.',
                    background: '#141312',
                    color: '#eae6df',
                    confirmButtonColor: '#F6BD64'
                });
                return;
            }

            const paymentMethod = document.getElementById('selectedPaymentMethod').value || 'COD';
            const btn = document.getElementById('btnPlaceOrder');
            const originalHTML = btn.innerHTML;
            btn.disabled = true;

            if (paymentMethod === 'COD' || paymentMethod === 'Wallet') {
                btn.innerHTML = `
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;">
                        <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                        <path d="M12 2a10 10 0 0 1 10 10" stroke-opacity="1"></path>
                    </svg>
                    <span>${paymentMethod === 'Wallet' ? 'Processing Atelier Wallet Settlement...' : 'Securing Acquisition...'}</span>
                `;

                try {
                    const response = await fetch('/checkout/place-order', {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            addressId: selectedAddressId,
                            paymentMethod: paymentMethod
                        })
                    });

                    const data = await response.json();

                    if (data.success && data.redirect) {
                        window.location.href = data.redirect;
                    } else {
                        btn.disabled = false;
                        btn.innerHTML = originalHTML;
                        Swal.fire({
                            icon: 'error',
                            title: 'Acquisition Error',
                            text: data.message || 'Unable to complete order.',
                            background: '#141312',
                            color: '#eae6df',
                            confirmButtonColor: '#F6BD64'
                        });
                    }
                } catch (err) {
                    console.error("Place order error:", err);
                    btn.disabled = false;
                    btn.innerHTML = originalHTML;
                    Swal.fire({
                        icon: 'error',
                        title: 'Notice',
                        text: 'Unable to connect to the atelier server. Please try again.',
                        background: '#141312',
                        color: '#eae6df',
                        confirmButtonColor: '#F6BD64'
                    });
                }
            } else if (paymentMethod === 'Razorpay') {
                btn.innerHTML = `
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;">
                        <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                        <path d="M12 2a10 10 0 0 1 10 10" stroke-opacity="1"></path>
                    </svg>
                    <span>Connecting Payment Concierge...</span>
                `;

                try {
                    const initRes = await fetch('/checkout/create-razorpay-order', {
                        method: 'POST',
                        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
                        body: JSON.stringify({ addressId: selectedAddressId })
                    });
                    const initData = await initRes.json();

                    if (!initData.success) {
                        btn.disabled = false;
                        btn.innerHTML = originalHTML;
                        Swal.fire({
                            icon: 'error',
                            title: 'Payment Gateway Notice',
                            text: initData.message || 'Unable to initialize online payment.',
                            background: '#141312',
                            color: '#eae6df',
                            confirmButtonColor: '#F6BD64'
                        });
                        return;
                    }

                    const options = {
                        key: initData.key,
                        amount: initData.amount,
                        currency: initData.currency,
                        name: 'ROYAL IGNITE',
                        description: 'Prestige Acquisition — Luxury Ignition Editions',
                        image: '/images/favicon.png',
                        order_id: initData.razorpayOrderId,
                        handler: async function (paymentResponse) {
                            btn.innerHTML = `
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;">
                                    <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                                    <path d="M12 2a10 10 0 0 1 10 10" stroke-opacity="1"></path>
                                </svg>
                                <span>Authenticating Settlement...</span>
                            `;
                            try {
                                const verifyRes = await fetch('/checkout/verify-payment', {
                                    method: 'POST',
                                    headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        addressId: selectedAddressId,
                                        razorpayOrderId: paymentResponse.razorpay_order_id,
                                        razorpayPaymentId: paymentResponse.razorpay_payment_id,
                                        razorpaySignature: paymentResponse.razorpay_signature
                                    })
                                });
                                const verifyData = await verifyRes.json();
                                if (verifyData.success && verifyData.redirect) {
                                    window.location.href = verifyData.redirect;
                                } else {
                                    window.location.href = verifyData.redirect || `/checkout/failure/${initData.razorpayOrderId}`;
                                }
                            } catch (err) {
                                console.error('Verify payment error:', err);
                                window.location.href = `/checkout/failure/${initData.razorpayOrderId}`;
                            }
                        },
                        prefill: {
                            name: initData.user?.name || USER_FULL_NAME,
                            email: initData.user?.email || USER_EMAIL,
                            contact: initData.user?.phone || USER_PHONE
                        },
                        theme: {
                            color: '#F6BD64'
                        },
                        modal: {
                            ondismiss: async function () {
                                btn.disabled = false;
                                btn.innerHTML = originalHTML;
                                try {
                                    const failRes = await fetch('/checkout/payment-failed', {
                                        method: 'POST',
                                        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
                                        body: JSON.stringify({
                                            addressId: selectedAddressId,
                                            razorpayOrderId: initData.razorpayOrderId,
                                            errorMessage: 'Transaction dismissed by client before authentication.'
                                        })
                                    });
                                    const failData = await failRes.json();
                                    if (failData.redirect) {
                                        window.location.href = failData.redirect;
                                    }
                                } catch (err) {
                                    console.error('Payment dismissed error:', err);
                                }
                            }
                        }
                    };

                    const rzp = new window.Razorpay(options);
                    rzp.on('payment.failed', async function (response) {
                        try {
                            const failRes = await fetch('/checkout/payment-failed', {
                                method: 'POST',
                                headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    addressId: selectedAddressId,
                                    razorpayOrderId: initData.razorpayOrderId,
                                    errorMessage: response.error?.description || response.error?.reason || 'Transaction declined by issuer bank.'
                                })
                            });
                            const failData = await failRes.json();
                            if (failData.redirect) {
                                window.location.href = failData.redirect;
                            }
                        } catch (err) {
                            console.error('Payment failure logging error:', err);
                        }
                    });
                    rzp.open();
                } catch (err) {
                    console.error("Initiate Razorpay error:", err);
                    btn.disabled = false;
                    btn.innerHTML = originalHTML;
                    Swal.fire({
                        icon: 'error',
                        title: 'Notice',
                        text: 'Unable to connect to the payment gateway. Please try again.',
                        background: '#141312',
                        color: '#eae6df',
                        confirmButtonColor: '#F6BD64'
                    });
                }
            }
        }
    </script>
    <style>
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>

</body>
</html>
