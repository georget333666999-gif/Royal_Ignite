<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Atelier Checkout — ROYAL IGNITE' %></title>
    <meta name="description" content="Secure your reserved Royal Ignite luxury lighters and connoisseur editions with complimentary insured delivery." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=Montserrat:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/user/index.css?v=3" />
    <link rel="stylesheet" href="/css/user/checkout.css?v=3" />
    <link rel="stylesheet" href="/css/user/animations.css" />
    <script defer src="/js/luxuryAnimations.js"></script>

    <!-- SweetAlert2 library -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        .royal-luxury-swal {
            background: #141312 !important;
            border: 1px solid rgba(229, 169, 60, 0.35) !important;
            border-radius: 16px !important;
            padding: 26px 22px !important;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.8) !important;
            color: #f0ece6 !important;
            font-family: 'Manrope', sans-serif !important;
        }
        .royal-swal-title {
            font-family: 'Cinzel', Georgia, serif !important;
            color: #ffffff !important;
            font-size: 22px !important;
            letter-spacing: 0.3px !important;
            margin-bottom: 8px !important;
        }
        .royal-swal-confirm-btn {
            border-radius: 6px !important;
            font-weight: 600 !important;
            font-size: 13px !important;
            letter-spacing: 0.5px !important;
            padding: 10px 22px !important;
            background: #F6BD64 !important;
            color: #0E0E12 !important;
            border: none !important;
            cursor: pointer !important;
        }
        .royal-swal-toast {
            border: 1px solid rgba(246, 189, 100, 0.25) !important;
            border-radius: 10px !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8) !important;
        }
    </style>
</head>

<body class="checkout-body">

    <!-- Header Navigation -->
    <%- include('./partials/header.ejs') %>

    <!-- Main Content -->
    <main class="checkout-main">
        <div class="checkout-container">

            <!-- Breadcrumbs & Title -->
            <div class="checkout-header">
                <div class="checkout-breadcrumbs">
                    <% if (typeof isBuyNow !== 'undefined' && isBuyNow) { %>
                        <a href="/shop">Atelier Collection</a>
                        <span>/</span>
                        <span>Instant Acquisition</span>
                    <% } else { %>
                        <a href="/cart">Atelier Bag</a>
                        <span>/</span>
                        <span>Secure Acquisition</span>
                    <% } %>
                </div>
                <h1 class="checkout-title">
                    <% if (typeof isBuyNow !== 'undefined' && isBuyNow) { %>
                        Instant <span class="italic-gold">Acquisition</span>
                    <% } else { %>
                        Secure <span class="italic-gold">Acquisition</span>
                    <% } %>
                </h1>
                <p class="checkout-subtitle">
                    Select your delivery destination and confirm your acquisition with complimentary insured air courier.
                </p>
            </div>

            <form id="checkoutForm" onsubmit="handlePlaceOrder(event)">
                <!-- Hidden inputs for active selections -->
                <input type="hidden" name="addressId" id="selectedAddressId" value="<%= selectedAddress ? selectedAddress._id : '' %>" />
                <input type="hidden" name="paymentMethod" value="COD" />

                <div class="checkout-grid">

                    <!-- LEFT COLUMN: Addresses and Payment -->
                    <div class="checkout-sections">

                        <!-- Delivery address section -->
                        <section class="checkout-section-card">
                            <div class="section-header-row">
                                <div class="section-title-wrap">
                                    <span class="section-step-num">1</span>
                                    <h2 class="section-title">Delivery Destination</h2>
                                </div>
                                <button type="button" class="btn-add-address-trigger" onclick="openAddAddressModal()">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                    <span>Add Address</span>
                                </button>
                            </div>

                            <div id="addressListContainer">
                                <% if (Array.isArray(addresses) && addresses.length > 0) { %>
                                    <div class="addresses-grid" id="addressesGrid">
                                        <% addresses.forEach(function(addr) { 
                                            const isCurrentSelected = selectedAddress && String(selectedAddress._id) === String(addr._id);
                                        %>
                                            <div class="address-select-card <%= isCurrentSelected ? 'selected' : '' %>"
                                                 id="addr-card-<%= addr._id %>"
                                                 onclick="selectAddress('<%= addr._id %>', this)"
                                                 data-address-id="<%= addr._id %>">
                                                
                                                <div class="address-card-top">
                                                    <div class="address-radio-wrap">
                                                        <div class="custom-radio">
                                                            <div class="custom-radio-inner"></div>
                                                        </div>
                                                        <span class="address-name"><%= addr.fullName %></span>
                                                    </div>

                                                    <div class="address-badges-wrap">
                                                        <span class="badge-addr-type"><%= addr.addressType || 'Home' %></span>
                                                        <% if (addr.isDefault) { %>
                                                            <span class="badge-addr-default">DEFAULT</span>
                                                        <% } %>
                                                    </div>
                                                </div>

                                                <p class="address-details-text">
                                                    <%= addr.addressLine %><br>
                                                    <%= addr.city %>, <%= addr.state %> — <%= addr.pincode %><br>
                                                    <%= addr.country || 'India' %>
                                                </p>

                                                <div class="address-phone-line">
                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                                    </svg>
                                                    <span><%= addr.phone %></span>
                                                </div>

                                                <div class="address-card-actions">
                                                    <button type="button" 
                                                            class="btn-edit-addr" 
                                                            data-addr-id="<%= addr._id %>"
                                                            data-addr="<%= JSON.stringify(addr) %>"
                                                            onclick="event.stopPropagation(); openEditAddressModal(this.dataset.addrId, JSON.parse(this.dataset.addr))">
                                                        Edit Address
                                                    </button>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <div class="no-address-box" id="noAddressBox">
                                        <p>You have not registered any delivery destinations in your atelier profile yet.</p>
                                        <button type="button" class="btn-add-address-trigger" onclick="openAddAddressModal()">
                                            <span>+ Register Delivery Address</span>
                                        </button>
                                    </div>
                                <% } %>
                            </div>
                        </section>

                        <!-- Payment method section -->
                        <section class="checkout-section-card">
                            <div class="section-header-row">
                                <div class="section-title-wrap">
                                    <span class="section-step-num">2</span>
                                    <h2 class="section-title">Payment Concierge</h2>
                                </div>
                            </div>

                            <input type="hidden" name="paymentMethod" id="selectedPaymentMethod" value="COD" />

                            <div class="payment-methods-list" style="display: flex; flex-direction: column; gap: 14px;">
                                <!-- COD Card -->
                                <div class="payment-method-item selected" id="paymentMethodCOD" data-method="COD" onclick="selectPaymentMethod('COD')">
                                    <div class="custom-radio" style="border-color: var(--co-gold); margin-top: 2px;">
                                        <div class="custom-radio-inner" id="radioInnerCOD" style="background: var(--co-gold);"></div>
                                    </div>
                                    <div class="payment-method-info">
                                        <div class="payment-method-title-row">
                                            <span class="payment-method-name">Cash on Delivery (COD)</span>
                                            <span class="payment-method-badge" id="badgeCOD">SELECTED</span>
                                        </div>
                                        <p class="payment-method-desc">
                                            Pay via cash, UPI, or card on physical delivery. Our white-glove air courier provides complete tamper-evident serial inspection before handoff.
                                        </p>
                                    </div>
                                </div>

                                <!-- Razorpay Card -->
                                <div class="payment-method-item" id="paymentMethodRazorpay" data-method="Razorpay" onclick="selectPaymentMethod('Razorpay')">
                                    <div class="custom-radio" style="border-color: var(--co-gold); margin-top: 2px;">
                                        <div class="custom-radio-inner" id="radioInnerRazorpay" style="background: transparent;"></div>
                                    </div>
                                    <div class="payment-method-info">
                                        <div class="payment-method-title-row">
                                            <span class="payment-method-name">Online Payment (Razorpay)</span>
                                            <span class="payment-method-badge" id="badgeRazorpay" style="color: #60a5fa; border-color: rgba(96, 165, 250, 0.4); background: rgba(96, 165, 250, 0.08);">CARDS / UPI / NETBANKING</span>
                                        </div>
                                        <p class="payment-method-desc">
                                            Instant priority acquisition via UPI (Google Pay, PhonePe, Paytm), Credit/Debit Cards, Net Banking, or Wallets with 256-bit encryption.
                                        </p>
                                    </div>
                                </div>

                                <!-- Royal Ignite Wallet Card -->
                                <% const isWalletSufficient = (typeof walletBalance !== 'undefined' ? walletBalance : 0) >= (financials ? financials.totalAmount : 0); %>
                                <div class="payment-method-item <%= isWalletSufficient ? '' : 'disabled-method' %>" 
                                     id="paymentMethodWallet" 
                                     data-method="Wallet" 
                                     onclick="selectPaymentMethod('Wallet')"
                                     style="<%= isWalletSufficient ? '' : 'opacity: 0.6;' %>">
                                    <div class="custom-radio" style="border-color: var(--co-gold); margin-top: 2px;">
                                        <div class="custom-radio-inner" id="radioInnerWallet" style="background: transparent;"></div>
                                    </div>
                                    <div class="payment-method-info">
                                        <div class="payment-method-title-row">
                                            <span class="payment-method-name">Royal Ignite Wallet</span>
                                            <% if (isWalletSufficient) { %>
                                                <span class="payment-method-badge" id="badgeWallet" style="color: #10b981; border-color: rgba(16, 185, 129, 0.4); background: rgba(16, 185, 129, 0.08);">
                                                    BALANCE: ₹<%= Number(walletBalance || 0).toLocaleString('en-IN') %>
                                                </span>
                                            <% } else { %>
                                                <span class="payment-method-badge" id="badgeWallet" style="color: #ef4444; border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.08);">
                                                    INSUFFICIENT (₹<%= Number(walletBalance || 0).toLocaleString('en-IN') %>)
                                                </span>
                                            <% } %>
                                        </div>
                                        <p class="payment-method-desc">
                                            <% if (isWalletSufficient) { %>
                                                Settle immediately using your verified store wallet balance with instant zero-latency confirmation.
                                            <% } else { %>
                                                Available wallet balance is lower than total payable amount (Current balance: ₹<%= Number(walletBalance || 0).toLocaleString('en-IN') %>).
                                            <% } %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>

                    </div>

                    <!-- Right column: order summary and totals -->
                    <aside class="checkout-summary-wrap">
                        <div class="checkout-summary-card">
                            <h3 class="summary-title"><%= (typeof isBuyNow !== 'undefined' && isBuyNow) ? 'Instant Acquisition Summary' : 'Acquisition Summary' %></h3>

                            <!-- Reserved Pieces List -->
                            <div class="summary-items-list">
                                <% if (Array.isArray(items) && items.length > 0) { %>
                                    <% items.forEach(function(item) { %>
                                        <div class="summary-item-row">
                                            <div class="summary-item-thumb">
                                                <img src="<%= (item.images && item.images[0]) || '/uploads/hero_lighter.png' %>" 
                                                     alt="<%= item.name %>" 
                                                     loading="lazy"
                                                     onerror="this.src='/uploads/hero_lighter.png';" />
                                            </div>
                                            <div class="summary-item-details">
                                                <div class="summary-item-name" title="<%= item.name %>"><%= item.name %></div>
                                                <div class="summary-item-qty">Qty: <%= item.quantity %> × ₹<%= Number(item.price || 0).toLocaleString('en-IN') %></div>
                                                <% if (item.appliedOffer && item.appliedOffer.name) { %>
                                                    <div class="checkout-offer-applied-tag">
                                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                                        <span>Privilege: <%= item.appliedOffer.name %></span>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <div class="summary-item-price">
                                                ₹<%= Number(item.lineTotal || 0).toLocaleString('en-IN') %>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } %>
                            </div>

                            <!-- Coupon Redemption Card -->
                            <div class="coupon-box-card">
                                <div class="coupon-header-title">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                                        <line x1="7" y1="7" x2="7.01" y2="7"></line>
                                    </svg>
                                    <span>Privilege Atelier Coupon</span>
                                </div>

                                <% if (appliedCoupon && appliedCoupon.code) { %>
                                    <div class="applied-coupon-pill" id="appliedCouponPill">
                                        <div class="applied-coupon-info">
                                            <span class="applied-coupon-code"><%= appliedCoupon.code %></span>
                                            <span class="applied-coupon-desc">
                                                Saved ₹<%= Number(appliedCoupon.discountAmount || (financials && financials.couponDiscount) || 0).toLocaleString('en-IN') %>
                                            </span>
                                        </div>
                                        <button type="button" class="btn-remove-coupon" onclick="handleRemoveCoupon()" title="Remove coupon">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </button>
                                    </div>
                                <% } else { %>
                                    <div class="coupon-input-group" id="couponInputGroup">
                                        <input type="text" 
                                               id="couponCodeInput" 
                                               class="coupon-input" 
                                               placeholder="Enter code (e.g. ROYAL10)" 
                                               maxlength="20" 
                                               autocomplete="off" />
                                        <button type="button" class="btn-apply-coupon" id="btnApplyCoupon" onclick="handleApplyCoupon()">
                                            Apply
                                        </button>
                                    </div>

                                    <% if (Array.isArray(availableCoupons) && availableCoupons.length > 0) { %>
                                        <div class="available-coupons-wrap" style="margin-top: 10px;">
                                            <span style="font-size: 11px; color: var(--co-text-muted); display: block; margin-bottom: 6px;">Available Privilege Codes:</span>
                                            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                                <% availableCoupons.forEach(function(cpn) { %>
                                                    <button type="button" 
                                                            class="coupon-chip" 
                                                            onclick="applyPresetCoupon('<%= cpn.code %>')"
                                                            title="<%= cpn.description || '' %> (Min: ₹<%= Number(cpn.minPurchase).toLocaleString('en-IN') %>)">
                                                        <span><%= cpn.code %></span>
                                                        <span style="opacity: 0.75; font-size: 10px;">
                                                            (<%= cpn.discountType === 'percentage' ? cpn.discountValue + '% OFF' : '₹' + cpn.discountValue + ' OFF' %>)
                                                        </span>
                                                    </button>
                                                <% }); %>
                                            </div>
                                        </div>
                                    <% } %>
                                <% } %>
                            </div>

                            <!-- Financial Ledger Breakdown -->
                            <div class="summary-ledger">
                                <% if (typeof isBuyNow !== 'undefined' && isBuyNow) { %>
                                    <div class="ledger-line">
                                        <span>Direct Acquisition (<%= (typeof cart !== 'undefined' && cart) ? cart.itemCount : 1 %> <%= (typeof cart !== 'undefined' && cart && cart.itemCount === 1) ? 'piece' : 'pieces' %>)</span>
                                        <span>₹<%= Number(financials ? financials.subtotal : 0).toLocaleString('en-IN') %></span>
                                    </div>
                                <% } else if (financials && financials.savings > 0) { %>
                                    <div class="ledger-line">
                                        <span>Catalog Value (<%= (typeof cart !== 'undefined' && cart) ? cart.itemCount : 0 %> pieces)</span>
                                        <span>₹<%= Number(financials.catalogTotal || financials.regularTotal || 0).toLocaleString('en-IN') %></span>
                                    </div>

                                    <div class="ledger-line savings">
                                        <span>Atelier Courtesy Discount</span>
                                        <span>− ₹<%= Number(financials.savings || 0).toLocaleString('en-IN') %></span>
                                    </div>

                                    <div class="ledger-line">
                                        <span>Net Subtotal</span>
                                        <span>₹<%= Number(financials.subtotal || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                <% } else { %>
                                    <div class="ledger-line">
                                        <span>Bag Subtotal (<%= cart ? cart.itemCount : 0 %> pieces)</span>
                                        <span>₹<%= Number(financials ? financials.subtotal || 0 : 0).toLocaleString('en-IN') %></span>
                                    </div>
                                <% } %>

                                <% if (financials && financials.couponDiscount > 0) { %>
                                    <div class="ledger-line coupon-discount" style="color: #10b981;">
                                        <span>Privilege Discount (<%= financials.couponCode || (appliedCoupon && appliedCoupon.code) %>)</span>
                                        <span id="ledgerCouponDiscount">− ₹<%= Number(financials.couponDiscount || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                <% } %>

                                <div class="ledger-line">
                                    <span>Insured Air Delivery</span>
                                    <span style="color: var(--co-gold);">COMPLIMENTARY</span>
                                </div>

                                <div class="ledger-line">
                                    <span>Taxes & Duties</span>
                                    <span>INCLUDED</span>
                                </div>

                                <div class="ledger-line total">
                                    <span>Total Payable</span>
                                    <span class="total-amount">₹<%= Number(financials ? financials.totalAmount || 0 : 0).toLocaleString('en-IN') %></span>
                                </div>
                            </div>

                            <!-- CTA Button -->
                            <button type="submit" class="btn-place-order" id="btnPlaceOrder">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                                <span>Place Order (COD)</span>
                            </button>

                            <!-- Trust Perks -->
                            <div class="summary-trust-perks">
                                <div class="trust-perk-item">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    </svg>
                                    <span>Numbered authenticity certificate enclosed</span>
                                </div>
                                <div class="trust-perk-item">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="1" y="3" width="15" height="13"></rect>
                                        <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                    </svg>
                                    <span>Dispatched in sealed tamper-proof freight</span>
                                </div>
                                <div class="trust-perk-item">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span>Pay upon physical delivery and inspection</span>
                                </div>
                            </div>

                        </div>
                    </aside>

                </div>
            </form>

        </div>
    </main>

    <!-- ADD ADDRESS MODAL -->
    <div class="checkout-modal-overlay" id="addAddressModal">
        <div class="checkout-modal-card">
            <div class="modal-header-row">
                <h3 class="modal-title">New Delivery Destination</h3>
                <button type="button" class="btn-close-modal" onclick="closeAddAddressModal()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <form id="addAddressForm" novalidate onsubmit="handleAddAddressSubmit(event)">
                <div class="modal-form-grid">
                    <div class="modal-form-group">
                        <label class="modal-label" for="addFullName">Recipient Full Name *</label>
                        <input type="text" name="fullName" id="addFullName" class="modal-input" placeholder="e.g. Lord Julian Vance" autocomplete="name" />
                        <div class="js-error-message" id="err-addFullName" style="display: none;"></div>
                    </div>

                    <div class="modal-form-group">
                        <label class="modal-label" for="addPhone">10-Digit Mobile *</label>
                        <input type="tel" name="phone" id="addPhone" maxlength="10" class="modal-input" placeholder="e.g. 9876543210" autocomplete="tel" />
                        <div class="js-error-message" id="err-addPhone" style="display: none;"></div>
                    </div>

                    <div class="modal-form-group full-width">
                        <label class="modal-label" for="addAddressLine">Street / Estate Address *</label>
                        <input type="text" name="addressLine" id="addAddressLine" class="modal-input" placeholder="Building, Street, Landmark details" autocomplete="street-address" />
                        <div class="js-error-message" id="err-addAddressLine" style="display: none;"></div>
                    </div>

                    <div class="modal-form-group">
                        <label class="modal-label" for="addCity">City *</label>
                        <input type="text" name="city" id="addCity" class="modal-input" placeholder="e.g. Mumbai" autocomplete="address-level2" />
                        <div class="js-error-message" id="err-addCity" style="display: none;"></div>
                    </div>

                    <div class="modal-form-group">
                        <label class="modal-label" for="addState">State *</label>
                        <input type="text" name="state" id="addState" class="modal-input" placeholder="e.g. Maharashtra" autocomplete="address-level1" />
                        <div class="js-error-message" id="err-addState" style="display: none;"></div>
                    </div>

                    <div class="modal-form-group">
                        <label class="modal-label" for="addPincode">PIN / Postal Code *</label>
                        <input type="text" name="pincode" id="addPincode" maxlength="6" class="modal-input" placeholder="e.g. 400001" autocomplete="postal-code" />
