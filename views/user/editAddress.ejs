<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Address - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
    <link rel="stylesheet" href="/css/user/profile.css" />
</head>

<body>

    <%- include('partials/header') %>

    <div class="modal-overlay">
        <div class="modal-card">
            
            <a href="/user/addresses" class="modal-close" title="Close">&times;</a>

            <h2 class="modal-title">Edit Address</h2>

            <% if (error) { %>
                <div class="error-badge"><%= error %></div>
            <% } %>

            <form action="/user/addresses/edit/<%= address._id %>" method="POST" id="editAddressForm" novalidate>
                
                <div class="modal-form-grid">
                    
                    <div class="form-group">
                        <label for="fullName">Full Name *</label>
                        <input
                            type="text"
                            id="fullName"
                            name="fullName"
                            class="form-input"
                            value="<%= address.fullName %>"
                            data-validate="name"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="phone">Phone Number *</label>
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            class="form-input"
                            value="<%= address.phone %>"
                            maxlength="10"
                            data-validate="phone"
                            required
                        />
                    </div>

                    <div class="form-group" style="grid-column: span 2;">
                        <label for="addressLine">Address / Street / House *</label>
                        <textarea
                            id="addressLine"
                            name="addressLine"
                            class="form-input"
                            style="height: 70px; resize: none;"
                            data-validate="addressLine"
                            required
                        ><%= address.addressLine %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="city">City / Town *</label>
                        <input
                            type="text"
                            id="city"
                            name="city"
                            class="form-input"
                            value="<%= address.city %>"
                            data-validate="city"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="state">State *</label>
                        <input
                            type="text"
                            id="state"
                            name="state"
                            class="form-input"
                            value="<%= address.state %>"
                            data-validate="state"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="pincode">Pincode *</label>
                        <input
                            type="text"
                            id="pincode"
                            name="pincode"
                            class="form-input"
                            value="<%= address.pincode %>"
                            maxlength="6"
                            data-validate="pincode"
                            required
                        />
                    </div>

                    <input type="hidden" name="country" value="<%= address.country || 'India' %>" />

                    <div class="form-group">
                        <label for="addressType">Address Type *</label>
                        <select id="addressType" name="addressType" class="form-input" data-validate="addressType" required>
                            <option value="Home" <%= address.addressType === 'Home' ? 'selected' : '' %>>Home</option>
                            <option value="Work" <%= address.addressType === 'Work' ? 'selected' : '' %>>Work</option>
                            <option value="Other" <%= address.addressType === 'Other' ? 'selected' : '' %>>Other</option>
                        </select>
                    </div>

                    <div class="form-group" style="grid-column: span 2; display: flex; align-items: center; gap: 8px;">
                        <input
                            type="checkbox"
                            id="isDefault"
                            name="isDefault"
                            style="width: 18px; height: 18px; accent-color: #050505;"
                            <%= address.isDefault ? 'checked' : '' %>
                        />
                        <label for="isDefault" style="margin-bottom: 0; cursor: pointer; text-transform: none; font-size: 14px;">Set as default shipping address</label>
                    </div>

                </div>

                <!-- Action Footer -->
                <div class="modal-actions">
                    <a href="/user/addresses" class="btn-cancel">CANCEL</a>
                    <button type="submit" class="btn-save">UPDATE ADDRESS</button>
                </div>

            </form>

        </div>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/validation.js"></script>

</body>

</html>
