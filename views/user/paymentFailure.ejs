<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Payment Pending / Failed — ROYAL IGNITE' %></title>
    <meta name="description" content="Online payment attempt failed or was cancelled." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/user/index.css" />
    <link rel="stylesheet" href="/css/user/orderSuccess.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        .failure-alert-box {
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 10px;
            padding: 14px 18px;
            margin: 20px 0 28px;
            text-align: left;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            color: #fca5a5;
            font-size: 13.5px;
            line-height: 1.5;
        }

        .failure-alert-icon {
            flex-shrink: 0;
            color: #ef4444;
            margin-top: 2px;
        }

        .btn-retry-payment {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: var(--os-gold);
            color: #0E0E12;
            font-size: 13.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 14px 28px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            box-shadow: 0 4px 18px var(--os-gold-glow);
            transition: all 0.25s ease;
        }

        .btn-retry-payment:hover {
            background: var(--os-gold-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 22px rgba(246, 189, 100, 0.4);
        }

        .btn-retry-payment:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
    </style>
</head>

<body class="order-success-body">

    <!-- Header Navigation -->
    <%- include('./partials/header.ejs') %>

    <!-- Main Content -->
    <main class="order-success-main">
        <div class="order-success-container">

            <div class="order-success-card">
                <div class="order-success-glow" style="background: radial-gradient(ellipse, rgba(239, 68, 68, 0.2) 0%, transparent 70%);"></div>

                <!-- Failure Emblem Illustration -->
                <div class="order-seal-emblem" style="background: radial-gradient(circle, rgba(239, 68, 68, 0.18) 0%, rgba(14, 14, 18, 0.9) 70%); border-color: rgba(239, 68, 68, 0.4); color: #ef4444; box-shadow: 0 0 25px rgba(239, 68, 68, 0.25);">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </div>

                <span class="order-kicker" style="color: #ef4444;">Transaction Incomplete</span>
                <h1 class="order-success-title">
                    Payment <span style="color: #ef4444;">Unsuccessful</span>
                </h1>
                <p class="order-success-desc">
                    Your online payment attempt could not be finalized. Your reserved pieces remain saved under acquisition reference <strong>#<%= order.orderId %></strong>, and no funds were captured from your account.
                </p>

                <!-- Failure Reason Alert -->
                <div class="failure-alert-box">
                    <svg class="failure-alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <div>
                        <strong>Notice:</strong> <%= failureReason %>
                    </div>
                </div>

                <!-- Order Reference Details Box -->
                <div class="order-reference-box">
                    <div class="reference-grid">
                        <div>
                            <span class="ref-item-label">Order Identifier</span>
                            <span class="ref-item-value gold">#<%= order.orderId %></span>
                        </div>

                        <div>
                            <span class="ref-item-label">Payment Channel</span>
                            <span class="ref-item-value">Razorpay (Pending)</span>
                        </div>

                        <div>
                            <span class="ref-item-label">Total Payable</span>
                            <span class="ref-item-value">₹<%= Number(order.pricing.totalAmount).toLocaleString('en-IN') %></span>
                        </div>

                        <div>
                            <span class="ref-item-label">Status</span>
                            <span class="ref-item-value" style="color: #fca5a5;">Awaiting Payment</span>
                        </div>

                        <div style="grid-column: span 2;">
                            <span class="ref-item-label">Delivery Destination</span>
                            <span class="ref-item-value" style="font-size: 13.5px; line-height: 1.5; color: var(--os-text-muted);">
                                <strong><%= order.shippingAddress.fullName %></strong> (<%= order.shippingAddress.phone %>)<br>
                                <%= order.shippingAddress.addressLine %>, <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> — <%= order.shippingAddress.pincode %>
                            </span>
                        </div>
                    </div>

                    <!-- Items Strip -->
                    <div class="order-items-strip">
                        <div class="items-strip-title">Reserved Editions (<%= order.items.length %> <%= order.items.length === 1 ? 'Piece' : 'Pieces' %>)</div>
                        <div class="items-strip-list">
                            <% order.items.forEach(function(item) { %>
                                <div class="strip-item-row">
                                    <div class="strip-item-name">
                                        <div class="strip-item-thumb">
                                            <img src="<%= item.image || '/uploads/hero_lighter.png' %>" alt="<%= item.name %>" loading="lazy" />
                                        </div>
                                        <span><%= item.name %> <span class="strip-item-qty">× <%= item.quantity %></span></span>
                                    </div>
                                    <span>₹<%= Number(item.lineTotal).toLocaleString('en-IN') %></span>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </div>

                <!-- CTA Action Buttons -->
                <div class="order-success-actions" style="margin-top: 32px;">
                    <!-- Primary Retry Button -->
                    <button type="button" class="btn-retry-payment" id="btnRetryPayment" onclick="handleRetryPayment('<%= order.orderId %>')">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="23 4 23 10 17 10"></polyline>
                            <polyline points="1 20 1 14 7 14"></polyline>
                            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                        </svg>
                        <span>Retry Payment (₹<%= Number(order.pricing.totalAmount).toLocaleString('en-IN') %>)</span>
                    </button>

                    <!-- View Order Details -->
                    <a href="/orders/<%= order.orderId %>" class="btn-order-details">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                        <span>View Order Dossier</span>
                    </a>

                    <!-- Return to Products -->
                    <a href="/products" class="btn-continue-shopping">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        <span>Return to Atelier</span>
                    </a>
                </div>

            </div>

        </div>
    </main>

    <!-- Footer Partial -->
    <%- include('./partials/footer.ejs') %>

    <script>
        async function handleRetryPayment(orderId) {
            const btn = document.getElementById('btnRetryPayment');
            const originalHTML = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;">
                    <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                    <path d="M12 2a10 10 0 0 1 10 10" stroke-opacity="1"></path>
                </svg>
                <span>Re-initiating Gateway...</span>
            `;

            try {
                const response = await fetch(`/checkout/retry-payment/${orderId}`, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                if (!data.success) {
                    btn.disabled = false;
                    btn.innerHTML = originalHTML;
                    Swal.fire({
                        icon: 'error',
                        title: 'Retry Failed',
                        text: data.message || 'Unable to re-initialize payment gateway.',
                        background: '#141312',
                        color: '#eae6df',
                        confirmButtonColor: '#F6BD64'
                    });
                    return;
                }

                const options = {
                    key: data.key,
                    amount: data.amount,
                    currency: data.currency,
                    name: 'ROYAL IGNITE',
                    description: `Acquisition Payment #${orderId}`,
                    image: '/images/favicon.png',
                    order_id: data.razorpayOrderId,
                    handler: async function (paymentRes) {
                        btn.innerHTML = `
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;">
                                <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                                <path d="M12 2a10 10 0 0 1 10 10" stroke-opacity="1"></path>
                            </svg>
                            <span>Confirming Settlement...</span>
                        `;
                        try {
                            const verifyRes = await fetch(`/checkout/verify-retry-payment/${orderId}`, {
                                method: 'POST',
                                headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    razorpayOrderId: paymentRes.razorpay_order_id,
                                    razorpayPaymentId: paymentRes.razorpay_payment_id,
                                    razorpaySignature: paymentRes.razorpay_signature
                                })
                            });
                            const verifyData = await verifyRes.json();
                            if (verifyData.success && verifyData.redirect) {
                                window.location.href = verifyData.redirect;
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Verification Failed',
                                    text: verifyData.message || 'Signature verification failed.',
                                    background: '#141312',
                                    color: '#eae6df',
                                    confirmButtonColor: '#F6BD64'
                                });
                                btn.disabled = false;
                                btn.innerHTML = originalHTML;
                            }
                        } catch (err) {
                            btn.disabled = false;
                            btn.innerHTML = originalHTML;
                            console.error('Verify retry payment error:', err);
                        }
                    },
                    prefill: {
                        name: data.user?.name || '',
                        email: data.user?.email || '',
                        contact: data.user?.phone || ''
                    },
                    theme: { color: '#F6BD64' },
                    modal: {
                        ondismiss: function () {
                            btn.disabled = false;
                            btn.innerHTML = originalHTML;
                        }
                    }
                };

                const rzp = new window.Razorpay(options);
                rzp.open();
            } catch (err) {
                console.error('Retry payment error:', err);
                btn.disabled = false;
                btn.innerHTML = originalHTML;
                Swal.fire({
                    icon: 'error',
                    title: 'Network Error',
                    text: 'Unable to reach payment concierge. Please try again.',
                    background: '#141312',
                    color: '#eae6df',
                    confirmButtonColor: '#F6BD64'
                });
            }
        }
    </script>
    <style>
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
</body>
</html>

