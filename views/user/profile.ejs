<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Account - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
    <link rel="stylesheet" href="/css/user/profile.css" />
</head>

<body class="profile-page">

    <%- include('partials/header') %>

    <main class="dashboard-wrapper">
        <div class="dashboard-container">
            
            <!-- Breadcrumbs -->
            <div class="breadcrumbs">
                <a href="/">Home</a>
                <span class="breadcrumb-separator">&rsaquo;</span>
                <a href="/user/profile">My Account</a>
                <span class="breadcrumb-separator">&rsaquo;</span>
                <span class="breadcrumb-current">Profile Information</span>
            </div>

            <!-- Dashboard Header -->
            <div class="dashboard-header">
                <div class="dashboard-tagline">
                    <span class="tagline-dot"></span>
                    Account Dashboard
                </div>
                <h1 class="dashboard-title">My Account</h1>
                <p class="dashboard-subtitle">
                    Manage your personal profile, addresses, orders, wallet, and security settings.
                </p>
            </div>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="profile-alert profile-alert-success">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                    <span><%= success %></span>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="profile-alert profile-alert-error">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <!-- Main Layout Grid -->
            <div class="dashboard-grid">
                
                <!-- Sidebar Navigation -->
                <aside class="sidebar-nav">
                    <div class="sidebar-menu">
                        <a href="/user/profile" class="nav-item active">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <span>Profile Information</span>
                        </a>

                        <a href="/user/addresses" class="nav-item">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>Saved Addresses</span>
                        </a>

                        <a href="/orders" class="nav-item">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <path d="M16 10a4 4 0 0 1-8 0"></path>
                            </svg>
                            <span>My Orders</span>
                        </a>

                        <a href="/wishlist" class="nav-item">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                            <span>Wishlist Vault</span>
                        </a>

                        <% if (!user.googleId) { %>
                            <a href="/user/profile/change-password" class="nav-item">
                                <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                                <span>Security Settings</span>
                            </a>
                        <% } %>

                        <a href="/wallet" class="nav-item">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                <line x1="1" y1="10" x2="23" y2="10"></line>
                            </svg>
                            <span>My Wallet</span>
                        </a>

                        <a href="#" class="nav-item">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            <span>My Referrals</span>
                        </a>
                    </div>

                    <div class="sidebar-footer">
                        <form action="/user/logout" method="POST">
                            <button type="submit" class="nav-item signout-btn">
                                <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                                <span>Sign Out</span>
                            </button>
                        </form>
                    </div>
                </aside>

                <!-- Content Area -->
                <section class="content-area">
                    
                    <!-- Hero Profile Overview Card -->
                    <div class="profile-hero-card">
                        <div class="avatar-col">
                            <div class="avatar-wrapper">
                                <img 
                                    src="<%= user.imgUrl || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name) + '&background=141312&color=d48833&size=180' %>" 
                                    alt="<%= user.name %>" 
                                    class="avatar-img"
                                />
                                <a href="/user/profile/edit" class="avatar-badge" title="Change Avatar">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                        <circle cx="12" cy="13" r="4"></circle>
                                    </svg>
                                </a>
                            </div>
                        </div>

                        <div class="user-intro-col">
                            <div class="user-tier-badge">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path>
                                </svg>
                                <span>ROYAL IGNITE COLLECTOR</span>
                            </div>
                            <h2 class="user-name"><%= user.name %></h2>
                            <p class="user-meta"><%= user.email %> &bull; Member since <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : '2024' %></p>
                        </div>

                        <div class="action-col">
                            <a href="/user/profile/edit" class="edit-btn">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 20h9"></path>
                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                </svg>
                                <span>Edit Profile</span>
                            </a>
                        </div>
                    </div>

                    <!-- Detail Cards Section -->
                    <div class="section-heading-row">
                        <h3 class="section-title">Personal Details</h3>
                        <span class="section-note">Your verified account information</span>
                    </div>

                    <div class="details-grid">
                        
                        <!-- Full Name Card -->
                        <div class="detail-card">
                            <div class="detail-card-header">
                                <span class="detail-label">FULL NAME</span>
                                <span class="detail-status verified">Verified</span>
                            </div>
                            <div class="detail-value"><%= user.name %></div>
                        </div>

                        <!-- Email Address Card -->
                        <div class="detail-card">
                            <div class="detail-card-header">
                                <span class="detail-label">EMAIL ADDRESS</span>
                                <% if (user.googleId) { %>
                                    <span class="detail-status verified" title="Email managed by Google Sign-In" style="display: inline-flex; align-items: center; gap: 5px; padding: 2px 8px; font-size: 11px;">
                                        <svg width="11" height="11" viewBox="0 0 24 24">
                                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                                        </svg>
                                        Google
                                    </span>
                                <% } else { %>
                                    <a href="/user/profile/change-email" class="detail-action-link" title="Change Email via OTP">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                        <span>Change</span>
                                    </a>
                                <% } %>
                            </div>
                            <div class="detail-value"><%= user.email %></div>
                        </div>

                        <!-- Phone Number Card -->
                        <div class="detail-card">
                            <div class="detail-card-header">
                                <span class="detail-label">PHONE NUMBER</span>
                                <span class="detail-status <%= user.phone ? 'verified' : 'pending' %>">
                                    <%= user.phone ? 'Primary' : 'Not Added' %>
                                </span>
                            </div>
                            <div class="detail-value"><%= user.phone || '—' %></div>
                        </div>

                        <!-- Member Since Card -->
                        <div class="detail-card">
                            <div class="detail-card-header">
                                <span class="detail-label">MEMBER SINCE</span>
                                <span class="detail-status verified">Active</span>
                            </div>
                            <div class="detail-value">
                                <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A' %>
                            </div>
                        </div>

                        <!-- Referral Card -->
                        <div class="detail-card" style="grid-column: 1 / -1; background: linear-gradient(135deg, rgba(212, 136, 51, 0.08) 0%, rgba(14, 14, 18, 0.95) 100%); border: 1px solid rgba(212, 136, 51, 0.25);">
                            <div class="detail-card-header">
                                <span class="detail-label" style="color: #D48833; display: flex; align-items: center; gap: 6px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                    ATELIER REFERRAL PRIVILEGE
                                </span>
                                <span class="detail-status verified" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border-color: rgba(16, 185, 129, 0.3);">
                                    Earned: ₹<%= Number(user.referralRewardsEarned || 0).toLocaleString('en-IN') %>
                                </span>
                            </div>
                            <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-top: 10px;">
                                <div>
                                    <div style="font-size: 11.5px; color: #a1a1aa; margin-bottom: 4px;">Your Unique Invitation Code</div>
                                    <div style="font-family: monospace; font-size: 18px; font-weight: 700; color: #F6BD64; letter-spacing: 1.5px;">
                                        <%= user.referralCode || 'RYL-ATELIER' %>
                                    </div>
                                </div>
                                <div style="display: flex; gap: 10px;">
                                    <button type="button" 
                                            class="btn-wallet-action"
                                            style="padding: 8px 16px; font-size: 12px; background: #27272a; color: #f0ece6; border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; cursor: pointer;"
                                            onclick="copyReferralCode('<%= user.referralCode %>')">
                                        Copy Code
                                    </button>
                                    <button type="button" 
                                            class="btn-wallet-action"
                                            style="padding: 8px 16px; font-size: 12px; background: #D48833; color: #ffffff; border: none; border-radius: 6px; font-weight: 600; cursor: pointer;"
                                            onclick="copyReferralLink('<%= user.referralCode %>')">
                                        Copy Token Link
                                    </button>
                                </div>
                            </div>
                            <div style="font-size: 12px; color: #71717a; margin-top: 12px; line-height: 1.5;">
                                Invite distinguished connoisseurs to Royal Ignite. When they verify their account, both you and your guest will receive privilege wallet credits immediately.
                            </div>
                        </div>

                    </div>

                    <!-- Quick Navigation Cards -->
                    <div class="account-perks-grid">
                        <a href="/wishlist" class="perk-card">
                            <div class="perk-icon-box">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                            </div>
                            <div class="perk-info">
                                <span class="perk-title">Wishlist Vault</span>
                                <span class="perk-desc">Review your curated heirlooms and reserved pieces</span>
                            </div>
                            <span class="perk-arrow">&rarr;</span>
                        </a>

                        <a href="/user/addresses" class="perk-card">
                            <div class="perk-icon-box">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                            </div>
                            <div class="perk-info">
                                <span class="perk-title">Shipping Addresses</span>
                                <span class="perk-desc">Manage your saved destinations and default address</span>
                            </div>
                            <span class="perk-arrow">&rarr;</span>
                        </a>

                        <% if (user.googleId) { %>
                            <div class="perk-card" style="opacity: 0.85; cursor: default; background: rgba(255, 255, 255, 0.02);">
                                <div class="perk-icon-box" style="background: rgba(66, 133, 244, 0.1); border-color: rgba(66, 133, 244, 0.25);">
                                    <svg width="20" height="20" viewBox="0 0 24 24">
                                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                                    </svg>
                                </div>
                                <div class="perk-info">
                                    <span class="perk-title">Password & Security</span>
                                    <span class="perk-desc">Managed by Google (Single Sign-On enabled)</span>
                                </div>
                                <span style="font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 20px; background: rgba(66, 133, 244, 0.12); color: #93c5fd; border: 1px solid rgba(66, 133, 244, 0.25);">Google Auth</span>
                            </div>
                        <% } else { %>
                            <a href="/user/profile/change-password" class="perk-card">
                                <div class="perk-icon-box">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                </div>
                                <div class="perk-info">
                                    <span class="perk-title">Password & Security</span>
                                    <span class="perk-desc">Keep your account secure with regular updates</span>
                                </div>
                                <span class="perk-arrow">&rarr;</span>
                            </a>
                        <% } %>
                    </div>

                </section>

            </div>

        </div>
    </main>

    <%- include('partials/footer') %>

    <!-- SweetAlert2 for clean pop-up messages -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function copyReferralCode(code) {
            if (!code) return;
            navigator.clipboard.writeText(code).then(() => {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: `Referral code "${code}" copied to clipboard`,
                    showConfirmButton: false,
                    timer: 2500,
                    background: '#141312',
                    color: '#f0ece6',
                    iconColor: '#d48833'
                });
            });
        }

        function copyReferralLink(code) {
            if (!code) return;
            const link = `${window.location.origin}/user/signup?ref=${code}`;
            navigator.clipboard.writeText(link).then(() => {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'Invitation link copied to clipboard',
                    showConfirmButton: false,
                    timer: 2500,
                    background: '#141312',
                    color: '#f0ece6',
                    iconColor: '#d48833'
                });
            });
        }
    </script>
    <% if (typeof success !== 'undefined' && success) { %>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: '<%= success %>',
                    showConfirmButton: false,
                    timer: 3500,
                    timerProgressBar: true,
                    background: '#141312',
                    color: '#f0ece6',
                    iconColor: '#d48833',
                    customClass: {
                        popup: 'swal2-toast-dark'
                    }
                });
            });
        </script>
    <% } %>

</body>

</html>