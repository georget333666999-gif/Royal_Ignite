<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Your Acquired Editions — ROYAL IGNITE' %></title>
    <meta name="description" content="View your order history, delivery statuses, provenances, and invoices at Royal Ignite." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/user/index.css" />
    <link rel="stylesheet" href="/css/user/orderList.css" />

    <!-- SweetAlert2 for Quiet Luxury Dialogs -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .royal-luxury-swal {
            background: #141312 !important;
            border: 1px solid rgba(229, 169, 60, 0.35) !important;
            border-radius: 16px !important;
            padding: 26px 22px !important;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.8) !important;
            color: #f0ece6 !important;
            font-family: 'Manrope', sans-serif !important;
        }
        .royal-swal-title {
            font-family: 'Bodoni Moda', serif !important;
            color: #ffffff !important;
            font-size: 22px !important;
            letter-spacing: 0.3px !important;
            margin-bottom: 8px !important;
        }
        .royal-swal-confirm-btn {
            border-radius: 6px !important;
            font-weight: 600 !important;
            font-size: 13px !important;
            letter-spacing: 0.5px !important;
            padding: 10px 22px !important;
            background: #dc2626 !important;
            color: #ffffff !important;
            border: none !important;
            cursor: pointer !important;
        }
        .royal-swal-confirm-gold {
            background: #F6BD64 !important;
            color: #0E0E12 !important;
        }
        .royal-swal-cancel-btn {
            border-radius: 6px !important;
            font-weight: 500 !important;
            font-size: 13px !important;
            padding: 10px 20px !important;
            background: #27272a !important;
            color: #d4d4d8 !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            cursor: pointer !important;
        }
    </style>
</head>

<body class="orders-body">

    <!-- Header Navigation -->
    <%- include('./partials/header.ejs') %>

    <!-- Main Content -->
    <main class="orders-main">
        <div class="orders-container">

            <!-- Breadcrumbs & Header -->
            <div class="orders-header">
                <div class="orders-breadcrumbs">
                    <a href="/user/profile">Atelier Profile</a>
                    <span>/</span>
                    <span>Acquired Editions</span>
                </div>
                <h1 class="orders-title">
                    Your Acquired <span class="italic-gold">Editions</span>
                </h1>
                <p class="orders-subtitle">
                    Official archival registry of your handcrafted ignition creations, provenances, and delivery milestones.
                </p>
            </div>

            <!-- Search & Filter Toolbar (c.i, c.vii) -->
            <div class="orders-toolbar">
                <form action="/orders" method="GET" class="order-search-form">
                    <input type="hidden" name="status" value="<%= status || 'all' %>" />
                    <svg class="order-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" 
                           name="search" 
                           value="<%= search || '' %>" 
                           placeholder="Search by Order ID or Piece Name..." 
                           class="order-search-input" />
                </form>

                <div class="order-filter-pills">
                    <% 
                        const buildFilterUrl = (st) => {
                            const p = new URLSearchParams();
                            if (st && st !== 'all') p.set('status', st);
                            if (search) p.set('search', search);
                            return '/orders?' + p.toString();
                        };
                        const currentStatus = status || 'all';
                    %>
                    <a href="<%= buildFilterUrl('all') %>" class="filter-pill <%= currentStatus === 'all' ? 'active' : '' %>">All</a>
                    <a href="<%= buildFilterUrl('Placed') %>" class="filter-pill <%= currentStatus === 'Placed' ? 'active' : '' %>">Placed</a>
                    <a href="<%= buildFilterUrl('Processing') %>" class="filter-pill <%= currentStatus === 'Processing' ? 'active' : '' %>">Processing</a>
                    <a href="<%= buildFilterUrl('Shipped') %>" class="filter-pill <%= currentStatus === 'Shipped' ? 'active' : '' %>">Shipped</a>
                    <a href="<%= buildFilterUrl('Delivered') %>" class="filter-pill <%= currentStatus === 'Delivered' ? 'active' : '' %>">Delivered</a>
                    <a href="<%= buildFilterUrl('Cancelled') %>" class="filter-pill <%= currentStatus === 'Cancelled' ? 'active' : '' %>">Cancelled</a>
                    <a href="<%= buildFilterUrl('Returned') %>" class="filter-pill <%= currentStatus === 'Returned' ? 'active' : '' %>">Returned</a>
                </div>
            </div>

            <!-- Orders Listing -->
            <% if (Array.isArray(orders) && orders.length > 0) { %>
                <div class="orders-list">
                    <% orders.forEach(function(order) { %>
                        <article class="order-card" id="order-card-<%= order.orderId %>">
                            
                            <!-- Top Bar: Order ID, Date & Status -->
                            <div class="order-card-header">
                                <div class="order-id-group">
                                    <span class="order-id-val">#<%= order.orderId %></span>
                                    <span class="order-date-text">
                                        Ordered on <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                    </span>
                                </div>

                                <div class="status-badge <%= order.orderStatus.toLowerCase() %>">
                                    <span class="status-dot"></span>
                                    <span><%= order.orderStatus %></span>
                                </div>
                            </div>

                            <!-- Body: Items Preview -->
                            <div class="order-card-body">
                                <% order.items.forEach(function(item) { %>
                                    <div class="order-item-row">
                                        <div class="order-item-left">
                                            <div class="order-item-thumb">
                                                <img src="<%= item.image || '/uploads/hero_lighter.png' %>" 
                                                     alt="<%= item.name %>" 
                                                     loading="lazy"
                                                     onerror="this.src='/uploads/hero_lighter.png';" />
                                            </div>
                                            <div class="order-item-meta">
                                                <div class="order-item-name"><%= item.name %></div>
                                                <div class="order-item-sub">
                                                    Qty: <%= item.quantity %> • Unit: ₹<%= Number(item.price).toLocaleString('en-IN') %>
                                                    <% if (item.status && item.status !== order.orderStatus) { %>
                                                        • <span style="color: var(--ol-gold); font-weight: 600;"><%= item.status %></span>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="order-item-right">
                                            ₹<%= Number(item.lineTotal).toLocaleString('en-IN') %>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>

                            <!-- Footer: Total & Actions (c.ii, c.iv, c.v, c.vi) -->
                            <div class="order-card-footer">
                                <div class="order-total-col">
                                    <span class="order-total-label">Total Amount (<%= order.paymentMethod %>)</span>
                                    <span class="order-total-amount">₹<%= Number(order.pricing ? order.pricing.totalAmount : 0).toLocaleString('en-IN') %></span>
                                </div>

                                <div class="order-card-actions">
                                    <!-- Invoice Download (c.vi) -->
                                    <a href="/orders/<%= order.orderId %>/invoice" class="btn-order-invoice" title="Download Official Tax Invoice">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                            <polyline points="7 10 12 15 17 10"></polyline>
                                            <line x1="12" y1="15" x2="12" y2="3"></line>
                                        </svg>
                                        <span>Invoice</span>
                                    </a>

                                    <!-- Cancel Order (c.ii, c.iii) -->
                                    <% if (order.orderStatus === 'Placed' || order.orderStatus === 'Processing') { %>
                                        <button type="button" 
                                                class="btn-order-cancel" 
                                                onclick="promptCancelOrder('<%= order.orderId %>')">
                                            Cancel Order
                                        </button>
                                    <% } %>

                                    <!-- Return Order (c.iv) -->
                                    <% if (order.orderStatus === 'Delivered') { %>
                                        <button type="button" 
                                                class="btn-order-return" 
                                                onclick="promptReturnOrder('<%= order.orderId %>')">
                                            Return Order
                                        </button>
                                    <% } %>

                                    <!-- View Details (c.v) -->
                                    <a href="/orders/<%= order.orderId %>" class="btn-order-view">
                                        View Details →
                                    </a>
                                </div>
                            </div>

                        </article>
                    <% }); %>
                </div>

                <!-- Pagination -->
                <% if (totalPages > 1) { %>
                    <div class="orders-pagination">
                        <% if (currentPage > 1) { %>
                            <a href="?page=<%= currentPage - 1 %>&search=<%= search %>&status=<%= status %>" class="page-btn">← Previous</a>
                        <% } %>

                        <% for (let p = 1; p <= totalPages; p++) { %>
                            <a href="?page=<%= p %>&search=<%= search %>&status=<%= status %>" class="page-btn <%= currentPage === p ? 'active' : '' %>"><%= p %></a>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %>&search=<%= search %>&status=<%= status %>" class="page-btn">Next →</a>
                        <% } %>
                    </div>
                <% } %>

            <% } else { %>
                <!-- Empty State -->
                <div class="orders-empty-state">
                    <div class="orders-empty-icon">
                        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                    </div>
                    <h2 class="orders-empty-title">No Acquired Editions Found</h2>
                    <p class="orders-empty-desc">
                        <%= search || (status && status !== 'all') ? 'No orders match your active search or status criteria.' : 'You have not reserved any creations in the atelier yet.' %>
                    </p>
                    <a href="/products" class="btn-order-view" style="display: inline-block; padding: 12px 24px;">
                        Explore The Collection
                    </a>
                </div>
            <% } %>

        </div>
    </main>

    <!-- Footer Partial -->
    <%- include('./partials/footer.ejs') %>

    <!-- Order Actions Logic Scripts -->
    <script>
        // Prompt Cancel Order with Optional Reason (c.ii, c.iii)
        function promptCancelOrder(orderId) {
            Swal.fire({
                title: 'Cancel Acquisition?',
                html: `Are you sure you wish to cancel order <strong>#${orderId}</strong>?<br><span style="font-size: 13px; color: #9A9388; display: block; margin-top: 8px;">Stock will be returned to the atelier.</span>`,
                input: 'text',
                inputPlaceholder: 'Reason for cancellation (optional)...',
                icon: 'warning',
                iconColor: '#F6BD64',
                showCancelButton: true,
                confirmButtonText: 'Confirm Cancellation',
                cancelButtonText: 'Keep Order',
                customClass: {
                    popup: 'royal-luxury-swal',
                    title: 'royal-swal-title',
                    confirmButton: 'royal-swal-confirm-btn',
                    cancelButton: 'royal-swal-cancel-btn'
                }
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const reason = result.value || '';
                    try {
                        const response = await fetch(`/orders/${orderId}/cancel`, {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json',
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ reason })
                        });

                        const data = await response.json();

                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Cancelled',
                                text: data.message || 'Your order has been cancelled.',
                                background: '#141312',
                                color: '#eae6df',
                                confirmButtonColor: '#F6BD64'
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Notice',
                                text: data.message || 'Could not cancel order.',
                                background: '#141312',
                                color: '#eae6df',
                                confirmButtonColor: '#F6BD64'
                            });
                        }
                    } catch (err) {
                        console.error('Cancel order error:', err);
                        Swal.fire({
                            icon: 'error',
                            title: 'Notice',
                            text: 'An error occurred while connecting to the server.',
                            background: '#141312',
                            color: '#eae6df',
                            confirmButtonColor: '#F6BD64'
                        });
                    }
                }
            });
        }

        // Prompt Return Order with Mandatory Reason (c.iv)
        function promptReturnOrder(orderId) {
            Swal.fire({
                title: 'Request Order Return',
                html: `Please provide a mandatory reason to initiate an atelier return for order <strong>#${orderId}</strong>:`,
                input: 'textarea',
                inputPlaceholder: 'State reason for return (mandatory)...',
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'A return reason is mandatory to proceed.';
                    }
                },
                icon: 'question',
                iconColor: '#F6BD64',
                showCancelButton: true,
                confirmButtonText: 'Submit Return Request',
                cancelButtonText: 'Cancel',
                customClass: {
                    popup: 'royal-luxury-swal',
                    title: 'royal-swal-title',
                    confirmButton: 'royal-swal-confirm-btn royal-swal-confirm-gold',
                    cancelButton: 'royal-swal-cancel-btn'
                }
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const reason = result.value.trim();
                    try {
                        const response = await fetch(`/orders/${orderId}/return`, {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json',
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ reason })
                        });

                        const data = await response.json();

                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Return Initiated',
                                text: data.message || 'Return request registered successfully.',
                                background: '#141312',
                                color: '#eae6df',
                                confirmButtonColor: '#F6BD64'
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Notice',
                                text: data.message || 'Could not process return request.',
                                background: '#141312',
                                color: '#eae6df',
                                confirmButtonColor: '#F6BD64'
                            });
                        }
                    } catch (err) {
                        console.error('Return order error:', err);
                        Swal.fire({
                            icon: 'error',
                            title: 'Notice',
                            text: 'An error occurred while connecting to the server.',
                            background: '#141312',
                            color: '#eae6df',
                            confirmButtonColor: '#F6BD64'
                        });
                    }
                }
            });
        }
    </script>

</body>
</html>
