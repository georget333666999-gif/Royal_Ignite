<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
</head>

<body>

    <%- include('partials/header') %>

    <main class="auth-wrapper">
        <div class="gold-card">
            
            <h1 class="auth-title">Reset Password</h1>
            <p class="auth-subtitle">
                Update your password to maintain access to your precision tools.
            </p>

            <% if (typeof error !== "undefined" && error) { %>
                <div class="error-badge"><%= error %></div>
            <% } %>

            <div id="expiredNotice" class="error-badge" style="display: <%= typeof isExpired !== 'undefined' && isExpired ? 'block' : 'none' %>; margin-bottom: 16px;">
                ⏱️ Your OTP has expired. Please click <strong>Resend Code</strong> below to request a new password reset code.
            </div>

            <div id="otpMeta" 
                data-remaining="<%= typeof remainingSeconds !== 'undefined' ? remainingSeconds : 300 %>"
                data-expired="<%= typeof isExpired !== 'undefined' && isExpired ? 'true' : 'false' %>"
                style="display: none;">
            </div>

            <form action="/user/reset-password" method="POST" id="resetForm" novalidate>
                
                <div class="form-group">
                    <label for="otpCode">OTP Code *</label>
                    <input
                        type="text"
                        id="otpCode"
                        name="otpCode"
                        class="form-input"
                        placeholder="Enter 6-digit OTP"
                        maxlength="6"
                        pattern="[0-9]{6}"
                        inputmode="numeric"
                        data-validate="otp"
                        required
                        <%= typeof isExpired !== 'undefined' && isExpired ? 'disabled' : '' %>
                    />
                </div>

                <div class="form-group">
                    <label for="newPassword">New Password *</label>
                    <input
                        type="password"
                        id="newPassword"
                        name="newPassword"
                        class="form-input"
                        placeholder="Minimum 8 characters (letters & numbers)"
                        data-validate="password"
                        required
                        <%= typeof isExpired !== 'undefined' && isExpired ? 'disabled' : '' %>
                    />
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm New Password *</label>
                    <input
                        type="password"
                        id="confirmPassword"
                        name="confirmPassword"
                        class="form-input"
                        placeholder="Re-enter new password"
                        data-validate="confirmPassword"
                        required
                        <%= typeof isExpired !== 'undefined' && isExpired ? 'disabled' : '' %>
                    />
                </div>

                <button type="submit" id="resetBtn" class="primary-btn" <%= typeof isExpired !== 'undefined' && isExpired ? 'disabled style="opacity: 0.5; cursor: not-allowed;"' : '' %>>
                    RESET PASSWORD
                </button>

            </form>

            <div class="auth-switch" style="margin-top: 24px; display: flex; justify-content: space-between; align-items: center;">
                <a href="/user/forgot-password" class="resend-btn">Resend Code</a>
                <span id="timerContainer" style="font-size: 13px; font-weight: 500; color: #a8a196;">
                    Expires in <strong id="timer" style="color: var(--gold-light);">05:00</strong>
                </span>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/validation.js"></script>

    <script>
        const metaEl = document.getElementById("otpMeta");
        let serverRemaining = parseInt(metaEl.getAttribute("data-remaining"), 10);
        let isExpiredInitial = metaEl.getAttribute("data-expired") === "true";

        let otpTimeLeft = isNaN(serverRemaining) ? 300 : serverRemaining;
        const timerElement = document.getElementById("timer");
        const resetBtn = document.getElementById("resetBtn");
        const otpInput = document.getElementById("otpCode");
        const newPassInput = document.getElementById("newPassword");
        const confirmPassInput = document.getElementById("confirmPassword");
        const expiredNotice = document.getElementById("expiredNotice");

        function markOtpExpired() {
            if (timerElement) timerElement.textContent = "00:00";
            if (expiredNotice) expiredNotice.style.display = "block";
            if (resetBtn) {
                resetBtn.disabled = true;
                resetBtn.style.opacity = "0.5";
                resetBtn.style.cursor = "not-allowed";
            }
            if (otpInput) otpInput.disabled = true;
            if (newPassInput) newPassInput.disabled = true;
            if (confirmPassInput) confirmPassInput.disabled = true;
        }

        if (isExpiredInitial || otpTimeLeft <= 0) {
            markOtpExpired();
        } else {
            function updateOtpTimer() {
                const minutes = Math.floor(otpTimeLeft / 60);
                const seconds = otpTimeLeft % 60;

                if (timerElement) {
                    timerElement.textContent =
                        String(minutes).padStart(2, "0") + ":" + String(seconds).padStart(2, "0");
                }

                if (otpTimeLeft <= 0) {
                    clearInterval(otpTimer);
                    markOtpExpired();
                    return;
                }
                otpTimeLeft--;
            }

            updateOtpTimer();
            const otpTimer = setInterval(updateOtpTimer, 1000);
        }
    </script>
    <script src="/js/validation.js"></script>

</body>

</html>
