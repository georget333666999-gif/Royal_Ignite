<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css?v=2" />
    <script defer src="/js/authAnimations.js"></script>
</head>

<body>

    <%- include('partials/header') %>

    <main class="auth-wrapper">
        <div class="gold-card">
            
            <h1 class="auth-title">Reset Password</h1>
            <p class="auth-subtitle">
                Update your password to maintain access to your precision tools.
            </p>

            <% if (typeof error !== "undefined" && error) { %>
                <div class="error-badge" id="serverErrorBadge"><%= error %></div>
            <% } %>

            <div id="expiredNotice" class="error-badge" style="display: <%= typeof isExpired !== 'undefined' && isExpired ? 'block' : 'none' %>; margin-bottom: 16px;">
                ⏱️ Your OTP has expired. Please click <strong>Resend Code</strong> below to request a new password reset code.
            </div>

            <div id="otpMeta" 
                data-remaining="<%= typeof remainingSeconds !== 'undefined' ? remainingSeconds : 60 %>"
                data-expired="<%= typeof isExpired !== 'undefined' && isExpired ? 'true' : 'false' %>"
                style="display: none;">
            </div>

            <form action="/user/reset-password" method="POST" id="resetForm" novalidate>
                
                <div class="form-group">
                    <label for="otpCode">OTP Code *</label>
                    <input
                        type="text"
                        id="otpCode"
                        name="otpCode"
                        class="form-input"
                        placeholder="Enter 6-digit OTP"
                        maxlength="6"
                        pattern="[0-9]{6}"
                        inputmode="numeric"
                        data-validate="otp"
                        required
                        <%= typeof isExpired !== 'undefined' && isExpired ? 'disabled' : '' %>
                    />
                </div>

                <div class="form-group">
                    <label for="newPassword">New Password *</label>
                    <input
                        type="password"
                        id="newPassword"
                        name="newPassword"
                        class="form-input"
                        placeholder="Minimum 8 characters (letters & numbers)"
                        data-validate="password"
                        required
                        <%= typeof isExpired !== 'undefined' && isExpired ? 'disabled' : '' %>
                    />
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm New Password *</label>
                    <input
                        type="password"
                        id="confirmPassword"
                        name="confirmPassword"
                        class="form-input"
                        placeholder="Re-enter new password"
                        data-validate="confirmPassword"
                        required
                        <%= typeof isExpired !== 'undefined' && isExpired ? 'disabled' : '' %>
                    />
                </div>

                <button type="submit" id="resetBtn" class="primary-btn" <%= typeof isExpired !== 'undefined' && isExpired ? 'disabled style="opacity: 0.5; cursor: not-allowed;"' : '' %>>
                    RESET PASSWORD
                </button>

            </form>

            <div class="auth-switch" style="margin-top: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <div>
                    Didn't receive the code?
                    <form action="/user/resend-reset-otp" method="POST" id="resendForm" style="display: inline;">
                        <button type="submit" id="resendButton" class="resend-btn" <%= typeof isExpired !== 'undefined' && isExpired ? '' : 'disabled' %>>
                            Resend Code
                        </button>
                    </form>
                </div>
                <div id="timerContainer" class="otp-timer-container">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>EXPIRES IN <strong id="timer">01:00</strong></span>
                </div>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/validation.js"></script>

    <% if (typeof success !== 'undefined' && success) { %>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: <%- JSON.stringify(success) %>,
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true,
                background: '#141312',
                color: '#f0ece6',
                iconColor: '#d48833'
            });
        });
    </script>
    <% } %>

    <script>
        const metaEl = document.getElementById("otpMeta");
        let serverRemaining = parseInt(metaEl.getAttribute("data-remaining"), 10);
        let isExpiredInitial = metaEl.getAttribute("data-expired") === "true";

        let otpTimeLeft = isNaN(serverRemaining) ? 60 : serverRemaining;
        const timerElement = document.getElementById("timer");
        const resetBtn = document.getElementById("resetBtn");
        const otpInput = document.getElementById("otpCode");
        const newPassInput = document.getElementById("newPassword");
        const confirmPassInput = document.getElementById("confirmPassword");
        const expiredNotice = document.getElementById("expiredNotice");
        const resendButton = document.getElementById("resendButton");
        const resendForm = document.getElementById("resendForm");
        const serverErrorBadge = document.getElementById("serverErrorBadge");

        let otpTimer = null;

        function markOtpExpired() {
            if (timerElement) timerElement.textContent = "00:00";
            if (expiredNotice) {
                expiredNotice.innerHTML = "⏱️ Your OTP has expired. Please click <strong>Resend Code</strong> below to request a new password reset code.";
                expiredNotice.style.display = "block";
            }
            if (resetBtn) {
                resetBtn.disabled = true;
                resetBtn.style.opacity = "0.5";
                resetBtn.style.cursor = "not-allowed";
            }
            if (otpInput) otpInput.disabled = true;
            if (newPassInput) newPassInput.disabled = true;
            if (confirmPassInput) confirmPassInput.disabled = true;
            if (resendButton) {
                resendButton.disabled = false;
                resendButton.textContent = "Resend Code";
            }
            if (otpTimer) {
                clearInterval(otpTimer);
                otpTimer = null;
            }
        }

        function startOtpTimer() {
            if (otpTimer) clearInterval(otpTimer);

            // While OTP is active, Resend button is inaccessible
            if (resendButton) {
                resendButton.disabled = true;
                resendButton.textContent = "Resend Code";
            }

            function updateOtpTimer() {
                if (otpTimeLeft <= 0) {
                    clearInterval(otpTimer);
                    otpTimer = null;
                    markOtpExpired();
                    return;
                }

                const minutes = Math.floor(otpTimeLeft / 60);
                const seconds = otpTimeLeft % 60;

                if (timerElement) {
                    timerElement.textContent =
                        String(minutes).padStart(2, "0") + ":" + String(seconds).padStart(2, "0");
                }

                otpTimeLeft--;
            }

            updateOtpTimer();
            otpTimer = setInterval(updateOtpTimer, 1000);
        }

        if (isExpiredInitial || otpTimeLeft <= 0) {
            markOtpExpired();
        } else {
            startOtpTimer();
        }

        // AJAX Resend Code
        if (resendForm) {
            resendForm.addEventListener("submit", async (e) => {
                e.preventDefault();
                if (resendButton.disabled) return;

                resendButton.disabled = true;
                resendButton.textContent = "Sending...";

                try {
                    const response = await fetch("/user/resend-reset-otp", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "Accept": "application/json"
                        }
                    });
                    const data = await response.json();

                    if (!data.success) {
                        if (expiredNotice) {
                            expiredNotice.textContent = data.message || "Unable to resend OTP.";
                            expiredNotice.style.display = "block";
                        }
                        resendButton.disabled = false;
                        resendButton.textContent = "Resend Code";
                        return;
                    }

                    // Reset form state on successful resend
                    if (expiredNotice) expiredNotice.style.display = "none";
                    if (serverErrorBadge) serverErrorBadge.style.display = "none";

                    if (otpInput) {
                        otpInput.disabled = false;
                        otpInput.value = "";
                        otpInput.focus();
                    }
                    if (newPassInput) newPassInput.disabled = false;
                    if (confirmPassInput) confirmPassInput.disabled = false;
                    if (resetBtn) {
                        resetBtn.disabled = false;
                        resetBtn.style.opacity = "1";
                        resetBtn.style.cursor = "pointer";
                    }

                    otpTimeLeft = data.remainingSeconds || 60;
                    startOtpTimer();

                    Swal.fire({
                        toast: true,
                        position: "top-end",
                        icon: "success",
                        title: data.message || "A fresh 6-digit reset code has been sent.",
                        showConfirmButton: false,
                        timer: 4000,
                        timerProgressBar: true,
                        background: "#141312",
                        color: "#f0ece6",
                        iconColor: "#d48833"
                    });
                } catch (err) {
                    console.error("Resend error:", err);
                    resendButton.disabled = false;
                    resendButton.textContent = "Resend Code";
                    if (expiredNotice) {
                        expiredNotice.textContent = "Network error while resending. Please try again.";
                        expiredNotice.style.display = "block";
                    }
                }
            });
        }

        // Force refresh from server on back-forward navigation or BFCache restore to prevent viewing cached auth page
        window.addEventListener('pageshow', function (event) {
            if (event.persisted || (window.performance && window.performance.getEntriesByType && window.performance.getEntriesByType('navigation')[0]?.type === 'back_forward')) {
                window.location.reload();
            }
        });
    </script>

</body>

</html>
