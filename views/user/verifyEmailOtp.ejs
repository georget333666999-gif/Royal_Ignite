<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify New Email - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
</head>

<body>

    <%- include('partials/header') %>

    <main class="auth-wrapper">
        <div class="gold-card" style="text-align: center;">
            
            <h1 class="auth-title">Verify New Email</h1>
            <p class="auth-subtitle">
                Enter the 6-digit verification code sent to: <strong><%= pendingEmail %></strong>
            </p>

            <% if (typeof success !== "undefined" && success) { %>
                <div class="success-badge"><%= success %></div>
            <% } %>

            <% if (typeof error !== "undefined" && error) { %>
                <div class="error-badge"><%= error %></div>
            <% } %>

            <div id="expiredNotice" class="error-badge" style="display: <%= typeof isExpired !== 'undefined' && isExpired ? 'block' : 'none' %>; margin-bottom: 16px;">
                ⏱️ Your OTP has expired. Please click <strong>Resend Code</strong> below or re-enter your email.
            </div>

            <div id="otpMeta" 
                data-remaining="<%= typeof remainingSeconds !== 'undefined' ? remainingSeconds : 300 %>"
                data-resend-cooldown="<%= typeof resendCooldownSeconds !== 'undefined' ? resendCooldownSeconds : 30 %>"
                data-expired="<%= typeof isExpired !== 'undefined' && isExpired ? 'true' : 'false' %>"
                style="display: none;">
            </div>

            <form action="/user/profile/verify-email-otp" method="POST" novalidate>
                
                <div class="form-group" style="text-align: left;">
                    <input
                        type="text"
                        id="otpCode"
                        name="otpCode"
                        class="form-input"
                        placeholder="Enter 6-digit OTP"
                        maxlength="6"
                        minlength="6"
                        pattern="[0-9]{6}"
                        inputmode="numeric"
                        autocomplete="one-time-code"
                        style="text-align: center; font-size: 22px; letter-spacing: 6px; font-weight: bold;"
                        data-validate="otp"
                        required
                        <%= typeof isExpired !== 'undefined' && isExpired ? 'disabled' : '' %>
                    />
                </div>

                <button type="submit" id="verifyBtn" class="primary-btn" <%= typeof isExpired !== 'undefined' && isExpired ? 'disabled style="opacity: 0.5; cursor: not-allowed;"' : '' %>>
                    CONFIRM & CHANGE EMAIL &rarr;
                </button>

            </form>

            <div class="auth-switch" style="margin-top: 24px; display: flex; flex-direction: column; gap: 10px; align-items: center;">
                <div>
                    Didn't receive the code?
                    <form action="/user/profile/resend-email-otp" method="POST" id="resendForm" style="display: inline;">
                        <button type="submit" id="resendButton" class="resend-btn">
                            Resend Code
                        </button>
                    </form>
                </div>
                <a href="/user/profile/change-email" class="reenter-email-btn">
                    &larr; Re-enter Email Address
                </a>
            </div>

            <div id="timerContainer" class="otp-timer-container">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>EXPIRES IN <strong id="timer">05:00</strong></span>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/validation.js"></script>

    <script>
        const metaEl = document.getElementById("otpMeta");
        let serverRemaining = parseInt(metaEl.getAttribute("data-remaining"), 10);
        let isExpiredInitial = metaEl.getAttribute("data-expired") === "true";

        let otpTimeLeft = isNaN(serverRemaining) ? 300 : serverRemaining;

        const timerElement = document.getElementById("timer");
        const resendButton = document.getElementById("resendButton");
        const verifyBtn = document.getElementById("verifyBtn");
        const otpInput = document.getElementById("otpCode");
        const expiredNotice = document.getElementById("expiredNotice");

        let otpTimer = null;

        function markOtpExpired() {
            if (timerElement) timerElement.textContent = "00:00";
            if (expiredNotice) expiredNotice.style.display = "block";
            if (verifyBtn) {
                verifyBtn.disabled = true;
                verifyBtn.style.opacity = "0.5";
                verifyBtn.style.cursor = "not-allowed";
            }
            if (otpInput) {
                otpInput.disabled = true;
            }
            if (resendButton) {
                resendButton.disabled = false;
                resendButton.textContent = "Resend Code";
            }
            if (otpTimer) {
                clearInterval(otpTimer);
                otpTimer = null;
            }
        }

        function startOtpTimer() {
            if (otpTimer) clearInterval(otpTimer);

            if (resendButton) {
                resendButton.disabled = true;
                resendButton.textContent = "Resend Code";
            }

            function updateOtpTimer() {
                if (otpTimeLeft <= 0) {
                    clearInterval(otpTimer);
                    otpTimer = null;
                    markOtpExpired();
                    return;
                }

                const minutes = Math.floor(otpTimeLeft / 60);
                const seconds = otpTimeLeft % 60;

                if (timerElement) {
                    timerElement.textContent =
                        String(minutes).padStart(2, "0") + ":" + String(seconds).padStart(2, "0");
                }

                otpTimeLeft--;
            }

            updateOtpTimer();
            otpTimer = setInterval(updateOtpTimer, 1000);
        }

        if (isExpiredInitial || otpTimeLeft <= 0) {
            markOtpExpired();
        } else {
            startOtpTimer();
        }
    </script>
    <script src="/js/validation.js"></script>

</body>

</html>
