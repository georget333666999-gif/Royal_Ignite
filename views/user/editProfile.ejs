<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Profile - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
    <link rel="stylesheet" href="/css/user/profile.css" />
</head>

<body>

    <%- include('partials/header') %>

    <div class="modal-overlay">
        <div class="modal-card">
            
            <a href="/user/profile" class="modal-close" title="Close">&times;</a>

            <h2 class="modal-title">Edit Profile</h2>

            <% if (error) { %>
                <div class="error-badge"><%= error %></div>
            <% } %>

            <form action="/user/profile/edit" method="POST" enctype="multipart/form-data" id="editProfileForm" novalidate>
                
                <!-- Avatar Photo Actions -->
                <div class="modal-avatar-sec">
                    <img 
                        src="<%= user.imgUrl || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name) + '&background=111111&color=ffffff&size=150' %>" 
                        alt="<%= user.name %>" 
                        class="avatar-img"
                        id="avatarPreview"
                        style="width: 100px; height: 100px;"
                    />
                    
                    <div class="photo-actions">
                        <label for="profileImage" class="btn-choose-photo">
                            CHOOSE IMAGE
                        </label>
                        <input 
                            type="file" 
                            id="profileImage" 
                            name="profileImage" 
                            accept="image/jpeg,image/png,image/webp" 
                            style="display: none;" 
                            onchange="previewImage(this);"
                        />
                    </div>
                </div>

                <!-- Input Grid -->
                <div class="modal-form-grid">
                    
                    <div class="form-group">
                        <label for="name">Full Name *</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            class="form-input"
                            value="<%= user.name %>"
                            data-validate="name"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="phone">Phone Number *</label>
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            class="form-input"
                            value="<%= user.phone || '' %>"
                            maxlength="10"
                            placeholder="Enter 10-digit phone"
                            data-validate="phone"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="email">Email Address *</label>
                        <input
                            type="email"
                            id="email"
                            class="form-input"
                            value="<%= user.email %>"
                            disabled
                        />
                        <% if (user.googleId) { %>
                            <small style="display: inline-flex; align-items: center; gap: 6px; margin-top: 6px; color: #8c857b; font-size: 12px;">
                                <svg width="12" height="12" viewBox="0 0 24 24">
                                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                                </svg>
                                Managed by Google (email cannot be modified)
                            </small>
                        <% } else { %>
                            <small style="display: block; margin-top: 6px; color: #8c857b;">
                                <a href="/user/profile/change-email" style="color: var(--gold-primary); font-weight: 500; text-decoration: underline;">Change email via OTP</a>
                            </small>
                        <% } %>
                    </div>

                    <div class="form-group">
                        <label for="memberSince">Member Since *</label>
                        <input
                            type="text"
                            id="memberSince"
                            class="form-input"
                            value="<%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : 'N/A' %>"
                            disabled
                        />
                    </div>

                </div>

                <!-- Action Footer -->
                <div class="modal-actions">
                    <a href="/user/profile" class="btn-cancel">CANCEL</a>
                    <button type="submit" class="btn-save">SAVE CHANGES</button>
                </div>

            </form>

        </div>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/validation.js"></script>

    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatarPreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>

</body>

</html>