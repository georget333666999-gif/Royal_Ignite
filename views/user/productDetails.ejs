<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= product.name %> — ROYAL IGNITE</title>
    <meta name="description" content="<%= (product.description || '').slice(0, 160) %>" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Cinzel:wght@400;500;600;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/user/index.css" />
    <link rel="stylesheet" href="/css/user/shop.css" />
    <link rel="stylesheet" href="/css/user/productDetails.css?v=2.1" />
    <!-- SweetAlert2 for Quiet Luxury Alerts & Notifications -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .royal-luxury-swal {
            background: #141312 !important;
            border: 1px solid rgba(229, 169, 60, 0.35) !important;
            border-radius: 16px !important;
            padding: 26px 22px !important;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.8) !important;
            color: #f0ece6 !important;
            font-family: 'Manrope', sans-serif !important;
        }
        .royal-swal-title {
            font-family: 'Bodoni Moda', serif !important;
            color: #ffffff !important;
            font-size: 22px !important;
            letter-spacing: 0.3px !important;
            margin-bottom: 8px !important;
        }
        .royal-swal-confirm-btn {
            border-radius: 6px !important;
            font-weight: 600 !important;
            font-size: 13px !important;
            letter-spacing: 0.5px !important;
            padding: 10px 22px !important;
            background: #E5A93C !important;
            color: #141312 !important;
            border: none !important;
            cursor: pointer !important;
            transition: opacity 0.2s ease !important;
        }
        .royal-swal-confirm-btn:hover {
            opacity: 0.9 !important;
        }
        .royal-swal-cancel-btn {
            border-radius: 6px !important;
            font-weight: 500 !important;
            font-size: 13px !important;
            letter-spacing: 0.5px !important;
            padding: 10px 20px !important;
            background: #27272a !important;
            color: #d4d4d8 !important;
            border: none !important;
            cursor: pointer !important;
        }
        .royal-swal-cancel-btn:hover {
            background: #3f3f46 !important;
            color: #ffffff !important;
        }
        .royal-swal-toast {
            background: #141312 !important;
            border: 1px solid rgba(229, 169, 60, 0.35) !important;
            border-radius: 8px !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7) !important;
            color: #eae6df !important;
            font-family: 'Manrope', sans-serif !important;
        }
        @keyframes cartPulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.22); color: #E5A93C; }
            100% { transform: scale(1); }
        }
        .cart-pulse-active {
            animation: cartPulse 0.6s ease-in-out;
        }
        @keyframes dtSpin {
            100% { transform: rotate(360deg); }
        }
        .dt-spin {
            animation: dtSpin 0.8s linear infinite;
        }
    </style>
</head>

<body class="details-body">

    <!-- Header Navigation -->
    <%- include('./partials/header.ejs') %>

    <!-- 1. BREADCRUMBS -->
    <section class="dt-breadcrumb-section">
        <div class="dt-container">
            <nav class="dt-breadcrumb" aria-label="Breadcrumb">
                <a href="/">HOME</a>
                <span class="dt-crumb-sep">&gt;</span>
                <% 
                    const catName = (product.category && product.category.name) ? product.category.name.toUpperCase() : 'THE COLLECTION';
                    let catLink = '/products';
                    if (catName.includes('FUEL')) catLink = '/fuel-lighters';
                    else if (catName.includes('GAS')) catLink = '/gas-lighters';
                    else if (catName.includes('ELECTRIC')) catLink = '/electric-lighters';
                    else if (catName.includes('REFILL') || catName.includes('CARE')) catLink = '/refills-and-care';
                    else if (product.category) catLink = `/products?category=${product.category._id}`;
                %>
                <a href="<%= catLink %>"><%= catName %></a>
                <span class="dt-crumb-sep">&gt;</span>
                <span class="dt-crumb-active"><%= product.name.toUpperCase() %></span>
            </nav>
        </div>
    </section>

    <!-- 2. PRODUCT MAIN HERO: GALLERY + BUY PANEL -->
    <main class="dt-product-hero">
        <div class="dt-container">
            <div class="dt-hero-grid">

                <!-- ----------------------------------------------------
                     LEFT COLUMN: GALLERY WITH VERTICAL THUMBNAIL STRIP
                     ---------------------------------------------------- -->
                <%
                    const isRefillsOrCare = Boolean(
                        (product.category && (
                            (typeof product.category === 'string' && /refill|care/i.test(product.category)) ||
                            (product.category.name && /refill|care/i.test(product.category.name))
                        )) ||
                        catName.includes('REFILL') ||
                        catName.includes('CARE')
                    );

                    // Prepare list of gallery images
                    let galleryImages = [];
                    if (Array.isArray(product.images) && product.images.length > 0) {
                        if (isRefillsOrCare) {
                            // Refills & Care keep only the primary image
                            galleryImages = [product.images[0]];
                        } else {
                            // Fuel, Gas, and Electric lighters retain multiple angles
                            galleryImages = product.images.slice(0, 2);
                        }
                    } else {
                        galleryImages = ['/uploads/products/monarch/angle_front.jpg', '/uploads/products/monarch/angle_side.jpg'];
                    }

                    const isSingleImage = galleryImages.length <= 1;
                    const angleLabels = isSingleImage ? ["Product View"] : ["Front View", "Side Profile"];
                %>

                <div class="dt-gallery-wrap <%= galleryImages.length <= 1 ? 'dt-gallery-single' : '' %>">

                    <!-- Vertical Thumbnails Column (Only shown when multiple angle views exist) -->
                    <% if (galleryImages.length > 1) { %>
                    <div class="dt-thumbnails-column" id="thumbnailsColumn" role="tablist">
                        <% galleryImages.forEach(function(imgSrc, idx) { 
                            const angleLabel = angleLabels[idx] || `Angle 0${idx + 1}`;
                        %>
                            <button type="button" 
                                    class="dt-thumbnail-btn <%= idx === 0 ? 'active' : '' %>" 
                                    onclick="switchGalleryAngle(this)"
                                    data-img="<%= imgSrc %>" 
                                    data-index="<%= idx + 1 %>"
                                    data-label="<%= angleLabel %>"
                                    title="<%= angleLabel %>"
                                    aria-label="View <%= product.name %> <%= angleLabel %>">
                                <img src="<%= imgSrc %>" alt="<%= product.name %> <%= angleLabel %>" loading="lazy" onerror="this.src='/uploads/monarch_lighter.png';" />
                                <span class="dt-thumb-angle-label"><%= angleLabel %></span>
                            </button>
                        <% }); %>
                    </div>
                    <% } %>

                    <!-- Main Display Frame with High-Precision Cursor Zoom -->
                    <div class="dt-main-display" id="mainDisplay" title="Hover to Zoom • Click to Expand">
                        
                        <!-- Top Left Indicator Pill -->
                        <div class="dt-image-indicator-pill">
                            <span class="dt-indicator-dot"></span>
                            <span id="activeAngleText"><%= angleLabels[0] %></span>
                        </div>

                        <!-- Top Right Zoom Cue Pill -->
                        <div class="dt-zoom-cue-pill" id="zoomCuePill">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                <line x1="11" y1="8" x2="11" y2="14"></line>
                                <line x1="8" y1="11" x2="14" y2="11"></line>
                            </svg>
                            <span id="zoomCueText">Hover to Zoom</span>
                        </div>

                        <!-- Main Image -->
                        <img id="activeProductImage" 
                             class="dt-active-img" 
                             src="<%= galleryImages[0] %>" 
                             alt="<%= product.name %>" 
                             onerror="this.src='/uploads/monarch_lighter.png';" />

                        <!-- Bottom Right Pagination Badge e.g. 1/2 (shown only if multiple angles exist) -->
                        <% if (galleryImages.length > 1) { %>
                        <div class="dt-gallery-pagination-badge">
                            <span class="dt-current-index" id="currentImgIndex">1</span> / <span id="totalImgCount"><%= galleryImages.length %></span>
                        </div>
                        <% } %>
                    </div>

                </div>

                <!-- ----------------------------------------------------
                     RIGHT COLUMN: PRODUCT DETAILS & PURCHASE PANEL
                     ---------------------------------------------------- -->
                <div class="dt-details-panel">
                    
                    <!-- Category Tag Kicker & Privilege Pill -->
                    <div class="dt-kicker-row">
                        <span class="dt-category-kicker">
                            <%= (product.category && product.category.name) ? `THE ${product.category.name.toUpperCase()} COLLECTION` : 'THE FUEL COLLECTION' %>
                        </span>
                        <% if (product.appliedOffer) { %>
                            <span class="dt-offer-pill-badge" title="Live Atelier Privilege: <%= product.appliedOffer.name %>">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                </svg>
                                <span><%= product.appliedOffer.name %> • <%= product.appliedOffer.discountType === 'percentage' ? `${product.appliedOffer.discountValue}% OFF` : `₹${Number(product.appliedOffer.discountValue).toLocaleString('en-IN')} OFF` %></span>
                            </span>
                        <% } %>
                    </div>

                    <!-- Product Main Title -->
                    <h1 class="dt-product-title"><%= product.name %></h1>

                    <!-- Price & Monospace Serial/Edition Header -->
                    <div class="dt-price-serial-row">
                        <div class="dt-price-col">
                            <span class="dt-price-label">Atelier Price</span>
                            <div class="dt-price-val-wrap">
                                <span class="dt-price-val">₹<%= Number(product.effectivePrice).toLocaleString('en-IN') %></span>
                                <% if (product.hasDiscount && product.regularPrice > product.effectivePrice) { %>
                                    <span class="dt-price-orig">₹<%= Number(product.regularPrice).toLocaleString('en-IN') %></span>
                                    <span class="dt-discount-pill">-<%= product.discountPercent %>%</span>
                                <% } %>
                            </div>
                        </div>

                        <div class="dt-serial-col">
                            <span>SERIAL NO: RI-<%= (product._id.toString().slice(-6) || 'MNR-042').toUpperCase() %></span>
                            <span class="dt-edition-sub">EDITION: 042 / 300</span>
                        </div>
                    </div>

                    <!-- Live Privilege Offer Announcement Card -->
                    <% if (product.appliedOffer) { %>
                        <div class="dt-privilege-card">
                            <div class="dt-privilege-top">
                                <div class="dt-privilege-badge">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                    </svg>
                                    <span><%= product.appliedOffer.offerType === 'category' ? 'COLLECTION PRIVILEGE LIVE' : 'BESPOKE EDITION OFFER LIVE' %></span>
                                </div>
                                <span class="dt-privilege-rate">
                                    <%= product.appliedOffer.discountType === 'percentage' ? `${product.appliedOffer.discountValue}% OFF` : `₹${Number(product.appliedOffer.discountValue).toLocaleString('en-IN')} OFF` %>
                                </span>
                            </div>

                            <div class="dt-privilege-content">
                                <h3 class="dt-privilege-name"><%= product.appliedOffer.name %></h3>
                                <p class="dt-privilege-desc">
                                    <%= product.appliedOffer.description || (product.appliedOffer.offerType === 'category' ? 'Special collection-wide privilege automatically deducted from standard acquisition rate.' : 'Exclusive bespoke atelier incentive applied directly to this masterpiece edition.') %>
                                </p>
                            </div>

                            <div class="dt-privilege-footer">
                                <div class="dt-privilege-saving">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>Patron Savings: <strong>₹<%= Number(product.discountAmount).toLocaleString('en-IN') %></strong></span>
                                </div>
                                <% if (product.appliedOffer.endDate) { %>
                                    <div class="dt-privilege-expiry">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        <span>Privilege active until <%= new Date(product.appliedOffer.endDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% } else if (product.hasDiscount && product.regularPrice > product.effectivePrice) { %>
                        <div class="dt-privilege-card simple">
                            <div class="dt-privilege-footer" style="padding-top: 0; border-top: none;">
                                <div class="dt-privilege-saving">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>Special Atelier Rate: Save <strong>₹<%= Number(product.discountAmount).toLocaleString('en-IN') %></strong> (<%= product.discountPercent %>% reduction)</span>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Editorial Description Text -->
                    <p class="dt-description-text">
                        <%= product.description || 'Hand-chased sterling silver, adorned with royal motifs traced from 16th-century court archives. Each creation is sealed with a numbered atelier stamp — a quiet promise of provenance and a tribute to regal craftsmanship.' %>
                    </p>



                    <!-- Personalized Engraving Input with 0/10 Counter -->
                    <div class="dt-engraving-group">
                        <div class="dt-engraving-header">
                            <span class="dt-option-label">Personalized Engraving</span>
                            <span class="dt-counter-text"><span id="engravingCount">0</span>/10</span>
                        </div>
                        <input type="text" 
                               id="engravingInput" 
                               name="engraving" 
                               maxlength="10" 
                               class="dt-engraving-input" 
                               placeholder="Enter monogram or initials (optional)..." 
                               oninput="updateEngravingCounter(this)" />
                    </div>

                    <!-- Premium Gift Packaging Toggle Card -->
                    <div class="dt-packaging-card">
                        <div class="dt-packaging-info">
                            <span class="dt-packaging-title">Premium Gift Packaging</span>
                            <span class="dt-packaging-sub">Hand-stitched suede box with linen sleeve • +₹1,200</span>
                        </div>
                        <label class="dt-switch" aria-label="Toggle Premium Gift Packaging">
                            <input type="checkbox" id="giftPackagingToggle" />
                            <span class="dt-slider"></span>
                        </label>
                    </div>

                    <!-- Stock Status & Purchase Actions Form -->
                    <% 
                        const isOutOfStock = product.stock <= 0;
                        const maxStock = Math.min(5, Math.max(0, product.stock));
                    %>

                    <% if (isOutOfStock) { %>
                        <div style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 4px; padding: 14px 18px; margin-bottom: 24px; color: #f87171; font-size: 0.85rem; display: flex; align-items: center; gap: 8px;">
                            <span>●</span>
                            <span>Numbered Edition Sold Out — Archival Reservation Unavailable</span>
                        </div>
                    <% } %>

                    <form id="productPurchaseForm" action="/cart/add" method="POST">
                        <input type="hidden" name="productId" value="<%= product._id %>" />
                        <input type="hidden" name="engraving" id="hiddenEngravingInput" value="" />
                        <input type="hidden" name="giftPackaging" id="hiddenGiftPackagingInput" value="false" />

                        <div class="dt-action-row">
                            <!-- Quantity Stepper -->
                            <div class="dt-qty-stepper">
                                <button type="button" class="dt-qty-btn" id="btnMinus" onclick="stepQty(-1)" <%= isOutOfStock ? 'disabled' : '' %>>−</button>
                                <input type="number" 
                                       id="qtyInput" 
                                       name="quantity" 
                                       value="<%= isOutOfStock ? '0' : '1' %>" 
                                       min="1" 
                                       max="<%= isOutOfStock ? 0 : maxStock %>" 
                                       class="dt-qty-input" 
                                       readonly />
                                <button type="button" class="dt-qty-btn" id="btnPlus" onclick="stepQty(1)" <%= isOutOfStock ? 'disabled' : '' %>>+</button>
                            </div>

                            <!-- Add to Cart CTA -->
                            <button type="submit" 
                                    class="dt-btn-add-cart" 
                                    id="btnAddToCart" 
                                    <%= isOutOfStock ? 'disabled' : '' %>>
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                    <line x1="3" y1="6" x2="21" y2="6"></line>
                                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                                </svg>
                                <span><%= isOutOfStock ? 'Sold Out' : ((typeof isInCart !== 'undefined' && isInCart) ? 'Already in Cart' : 'Add to Cart') %></span>
                            </button>

                            <!-- Buy Now CTA -->
                            <button type="button" 
                                    class="dt-btn-buy-now" 
                                    id="btnBuyNow" 
                                    onclick="triggerBuyNow()" 
                                    <%= isOutOfStock ? 'disabled' : '' %>>
                                <span>Buy Now</span>
                            </button>

                            <!-- Wishlist Heart Button -->
                            <% const userHasInWishlist = (typeof isInWishlist !== 'undefined' && isInWishlist); %>
                            <button type="button" 
                                    class="dt-btn-wishlist <%= userHasInWishlist ? 'active' : '' %>" 
                                    id="btnWishlist" 
                                    data-product-id="<%= product._id %>"
                                    title="<%= userHasInWishlist ? 'Remove from Wishlist' : 'Add to Wishlist' %>" 
                                    onclick="toggleWishlist(event, '<%= product._id %>', this)">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="<%= userHasInWishlist ? '#E5A93C' : 'none' %>" stroke="<%= userHasInWishlist ? '#E5A93C' : 'currentColor' %>" stroke-width="1.8">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                            </button>
                        </div>
                    </form>

                    <!-- Trust Perks Row -->
                    <div class="dt-trust-perks-row">
                        <div class="dt-perk-item">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                <polyline points="9 12 11 14 15 10"></polyline>
                            </svg>
                            <span>Certificate of Authenticity</span>
                        </div>
                        <div class="dt-perk-item">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                            </svg>
                            <span>Atelier Serviced</span>
                        </div>
                        <div class="dt-perk-item">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="3" width="15" height="13"></rect>
                                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                <circle cx="18.5" cy="18.5" r="2.5"></circle>
                            </svg>
                            <span>Insured Shipping</span>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </main>

    <!-- 3. VOICES OF COLLECTORS (RATINGS & REVIEWS SECTION) -->
    <section class="dt-reviews-section" id="reviews-section">
        <div class="dt-container">
            <h2 class="dt-section-title-large">Voices of <br>Collectors</h2>

            <!-- Rating Breakdown & Write Review Toolbar -->
            <div class="dt-rating-breakdown-row">
                <div class="dt-rating-bars-wrap">
                    <div class="dt-rating-header-line">
                        <div class="dt-stars-gold">★★★★★</div>
                        <strong>4.9/5</strong>
                        <span style="color: var(--dt-text-muted);">Based on 326 reviews</span>
                    </div>

                    <!-- 5 Star Bar -->
                    <div class="dt-breakdown-bar-item">
                        <span>5</span>
                        <div class="dt-bar-track">
                            <div class="dt-bar-fill" style="width: 85%;"></div>
                        </div>
                        <span>85%</span>
                    </div>

                    <!-- 4 Star Bar -->
                    <div class="dt-breakdown-bar-item">
                        <span>4</span>
                        <div class="dt-bar-track">
                            <div class="dt-bar-fill" style="width: 10%;"></div>
                        </div>
                        <span>10%</span>
                    </div>

                    <!-- 3 Star Bar -->
                    <div class="dt-breakdown-bar-item">
                        <span>3</span>
                        <div class="dt-bar-track">
                            <div class="dt-bar-fill" style="width: 3%;"></div>
                        </div>
                        <span>3%</span>
                    </div>

                    <!-- 2 Star Bar -->
                    <div class="dt-breakdown-bar-item">
                        <span>2</span>
                        <div class="dt-bar-track">
                            <div class="dt-bar-fill" style="width: 1%;"></div>
                        </div>
                        <span>1%</span>
                    </div>

                    <!-- 1 Star Bar -->
                    <div class="dt-breakdown-bar-item">
                        <span>1</span>
                        <div class="dt-bar-track">
                            <div class="dt-bar-fill" style="width: 1%;"></div>
                        </div>
                        <span>1%</span>
                    </div>
                </div>

                <div>
                    <button type="button" class="dt-btn-write-review" onclick="openReviewModal()">Write a Review</button>
                </div>
            </div>

            <!-- Reviews 3-Column Grid -->
            <div class="dt-reviews-grid">
                
                <!-- Review Card 1 -->
                <div class="dt-review-card">
                    <div>
                        <div class="dt-reviewer-header">
                            <div class="dt-reviewer-user">
                                <div class="dt-reviewer-avatar">A</div>
                                <div class="dt-reviewer-meta">
                                    <span class="dt-reviewer-name">Alexander M.</span>
                                    <span class="dt-verified-badge">✓ Verified Purchase</span>
                                </div>
                            </div>
                            <span class="dt-review-date">Oct 12, 2025</span>
                        </div>

                        <div class="dt-review-stars">★★★★★</div>
                        <span class="dt-review-finish-tag">Finish: Sterling Silver</span>
                        <h3 class="dt-review-title">Exceptional Craftsmanship</h3>
                        <p class="dt-review-body">
                            The weight and balance of The Monarch are truly unparalleled. The hand-chased silver details catch the light beautifully, making it not just a tool, but a true heirloom.
                        </p>
                    </div>

                    <button type="button" class="dt-helpful-btn" onclick="incHelpful(this)">
