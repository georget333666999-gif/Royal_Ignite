    </section>

    <!-- Fullscreen Atelier Lightbox Modal -->
    <div id="atelierLightbox" class="dt-lightbox-modal" aria-hidden="true" role="dialog">
        <div class="dt-lightbox-backdrop" onclick="closeLightbox()"></div>
        <div class="dt-lightbox-container">
            <div class="dt-lightbox-header">
                <div class="dt-lightbox-title-group">
                    <span class="dt-lightbox-kicker">ATELIER ARCHIVE INSPECTION</span>
                    <h3 class="dt-lightbox-title"><%= product.name %> — <span id="lightboxAngleLabel"><%= angleLabels[0] %></span></h3>
                </div>
                <button type="button" class="dt-lightbox-close-btn" onclick="closeLightbox()" title="Close (Esc)">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            
            <div class="dt-lightbox-view" id="lightboxView">
                <img id="lightboxImg" src="<%= galleryImages[0] %>" alt="<%= product.name %>" />
            </div>

            <% if (galleryImages.length > 1) { %>
            <div class="dt-lightbox-footer">
                <div class="dt-lightbox-thumbnails">
                    <% galleryImages.forEach(function(imgSrc, idx) { 
                        const angleLabel = angleLabels[idx] || `Angle 0${idx + 1}`;
                    %>
                        <button type="button" 
                                class="dt-lightbox-thumb <%= idx === 0 ? 'active' : '' %>" 
                                onclick="switchLightboxAngle('<%= imgSrc %>', '<%= angleLabel %>', this)">
                            <img src="<%= imgSrc %>" alt="<%= angleLabel %>" />
                            <span><%= angleLabel %></span>
                        </button>
                    <% }); %>
                </div>
            </div>
            <% } %>
        </div>
    </div>

    <!-- 5. FOOTER (EXACT MATCH TO MAISON MOCKUP) -->
    <%- include('./partials/footer.ejs') %>

    <!-- 6. CLIENT JAVASCRIPT: INNER CURSOR ZOOM, LIGHTBOX, THUMBNAILS, AND PURCHASE -->
    <script>
        window.switchGalleryAngle = function(btn) {
            if (!btn) return;
            const thumbs = document.querySelectorAll(".dt-thumbnail-btn");
            thumbs.forEach(t => t.classList.remove("active"));
            btn.classList.add("active");

            const newSrc = btn.getAttribute("data-img");
            const newIdx = btn.getAttribute("data-index");
            const newLabel = btn.getAttribute("data-label");

            const activeImg = document.getElementById("activeProductImage");
            if (newSrc && activeImg) {
                activeImg.src = newSrc;
            }
            const lightboxImg = document.getElementById("lightboxImg");
            if (newSrc && lightboxImg) {
                lightboxImg.src = newSrc;
            }
            const currentIndexEl = document.getElementById("currentImgIndex");
            if (newIdx && currentIndexEl) {
                currentIndexEl.textContent = newIdx;
            }
            const activeAngleText = document.getElementById("activeAngleText");
            if (activeAngleText && newLabel) {
                activeAngleText.textContent = newLabel;
            }
            const lightboxAngleLabel = document.getElementById("lightboxAngleLabel");
            if (lightboxAngleLabel && newLabel) {
                lightboxAngleLabel.textContent = newLabel;
            }
        };

        document.addEventListener("DOMContentLoaded", () => {
            // 1. Vertical Thumbnail Switcher & Indicator Counter
            const thumbs = document.querySelectorAll(".dt-thumbnail-btn");
            const activeImg = document.getElementById("activeProductImage");
            const currentIndexEl = document.getElementById("currentImgIndex");
            const lightboxImg = document.getElementById("lightboxImg");
            const lightboxAngleLabel = document.getElementById("lightboxAngleLabel");

            thumbs.forEach(thumb => {
                thumb.addEventListener("click", () => {
                    thumbs.forEach(t => t.classList.remove("active"));
                    thumb.classList.add("active");

                    const newSrc = thumb.getAttribute("data-img");
                    const newIdx = thumb.getAttribute("data-index");
                    const newLabel = thumb.getAttribute("data-label");

                    if (newSrc && activeImg) {
                        activeImg.src = newSrc;
                    }
                    if (newSrc && lightboxImg) {
                        lightboxImg.src = newSrc;
                    }
                    if (newIdx && currentIndexEl) {
                        currentIndexEl.textContent = newIdx;
                    }

                    const activeAngleText = document.getElementById("activeAngleText");
                    if (activeAngleText && newLabel) {
                        activeAngleText.textContent = newLabel;
                    }
                    if (lightboxAngleLabel && newLabel) {
                        lightboxAngleLabel.textContent = newLabel;
                    }

                    // Synchronize lightbox thumbnail active state
                    document.querySelectorAll(".dt-lightbox-thumb").forEach(lt => {
                        const thumbImg = lt.querySelector("img");
                        if (thumbImg && thumbImg.src) {
                            lt.classList.toggle("active", thumbImg.getAttribute("src") === newSrc);
                        }
                    });
                });
            });

            // 2. High-Precision Inner Magnifier Zoom & Pan
            const display = document.getElementById("mainDisplay");
            const zoomCueText = document.getElementById("zoomCueText");

            if (display && activeImg) {
                let isZooming = false;
                const zoomFactor = 2.4;

                display.addEventListener("mouseenter", () => {
                    isZooming = true;
                    display.classList.add("is-zoomed");
                    activeImg.style.transform = `scale(${zoomFactor})`;
                    if (zoomCueText) zoomCueText.textContent = "2.4× Zoomed";
                });

                display.addEventListener("mousemove", (e) => {
                    if (!isZooming) return;
                    const rect = display.getBoundingClientRect();
                    const x = ((e.clientX - rect.left) / rect.width) * 100;
                    const y = ((e.clientY - rect.top) / rect.height) * 100;
                    activeImg.style.transformOrigin = `${x.toFixed(2)}% ${y.toFixed(2)}%`;
                });

                display.addEventListener("mouseleave", () => {
                    isZooming = false;
                    display.classList.remove("is-zoomed");
                    activeImg.style.transformOrigin = "center center";
                    activeImg.style.transform = "scale(1)";
                    if (zoomCueText) zoomCueText.textContent = "Hover to Zoom";
                });

                // Click to open fullscreen Lightbox inspection
                display.addEventListener("click", () => {
                    openLightbox();
                });
            }
        });

        // Fullscreen Lightbox Modal Controls
        function openLightbox() {
            const modal = document.getElementById("atelierLightbox");
            const activeImg = document.getElementById("activeProductImage");
            const lightboxImg = document.getElementById("lightboxImg");
            if (modal) {
                if (activeImg && lightboxImg) {
                    lightboxImg.src = activeImg.src;
                }
                modal.classList.add("active");
                modal.setAttribute("aria-hidden", "false");
                document.body.style.overflow = "hidden";
            }
        }

        function closeLightbox() {
            const modal = document.getElementById("atelierLightbox");
            if (modal) {
                modal.classList.remove("active");
                modal.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
            }
        }

        function switchLightboxAngle(src, label, btn) {
            const lightboxImg = document.getElementById("lightboxImg");
            const lightboxAngleLabel = document.getElementById("lightboxAngleLabel");
            if (lightboxImg) lightboxImg.src = src;
            if (lightboxAngleLabel) lightboxAngleLabel.textContent = label;

            document.querySelectorAll(".dt-lightbox-thumb").forEach(b => b.classList.remove("active"));
            if (btn) btn.classList.add("active");

            // Also synchronize main page active thumbnail and image
            const thumbs = document.querySelectorAll(".dt-thumbnail-btn");
            thumbs.forEach(t => {
                const match = t.getAttribute("data-img") === src;
                t.classList.toggle("active", match);
                if (match) {
                    const activeImg = document.getElementById("activeProductImage");
                    if (activeImg) activeImg.src = src;
                    const activeAngleText = document.getElementById("activeAngleText");
                    if (activeAngleText) activeAngleText.textContent = label;
                    const idx = t.getAttribute("data-index");
                    const currentIndexEl = document.getElementById("currentImgIndex");
                    if (currentIndexEl && idx) currentIndexEl.textContent = idx;
                }
            });
        }

        // Close Lightbox on Escape key
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                closeLightbox();
            }
        });



        // 4. Personalized Engraving Character Counter
        function updateEngravingCounter(input) {
            const countEl = document.getElementById("engravingCount");
            if (countEl) countEl.textContent = input.value.length;

            const hiddenInput = document.getElementById("hiddenEngravingInput");
            if (hiddenInput) hiddenInput.value = input.value;
        }

        // 5. Quantity Stepper
        const maxStock = <%= isOutOfStock ? 0 : maxStock %>;
        function stepQty(delta) {
            const input = document.getElementById("qtyInput");
            if (!input || maxStock <= 0) return;

            let val = parseInt(input.value, 10) || 1;
            val += delta;

            if (val < 1) val = 1;
            if (val > maxStock) val = maxStock;

            input.value = val;

            const minusBtn = document.getElementById("btnMinus");
            const plusBtn = document.getElementById("btnPlus");
            if (minusBtn) minusBtn.disabled = (val <= 1);
            if (plusBtn) plusBtn.disabled = (val >= maxStock);
        }

        // 6. Buy Now Handler (Direct Checkout without touching Cart)
        async function triggerBuyNow() {
            const btn = document.getElementById("btnBuyNow");
            const originalHtml = btn ? btn.innerHTML : "";
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<span>Processing...</span>`;
            }

            const qtyInput = document.getElementById("productQuantityInput");
            const qty = qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1;
            const productId = "<%= product._id %>";

            try {
                const response = await fetch("/checkout/buy-now", {
                    method: "POST",
                    headers: {
                        "Accept": "application/json",
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ productId, quantity: qty })
                });

                const data = await response.json();
                if (data.redirect) {
                    window.location.href = data.redirect;
                } else if (data.success) {
                    window.location.href = "/checkout?buyNow=1";
                } else {
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                    }
                    Swal.fire({
                        icon: "error",
                        title: "Notice",
                        text: data.message || "Could not proceed with instant acquisition.",
                        background: "#141312",
                        color: "#f0ece6",
                        confirmButtonColor: "#F6BD64"
                    });
                }
            } catch (err) {
                console.error("Buy Now error:", err);
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
                Swal.fire({
                    icon: "error",
                    title: "Notice",
                    text: "An error occurred while connecting to the atelier.",
                    background: "#141312",
                    color: "#f0ece6",
                    confirmButtonColor: "#F6BD64"
                });
            }
        }

        // 6b. Add to Cart AJAX Form Submission (Quiet Luxury In-Page Feedback)
        const productForm = document.getElementById("productPurchaseForm");
        if (productForm) {
            productForm.addEventListener("submit", async function(e) {
                e.preventDefault();

                // Synchronize gift packaging and engraving state
                const toggle = document.getElementById("giftPackagingToggle");
                const giftInput = document.getElementById("hiddenGiftPackagingInput");
                if (toggle && giftInput) {
                    giftInput.value = toggle.checked ? "true" : "false";
                }

                const btn = document.getElementById("btnAddToCart");
                const originalHtml = btn ? btn.innerHTML : "";

                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = `
                        <svg class="dt-spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="9" stroke-dasharray="28" stroke-dashoffset="10"></circle>
                        </svg>
                        <span>Adding to Bag...</span>
                    `;
                }

                try {
                    const productId = productForm.querySelector('input[name="productId"]')?.value;
                    const qtyInput = document.getElementById("qtyInput");
                    const quantity = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;
                    const engraving = document.getElementById("hiddenEngravingInput")?.value || "";
                    const giftPackaging = document.getElementById("hiddenGiftPackagingInput")?.value || "false";

                    const response = await fetch("/cart/add", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "Accept": "application/json"
                        },
                        body: JSON.stringify({
                            productId,
                            quantity,
                            engraving,
                            giftPackaging
                        })
                    });

                    const data = await response.json();

                    if (response.status === 401 || data.redirect) {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                title: 'Sign In Required',
                                text: data.message || 'Please sign in to add pieces to your atelier bag.',
                                icon: 'info',
                                iconColor: '#E5A93C',
                                showCancelButton: true,
                                confirmButtonText: 'Sign In',
                                cancelButtonText: 'Continue Browsing',
                                customClass: {
                                    popup: 'royal-luxury-swal',
                                    title: 'royal-swal-title',
                                    confirmButton: 'royal-swal-confirm-btn',
                                    cancelButton: 'royal-swal-cancel-btn'
                                }
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    window.location.href = data.redirect || `/user/login?redirect=/products/${productId}`;
                                }
                            });
                        } else {
                            window.location.href = data.redirect || `/user/login?redirect=/products/${productId}`;
                        }
                        return;
                    }

                    if (!response.ok || !data.success) {
                        if (typeof Swal !== 'undefined') {
                            if (data.alreadyInCart) {
                                Swal.fire({
                                    icon: 'info',
                                    title: 'Already in Bag',
                                    text: data.message || 'Already added to cart',
                                    showCancelButton: true,
                                    confirmButtonText: 'View Bag',
                                    cancelButtonText: 'Continue Browsing',
                                    confirmButtonColor: '#E5A93C',
                                    cancelButtonColor: 'rgba(255,255,255,0.15)',
                                    background: '#141312',
                                    color: '#eae6df',
                                    customClass: {
                                        popup: 'royal-luxury-swal',
                                        title: 'royal-swal-title',
                                        confirmButton: 'royal-swal-confirm-btn',
                                        cancelButton: 'royal-swal-cancel-btn'
                                    }
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        window.location.href = '/cart';
                                    }
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Cannot Add to Bag',
                                    text: data.message || 'Could not add this piece to your atelier bag.',
                                    background: '#141312',
                                    color: '#eae6df',
                                    confirmButtonColor: '#E5A93C',
                                    customClass: {
                                        popup: 'royal-luxury-swal',
                                        title: 'royal-swal-title',
                                        confirmButton: 'royal-swal-confirm-btn'
                                    }
                                });
                            }
                        } else {
                            alert(data.message || 'Already added to cart');
                        }
                        if (btn) {
                            btn.disabled = false;
                            if (data.alreadyInCart) {
                                btn.innerHTML = `
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E5A93C" stroke-width="2">
                                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                        <line x1="3" y1="6" x2="21" y2="6"></line>
                                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                                    </svg>
                                    <span>Already in Cart</span>
                                `;
                            } else {
                                btn.innerHTML = originalHtml;
                            }
                        }
                        return;
                    }

                    // Determine item count from response
                    const cartItemCount = (data.cart && typeof data.cart.itemCount !== 'undefined')
                        ? data.cart.itemCount
                        : (typeof data.count !== 'undefined' ? data.count : null);

                    // Update header shopping bag badges
                    if (cartItemCount !== null) {
                        const headerCartBadges = document.querySelectorAll('.cart-badge-count');
                        headerCartBadges.forEach(function (badge) {
                            if (cartItemCount > 0) {
                                badge.textContent = cartItemCount;
                                badge.style.display = 'inline-block';
                                badge.classList.remove('badge-pop');
                                void badge.offsetWidth;
                                badge.classList.add('badge-pop');
                            } else {
                                badge.style.display = 'none';
                            }
                        });
                    }

                    // Update wishlist badges if returned (item removed from wishlist upon cart add)
                    if (typeof data.wishlistCount !== 'undefined') {
                        const headerWishlistBadges = document.querySelectorAll('.wishlist-badge-count');
                        headerWishlistBadges.forEach(function (badge) {
                            if (data.wishlistCount > 0) {
                                badge.textContent = data.wishlistCount;
                                badge.style.display = 'inline-block';
                            } else {
                                badge.style.display = 'none';
                            }
                        });
                        const wishlistHeartBtn = document.getElementById("btnWishlist");
                        if (wishlistHeartBtn) {
                            wishlistHeartBtn.classList.remove("active");
                            wishlistHeartBtn.setAttribute("data-in-wishlist", "false");
                            const targetPath = wishlistHeartBtn.querySelector("svg path");
                            if (targetPath) {
                                targetPath.setAttribute("fill", "none");
                                targetPath.setAttribute("stroke", "currentColor");
                                targetPath.style.fill = "none";
                                targetPath.style.stroke = "currentColor";
                            }
                        }
                    }

                    // Success visual feedback on Add to Cart button
                    if (btn) {
                        btn.innerHTML = `
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span style="color: #22c55e;">Added to Bag ${cartItemCount ? `(${cartItemCount})` : ''}</span>
                        `;
                    }

                    // Subtle micro-interaction on the header shopping bag icon
                    const headerCartIcon = document.querySelector('header a[href="/cart"]');
                    if (headerCartIcon) {
                        headerCartIcon.classList.remove("cart-pulse-active");
                        void headerCartIcon.offsetWidth;
                        headerCartIcon.classList.add("cart-pulse-active");
                    }

                    // Quiet Luxury success toast notification on product details page displaying item count
                    if (typeof Swal !== 'undefined') {
                        const countText = cartItemCount 
                            ? `${cartItemCount} ${cartItemCount === 1 ? 'item' : 'items'} in your bag` 
                            : '';
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: data.message || 'Creation added to your atelier bag successfully.',
                            text: countText,
                            showConfirmButton: false,
                            timer: 3500,
                            timerProgressBar: true,
                            background: '#141312',
                            color: '#eae6df',
                            iconColor: '#E5A93C',
                            customClass: {
                                popup: 'royal-swal-toast'
                            }
                        });
                    }

                    setTimeout(() => {
                        if (btn) {
                            btn.disabled = false;
                            btn.innerHTML = `
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E5A93C" stroke-width="2">
                                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                    <line x1="3" y1="6" x2="21" y2="6"></line>
                                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                                </svg>
                                <span>Already in Cart</span>
                            `;
                        }
                    }, 2200);

                } catch (err) {
                    console.error("Cart add error:", err);
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Notice',
                            text: 'An error occurred while adding to your bag. Please try again.',
                            background: '#141312',
                            color: '#eae6df',
                            confirmButtonColor: '#E5A93C'
                        });
                    } else {
                        alert('An error occurred while adding to your bag. Please try again.');
                    }
                } finally {
                    if (btn && btn.disabled && !btn.innerHTML.includes("Added to Bag")) {
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                    }
                }
            });
        }

        // Flash message toast notification on page load
        <% if (typeof success !== 'undefined' && success) { %>
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: '<%= success %>',
                    showConfirmButton: false,
                    timer: 3500,
                    timerProgressBar: true,
                    background: '#141312',
                    color: '#eae6df',
                    iconColor: '#E5A93C',
                    customClass: {
                        popup: 'royal-swal-toast'
                    }
                });
            }
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: '<%= error %>',
                    showConfirmButton: false,
                    timer: 3500,
                    timerProgressBar: true,
                    background: '#141312',
                    color: '#eae6df',
                    iconColor: '#ef4444',
                    customClass: {
                        popup: 'royal-swal-toast'
                    }
                });
            }
        <% } %>

        let isWishlistBusy = false;

        async function toggleWishlist(arg1, arg2, arg3) {
            let event = null;
            let productId = null;
            let btn = null;

            if (arg1 && typeof arg1 === 'object' && typeof arg1.preventDefault === 'function') {
                event = arg1;
                productId = arg2;
                btn = arg3;
            } else {
                productId = arg1;
                btn = arg2;
            }

            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            if (isWishlistBusy) return;

            if (!btn) {
                if (event && event.currentTarget) {
                    btn = event.currentTarget.closest(".dt-btn-wishlist") || event.currentTarget;
                } else {
                    btn = document.getElementById("btnWishlist");
                }
            }

            if (!productId) {
                productId = (btn && btn.dataset && btn.dataset.productId) 
                    ? btn.dataset.productId 
                    : "<%= product._id %>";
            }

            const svg = btn ? btn.querySelector("svg") : null;
            const path = svg ? svg.querySelector("path") : null;

            isWishlistBusy = true;
            if (btn) btn.style.opacity = "0.6";

            try {
                const response = await fetch('/wishlist/toggle', {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ productId })
                });

                const data = await response.json();

                if (response.status === 401 || data.redirect) {
                    const loginUrl = data.redirect || `/user/login?redirect=/products/${productId}`;
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'info',
                            title: 'Sign In Required',
                            text: 'Please sign in to save pieces to your wishlist vault.',
                            background: '#141312',
                            color: '#eae6df',
                            confirmButtonColor: '#E5A93C',
                            confirmButtonText: 'Sign In',
                            showCancelButton: true,
                            cancelButtonText: 'Stay on Page',
                            customClass: {
                                popup: 'royal-luxury-swal',
                                title: 'royal-swal-title',
                                confirmButton: 'royal-swal-confirm-btn',
                                cancelButton: 'royal-swal-cancel-btn'
                            }
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = loginUrl;
                            }
                        });
                    } else {
                        window.location.href = loginUrl;
                    }
                    return;
                }

                if (data.success) {
                    const matchingButtons = document.querySelectorAll(`[data-product-id="${productId}"]`);
                    matchingButtons.forEach(targetBtn => {
                        const targetSvg = targetBtn.querySelector("svg");
                        const targetPath = targetSvg ? targetSvg.querySelector("path") : null;
                        if (data.inWishlist) {
                            targetBtn.classList.add("active");
                            targetBtn.setAttribute("title", "Remove from Wishlist");
                            if (targetSvg) {
                                targetSvg.setAttribute("fill", "#E5A93C");
                                targetSvg.setAttribute("stroke", "#E5A93C");
                                targetSvg.style.fill = "#E5A93C";
                                targetSvg.style.stroke = "#E5A93C";
                            }
                            if (targetPath) {
                                targetPath.setAttribute("fill", "#E5A93C");
                                targetPath.setAttribute("stroke", "#E5A93C");
                                targetPath.style.fill = "#E5A93C";
                                targetPath.style.stroke = "#E5A93C";
                            }
                        } else {
                            targetBtn.classList.remove("active");
                            targetBtn.setAttribute("title", "Add to Wishlist");
                            if (targetSvg) {
                                targetSvg.setAttribute("fill", "none");
                                targetSvg.setAttribute("stroke", "currentColor");
                                targetSvg.style.fill = "none";
                                targetSvg.style.stroke = "currentColor";
                            }
                            if (targetPath) {
                                targetPath.setAttribute("fill", "none");
                                targetPath.setAttribute("stroke", "currentColor");
                                targetPath.style.fill = "none";
                                targetPath.style.stroke = "currentColor";
                            }
                        }
                    });

                    // Synchronize header wishlist badges across desktop and mobile headers
                    const headerBadges = document.querySelectorAll('.wishlist-badge-count');
                    headerBadges.forEach(function (badge) {
                        if (data.count > 0) {
                            badge.textContent = data.count;
                            badge.style.display = 'inline-block';
                        } else {
                            badge.style.display = 'none';
                        }
                    });

                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: data.message || (data.inWishlist ? 'Piece added to your wishlist.' : 'Piece removed from your wishlist.'),
                            showConfirmButton: false,
                            timer: 2400,
                            timerProgressBar: true,
                            background: '#141312',
                            color: '#eae6df',
                            iconColor: '#E5A93C',
                            customClass: {
                                popup: 'royal-swal-toast'
                            }
                        });
                    }
                } else {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Notice',
                            text: data.message || 'Unable to update wishlist.',
                            background: '#141312',
                            color: '#eae6df',
                            confirmButtonColor: '#E5A93C',
                            customClass: {
                                popup: 'royal-luxury-swal',
                                title: 'royal-swal-title',
                                confirmButton: 'royal-swal-confirm-btn'
                            }
                        });
                    } else {
                        alert(data.message || 'Unable to update wishlist.');
                    }
                }
            } catch (err) {
                console.error("Wishlist toggle error:", err);
            } finally {
                const matchingButtons = document.querySelectorAll(`[data-product-id="${productId}"]`);
                matchingButtons.forEach(b => { b.style.opacity = "1"; });
                if (btn) btn.style.opacity = "1";
                isWishlistBusy = false;
            }
        }

        // 8. Helpful Counter Increment
        function incHelpful(btn) {
            if (!btn || btn.dataset.voted) return;
            const countSpan = btn.querySelector(".helpful-count");
            if (countSpan) {
                let current = parseInt(countSpan.textContent, 10) || 0;
                countSpan.textContent = current + 1;
                btn.style.color = "var(--dt-gold)";
                btn.dataset.voted = "true";
            }
        }

        // 9. Write Review Placeholder
        function openReviewModal() {
            alert("Thank you for sharing your experience. The Connoisseur Review submission portal will open for verified atelier owners.");
        }
    </script>

</body>
</html>
