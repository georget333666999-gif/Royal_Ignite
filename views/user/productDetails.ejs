                                        onclick="toggleWishlist(event, '<%= item.id %>', this)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="<%= isItemWishlisted ? '#E5A93C' : 'none' %>" stroke="<%= isItemWishlisted ? '#E5A93C' : 'currentColor' %>" stroke-width="1.8">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                    </svg>
                                </button>
                            <% } %>

                            <a href="<%= item.link %>">
                                <img src="<%= item.img %>" alt="<%= item.name %>" class="dt-curated-img" loading="lazy" onerror="this.src='/uploads/monarch_lighter.png';" />
                            </a>
                        </div>

                        <div class="dt-curated-card-body">
                            <span class="dt-curated-cat-tag"><%= item.catTag %></span>
                            <h3 class="dt-curated-card-title">
                                <a href="<%= item.link %>"><%= item.name %></a>
                            </h3>
                            <p class="dt-curated-card-desc"><%= item.desc %></p>
