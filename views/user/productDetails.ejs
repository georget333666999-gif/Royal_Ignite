    <!-- 4. CURATED FOR YOU (COMPANION EDITIONS) -->
    <section class="dt-curated-section">
        <div class="dt-container">
            <div class="dt-curated-header">
                <h2 class="dt-curated-title">Curated For You</h2>
                <p class="dt-curated-desc">
                    Hand-selected masterpieces from the Royal Ignite collection, designed to complement the discerning taste of a true collector.
                </p>
            </div>

            <div class="dt-curated-grid">
                
                <%
                    // Define fallback curated masterpieces exactly matching the user's mockup
                    const defaultCurated = [
                        {
                            id: 'nightfall',
                            badge: 'BESTSELLER',
                            catTag: 'THE OBSIDIAN COLLECTION',
                            name: 'Nightfall',
                            desc: 'Matte black titanium with polished 18k gold accents.',
                            img: '/uploads/hero_lighter.png',
                            link: '/products'
                        },
                        {
                            id: 'lepoque',
                            badge: null,
                            catTag: 'THE HERITAGE LINE',
                            name: "L'Époque",
                            desc: 'Solid brass with intricate guilloché engraving.',
                            img: '/uploads/fuel/heritage_1924.jpg',
                            link: '/products'
                        },
                        {
                            id: 'vanguard',
                            badge: 'Royal Ignite | Voices & Curated',
                            catTag: 'ELECTRIC EDITIONS',
                            name: 'Vanguard',
                            desc: 'Dual-arc plasma ignition in brushed gunmetal.',
                            img: '/uploads/electric/aether_lighter.jpg',
                            link: '/products'
                        },
                        {
                            id: 'crimson_ember',
                            badge: 'LIMITED',
                            catTag: 'THE ROSE GOLD EDITION',
                            name: 'Crimson Ember',
                            desc: 'Rose gold chassis with carbon fiber inlay details.',
                            img: '/uploads/monarch_lighter.png',
                            link: '/products'
                        }
                    ];

                    // Merge dynamic relatedProducts if provided by backend
                    const curatedList = (Array.isArray(relatedProducts) && relatedProducts.length > 0)
                        ? relatedProducts.map((rel, i) => ({
                            id: rel._id,
                            badge: i === 0 ? 'BESTSELLER' : (i === 3 ? 'LIMITED' : (i === 2 ? 'Royal Ignite | Voices & Curated' : null)),
                            catTag: rel.category ? `THE ${rel.category.name.toUpperCase()} LINE` : defaultCurated[i % 4].catTag,
                            name: rel.name,
                            desc: rel.description || defaultCurated[i % 4].desc,
                            img: (rel.images && rel.images[0]) || defaultCurated[i % 4].img,
                            link: `/products/${rel._id}`
                        }))
                        : defaultCurated;

                    // Pad up to 4 if needed
                    while (curatedList.length < 4) {
                        curatedList.push(defaultCurated[curatedList.length]);
                    }
                %>

                <% curatedList.slice(0, 4).forEach(function(item) { 
                    const isValidId = item.id && /^[0-9a-fA-F]{24}$/.test(String(item.id));
                    const isItemWishlisted = isValidId && (typeof userWishlistIds !== 'undefined' && Array.isArray(userWishlistIds) && userWishlistIds.includes(String(item.id)));
                %>
                    <article class="dt-curated-card">
