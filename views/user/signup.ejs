<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Your Account - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/user/auth.css" />
</head>

<body class="auth-page">

    <%- include('partials/header', { hideNav: true }) %>

    <main class="auth-wrapper">
        <div class="gold-card signup-card">
            
            <!-- Brand Emblem & Identity -->
            <div class="card-brand-header">
                <div class="brand-emblem-badge" title="Royal Ignite">
                    <svg class="emblem-flame-icon" viewBox="0 0 24 24" width="20" height="20">
                        <defs>
                            <linearGradient id="flameGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" stop-color="#fbc275" />
                                <stop offset="100%" stop-color="#d48833" />
                            </linearGradient>
                        </defs>
                        <path fill="url(#flameGrad)" d="M12 2.5C11.2 5.8 8.5 8.3 8.5 11.8C8.5 14.2 9.9 16.1 11.2 17C10.7 15.3 11.3 13.8 12.3 12.7C13.2 14.2 14.8 15.4 14.8 17.5C14.8 19.4 13.5 21 12 21.8C16.8 21.2 19.5 17.2 19.5 13.2C19.5 7.8 14.2 4.8 12 2.5Z"/>
                    </svg>
                </div>
                <div class="card-brand-name">ROYAL IGNITE</div>
                <div class="card-brand-divider"></div>
            </div>

            <h1 class="auth-title">Create Your Account</h1>
            <p class="auth-subtitle">
                Join our private collection and enjoy a more personalized experience.
            </p>

            <% if (error) { %>
                <div class="error-badge"><%= error %></div>
            <% } %>

            <form action="/user/signup" method="POST" id="signupForm" novalidate>
                
                <div class="form-group">
                    <label for="name">FULL NAME</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="form-input"
                        placeholder="Enter your full name"
                        value="<%= formData.name || '' %>"
                        data-validate="name"
                        required
                    />
                </div>

                <div class="form-group">
                    <label for="email">EMAIL ADDRESS</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-input"
                        placeholder="Enter your email address"
                        value="<%= formData.email || '' %>"
                        data-validate="email"
                        required
                    />
                </div>

                <div class="form-group">
                    <label for="phone">PHONE NUMBER</label>
                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        class="form-input"
                        placeholder="Enter your 10-digit mobile number"
                        maxlength="10"
                        value="<%= formData.phone || '' %>"
                        data-validate="phone"
                        required
                    />
                </div>

                <div class="form-group">
                    <label for="password">PASSWORD</label>
                    <div class="password-wrap">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-input"
                            placeholder="Minimum 8 characters (letters & numbers)"
                            data-validate="password"
                            required
                        />
                    </div>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">CONFIRM PASSWORD</label>
                    <div class="password-wrap">
                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            class="form-input"
                            placeholder="Re-enter your password"
                            data-validate="confirmPassword"
                            required
                        />
                    </div>
                </div>

                <!-- Collapsible Referral Section matching the mockup -->
                <div class="referral-accordion">
                    <button type="button" class="referral-toggle-btn" id="referralToggle" aria-expanded="false">
                        <span>Have a referral code?</span>
                        <svg class="referral-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                    <div class="referral-content <%= formData.referralCode ? 'is-open' : '' %>" id="referralContent">
                        <div class="form-group referral-input-group">
                            <input
                                type="text"
                                id="referralCode"
                                name="referralCode"
                                class="form-input"
                                placeholder="Enter referral code"
                                value="<%= formData.referralCode || '' %>"
                            />
                        </div>
                    </div>
                </div>

                <button type="submit" class="primary-btn">
                    CREATE ACCOUNT
                </button>

            </form>

            <div class="auth-switch">
                Already have an account? <a href="/user/login">Sign In</a>
            </div>

            <div class="divider-container">
                <div class="divider-line"></div>
                <span class="divider-text">OR CONTINUE WITH</span>
                <div class="divider-line"></div>
            </div>

            <a href="/auth/google" class="google-btn">
                <svg width="18" height="18" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                </svg>
                Sign up with Google
            </a>

            <div class="terms-notice">
                By creating an account, you agree to our <a href="#">Terms</a> & <a href="#">Privacy Policy</a>.
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/validation.js"></script>
    <script>
        // Interactive referral code accordion toggle
        const refToggle = document.getElementById('referralToggle');
        const refContent = document.getElementById('referralContent');
        if (refToggle && refContent) {
            refToggle.addEventListener('click', () => {
                const isOpen = refContent.classList.toggle('is-open');
                refToggle.classList.toggle('active', isOpen);
                refToggle.setAttribute('aria-expanded', isOpen);
                if (isOpen) {
                    const input = refContent.querySelector('input');
                    if (input) input.focus();
                }
            });
            if (refContent.classList.contains('is-open')) {
                refToggle.classList.add('active');
                refToggle.setAttribute('aria-expanded', 'true');
            }
        }
    </script>

</body>

</html>