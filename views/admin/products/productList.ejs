<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Product Management - ROYAL IGNITE Admin</title>
    <link rel="stylesheet" href="/css/admin/productList.css" />
    <!-- SweetAlert2 for Quiet Luxury Confirmations & Alerts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .royal-luxury-swal {
            background: #141312 !important;
            border: 1px solid rgba(212, 136, 51, 0.28) !important;
            border-radius: 16px !important;
            padding: 26px 22px !important;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75) !important;
            color: #f0ece6 !important;
            font-family: 'Instrument Sans', sans-serif !important;
        }
        .royal-swal-title {
            font-family: 'DM Serif Display', serif !important;
            color: #ffffff !important;
            font-size: 22px !important;
            letter-spacing: 0.3px !important;
            margin-bottom: 8px !important;
        }
        .royal-swal-confirm-btn {
            border-radius: 8px !important;
            font-weight: 600 !important;
            font-size: 13px !important;
            letter-spacing: 0.4px !important;
            padding: 10px 22px !important;
            box-shadow: none !important;
            cursor: pointer !important;
        }
        .royal-swal-cancel-btn {
            border-radius: 8px !important;
            font-weight: 500 !important;
            font-size: 13px !important;
            letter-spacing: 0.4px !important;
            padding: 10px 20px !important;
            background: #27272a !important;
            color: #d4d4d8 !important;
            box-shadow: none !important;
            cursor: pointer !important;
        }
        .royal-swal-cancel-btn:hover {
            background: #3f3f46 !important;
            color: #ffffff !important;
        }
    </style>
</head>

<body>

    <!-- Left Sidebar Navigation -->
    <%- include('../partials/sidebar', { activePage: 'products' }) %>

    <!-- Main Wrapper Area -->
    <div class="main-wrapper">
        
        <!-- Top Navbar Header -->
        <header class="top-navbar">
            <h1 class="top-navbar-title">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                </svg>
                Product Management
            </h1>
            <div class="top-navbar-right">
                <div class="avatar-circle">A</div>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="content-padding">

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-box alert-danger">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert-box alert-success">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <span><%= success %></span>
                </div>
            <% } %>

            <!-- Top Metric Cards Row -->
            <div class="metrics-grid">
                
                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-label">Total Products</span>
                        <div class="icon-badge bg-total">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="metric-value"><%= typeof totalProducts !== 'undefined' ? totalProducts : 0 %></div>
                </div>

                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-label">Active / Listed</span>
                        <div class="icon-badge bg-active">
                            <div class="dot-green"></div>
                        </div>
                    </div>
                    <div class="metric-value"><%= typeof activeProducts !== 'undefined' ? activeProducts : 0 %></div>
                </div>

                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-label">Out of Stock</span>
                        <div class="icon-badge bg-stock-warn">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                        </div>
                    </div>
                    <div class="metric-value"><%= typeof outOfStockProducts !== 'undefined' ? outOfStockProducts : 0 %></div>
                </div>

                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-label">Deleted (Soft-Deleted)</span>
                        <div class="icon-badge bg-deleted">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="metric-value"><%= typeof deletedProducts !== 'undefined' ? deletedProducts : 0 %></div>
                </div>

            </div>

            <!-- Product Directory Container -->
            <div class="directory-card">
                
                <div class="directory-header">
                    <div class="directory-title-area">
                        <h2 class="directory-title">Product Catalog</h2>
                        <a href="/admin/products/add" class="btn-add-product">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Add Product
                        </a>
                    </div>
                    
                    <form action="/admin/products" method="GET" class="filter-bar" id="productFilterForm">
                        <div class="search-input-wrap">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input
                                type="text"
                                id="searchInput"
                                name="search"
                                placeholder="Search title or description..."
                                value="<%= search || '' %>"
                                autocomplete="off"
                            />
                            <button type="button" id="clearSearchBtn" class="search-clear-btn" title="Clear search" style="<%= search ? 'display: flex;' : 'display: none;' %>">&times;</button>
                        </div>

                        <!-- Category Filter Dropdown -->
                        <select id="categoryFilter" name="category" class="filter-select" onchange="this.form.submit()">
                            <option value="">All Categories</option>
                            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat._id %>" <%= typeof categoryId !== 'undefined' && String(categoryId) === String(cat._id) ? 'selected' : '' %>>
                                        <%= cat.name %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>

                        <!-- Status Filter Dropdown -->
                        <select id="statusFilter" name="status" class="filter-select" onchange="this.form.submit()">
                            <option value="all" <%= typeof statusFilter !== 'undefined' && statusFilter === 'all' ? 'selected' : '' %>>All (Excl. Deleted)</option>
                            <option value="active" <%= typeof statusFilter !== 'undefined' && statusFilter === 'active' ? 'selected' : '' %>>Active Only</option>
                            <option value="unlisted" <%= typeof statusFilter !== 'undefined' && statusFilter === 'unlisted' ? 'selected' : '' %>>Unlisted Only</option>
                            <option value="outOfStock" <%= typeof statusFilter !== 'undefined' && statusFilter === 'outOfStock' ? 'selected' : '' %>>Out of Stock</option>
                            <option value="deleted" <%= typeof statusFilter !== 'undefined' && statusFilter === 'deleted' ? 'selected' : '' %>>Deleted Only</option>
                        </select>

                        <!-- Limit Filter Dropdown -->
                        <select id="limitFilter" name="limit" class="filter-select" onchange="this.form.submit()">
                            <option value="4" <%= typeof limit !== 'undefined' && limit === 4 ? 'selected' : '' %>>4 per page</option>
                            <option value="6" <%= typeof limit !== 'undefined' && limit === 6 ? 'selected' : '' %>>6 per page</option>
                            <option value="10" <%= typeof limit !== 'undefined' && limit === 10 ? 'selected' : '' %>>10 per page</option>
                            <option value="20" <%= typeof limit !== 'undefined' && limit === 20 ? 'selected' : '' %>>20 per page</option>
                        </select>

                        <button type="submit" class="btn-filter-search">Search</button>

                        <a href="/admin/products" id="clearFilterLink" class="btn-clear-filter" style="display: <%= (search || (typeof categoryId !== 'undefined' && categoryId) || (typeof statusFilter !== 'undefined' && statusFilter !== 'all')) ? 'inline-flex' : 'none' %>;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                            Clear
                        </a>
                    </form>
                </div>

                <!-- Directory Table (Sorted Descending) -->
                <div class="table-responsive">
                    <table class="directory-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Date Added &darr;</th>
                                <th>Status</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="productTableBody">
                            <% if (products.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="no-results-cell">
                                        <div class="empty-search-container">
                                            <div class="empty-search-icon">
                                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                    <circle cx="11" cy="11" r="8"></circle>
                                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                                    <line x1="8" y1="11" x2="14" y2="11"></line>
                                                </svg>
                                            </div>
                                            <h4 class="empty-search-title">No Products Found</h4>
                                            <% if (search || (typeof categoryId !== 'undefined' && categoryId)) { %>
                                                <p class="empty-search-desc">
                                                    No products matching your search criteria.
                                                </p>
                                                <button type="button" class="btn-clear-search" onclick="resetSearch()">Clear Filters</button>
                                            <% } else { %>
                                                <p class="empty-search-desc">
                                                    Your product catalog is empty. Start by adding your first product.
                                                </p>
                                                <a href="/admin/products/add" class="btn-clear-search" style="text-decoration: none; display: inline-block;">Add Product</a>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% products.forEach(product => { %>
                                    <tr>
                                        <!-- Product Thumbnail & Title -->
                                        <td>
                                            <div class="product-cell">
                                                <% const thumb = (product.images && product.images.length > 0) ? product.images[0] : '/images/placeholder-product.png'; %>
                                                <img src="<%= thumb %>" alt="<%= product.name %>" class="product-thumb" onerror="this.src='/images/placeholder-product.png'" />
                                                <div class="product-cell-info">
                                                    <span class="product-name-text"><%= product.name %></span>
                                                    <span class="product-img-count"><%= product.images ? product.images.length : 0 %> images</span>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Category -->
                                        <td>
                                            <span class="category-tag">
                                                <%= product.category ? product.category.name : 'Uncategorized' %>
                                            </span>
                                        </td>

                                        <!-- Price -->
                                        <td>
                                            <div class="price-display">
                                                <% if (product.salePrice && product.salePrice < product.regularPrice) { %>
                                                    <span class="price-current">&#8377;<%= product.salePrice.toLocaleString('en-IN') %></span>
                                                    <span class="price-original">&#8377;<%= product.regularPrice.toLocaleString('en-IN') %></span>
                                                <% } else { %>
                                                    <span class="price-current">&#8377;<%= product.regularPrice.toLocaleString('en-IN') %></span>
                                                <% } %>
                                            </div>
                                        </td>

                                        <!-- Stock -->
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                <% if (product.stock <= 0) { %>
                                                    <span class="stock-badge stock-out">Out of Stock (0)</span>
                                                <% } else if (product.stock <= 5) { %>
                                                    <span class="stock-badge stock-low">Low Stock (<%= product.stock %>)</span>
                                                <% } else { %>
                                                    <span class="stock-badge stock-in"><%= product.stock %> in stock</span>
                                                <% } %>
                                                <button type="button" 
                                                        class="btn-edit" 
                                                        style="width: 24px; height: 24px; padding: 0; display: inline-flex; align-items: center; justify-content: center; background: #f4f4f5; border: 1px solid #e4e4e7; border-radius: 4px; cursor: pointer;" 
                                                        title="Quick adjust stock" 
                                                        onclick="promptQuickAdjustStock('<%= product._id %>', '<%= product.name.replace(/'/g, "\\'") %>', <%= product.stock %>)">
                                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                                    </svg>
                                                </button>
                                            </div>
                                        </td>

                                        <!-- Date Added (Descending order) -->
                                        <td style="color: #666666; font-size: 13px;">
                                            <%= product.createdAt ? new Date(product.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A' %>
                                        </td>

                                        <!-- Status Badge -->
                                        <td>
                                            <% if (product.isDeleted) { %>
                                                <span class="badge-status badge-deleted">Deleted</span>
                                            <% } else if (!product.isListed) { %>
                                                <span class="badge-status badge-unlisted">Unlisted</span>
                                            <% } else { %>
                                                <span class="badge-status badge-active">Active</span>
                                            <% } %>
                                        </td>

                                        <!-- Actions -->
                                        <td style="text-align: right;">
                                            <div class="action-buttons-group">
                                                <% if (product.isDeleted) { %>
                                                    <!-- Restore Action -->
                                                    <button
                                                        type="button"
                                                        class="btn-pill-action btn-pill-restore"
                                                        onclick="confirmRestore('<%= product._id %>', '<%= product.name.replace(/'/g, '\\\'') %>')">
                                                        Restore
                                                    </button>
                                                <% } else { %>
                                                    <!-- Edit Action -->
                                                    <a href="/admin/products/edit/<%= product._id %>" class="btn-pill-action btn-pill-edit">
                                                        Edit
                                                    </a>

                                                    <!-- List / Unlist Action -->
                                                    <button
                                                        type="button"
                                                        class="btn-pill-action <%= product.isListed ? 'btn-pill-unlist' : 'btn-pill-list' %>"
                                                        onclick="confirmToggleStatus('<%= product._id %>', '<%= product.name.replace(/'/g, '\\\'') %>', <%= product.isListed %>)">
                                                        <%= product.isListed ? 'Unlist' : 'List' %>
                                                    </button>

                                                    <!-- Soft Delete Action -->
                                                    <button
                                                        type="button"
                                                        class="btn-pill-action btn-pill-delete"
                                                        onclick="confirmSoftDelete('<%= product._id %>', '<%= product.name.replace(/'/g, '\\\'') %>')">
                                                        Delete
                                                    </button>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Footer Pagination Controls -->
                <div class="directory-footer">
                    <div id="paginationInfo">
                        Showing <strong><%= products.length > 0 ? (currentPage - 1) * limit + 1 : 0 %></strong> to <strong><%= Math.min(currentPage * limit, totalMatching) %></strong> of <strong><%= totalMatching %></strong> entries
                    </div>

                    <div class="pagination-group" id="paginationGroup">
                        <% if (currentPage > 1) { %>
                            <a href="/admin/products?page=<%= currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= categoryId ? '&category=' + categoryId : '' %><%= statusFilter !== 'all' ? '&status=' + statusFilter : '' %>&limit=<%= limit %>" class="page-btn">
                                &larr; Previous
                            </a>
                        <% } else { %>
                            <span class="page-btn" style="opacity: 0.4; cursor: not-allowed;">&larr; Previous</span>
                        <% } %>

                        <% for (let page = 1; page <= totalPages; page++) { %>
                            <a href="/admin/products?page=<%= page %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= categoryId ? '&category=' + categoryId : '' %><%= statusFilter !== 'all' ? '&status=' + statusFilter : '' %>&limit=<%= limit %>" class="page-btn <%= page === currentPage ? 'active' : '' %>">
                                <%= page %>
                            </a>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="/admin/products?page=<%= currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= categoryId ? '&category=' + categoryId : '' %><%= statusFilter !== 'all' ? '&status=' + statusFilter : '' %>&limit=<%= limit %>" class="page-btn">
                                Next &rarr;
                            </a>
                        <% } else { %>
                            <span class="page-btn" style="opacity: 0.4; cursor: not-allowed;">Next &rarr;</span>
                        <% } %>
                    </div>
                </div>

            </div>

        </main>
    </div>

    <!-- Client-side Interaction Scripts -->
    <script>
        // Search clear button
        const searchInput = document.getElementById('searchInput');
        const clearSearchBtn = document.getElementById('clearSearchBtn');

        if (searchInput && clearSearchBtn) {
            searchInput.addEventListener('input', () => {
                clearSearchBtn.style.display = searchInput.value ? 'flex' : 'none';
            });
            clearSearchBtn.addEventListener('click', () => {
                resetSearch();
            });
        }

        function resetSearch() {
            if (searchInput) searchInput.value = '';
            const categorySelect = document.getElementById('categoryFilter');
            if (categorySelect) categorySelect.value = '';
            const form = document.getElementById('productFilterForm');
            if (form) form.submit();
        }

        // SweetAlert2 Quiet Luxury helper
        const luxurySwal = Swal.mixin({
            customClass: {
                popup: 'royal-luxury-swal',
                title: 'royal-swal-title',
                confirmButton: 'royal-swal-confirm-btn',
                cancelButton: 'royal-swal-cancel-btn'
            },
            buttonsStyling: false
        });

        // Confirm Soft Delete
        function confirmSoftDelete(id, name) {
            luxurySwal.fire({
                title: 'Soft Delete Product?',
                html: `Are you sure you want to delete <strong>"${name}"</strong>?<br><span style="font-size: 13px; color: #a1a1aa;">This product will be archived and hidden from the store. You can restore it anytime.</span>`,
                icon: 'warning',
                iconColor: '#ef4444',
                showCancelButton: true,
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#dc2626'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/products/delete/${id}`, {
                            method: 'POST',
                            headers: { 'Accept': 'application/json' }
                        });
                        const data = await response.json();
                        if (response.ok && data.success) {
                            luxurySwal.fire({
                                icon: 'success',
                                title: 'Deleted',
                                text: data.message,
                                confirmButtonText: 'OK',
                                confirmButtonColor: '#D48833'
                            }).then(() => window.location.reload());
                        } else {
                            luxurySwal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to delete product.'
                            });
                        }
                    } catch (err) {
                        console.error(err);
                        luxurySwal.fire({ icon: 'error', title: 'Error', text: 'Network error occurred.' });
                    }
                }
            });
        }

        // Confirm Restore
        function confirmRestore(id, name) {
            luxurySwal.fire({
                title: 'Restore Product?',
                html: `Do you want to restore <strong>"${name}"</strong> to the active catalog?`,
                icon: 'question',
                iconColor: '#3b82f6',
                showCancelButton: true,
                confirmButtonText: 'Yes, Restore',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#2563eb'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/products/restore/${id}`, {
                            method: 'POST',
                            headers: { 'Accept': 'application/json' }
                        });
                        const data = await response.json();
                        if (response.ok && data.success) {
                            luxurySwal.fire({
                                icon: 'success',
                                title: 'Restored',
                                text: data.message,
                                confirmButtonText: 'OK',
                                confirmButtonColor: '#D48833'
                            }).then(() => window.location.reload());
                        } else {
                            luxurySwal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to restore product.'
                            });
                        }
                    } catch (err) {
                        console.error(err);
                        luxurySwal.fire({ icon: 'error', title: 'Error', text: 'Network error occurred.' });
                    }
                }
            });
        }

        // Confirm Toggle Status
        function confirmToggleStatus(id, name, isCurrentlyListed) {
            const action = isCurrentlyListed ? 'unlist' : 'list';
            const actionLabel = isCurrentlyListed ? 'Unlist' : 'List';
            const confirmColor = isCurrentlyListed ? '#d97706' : '#059669';

            luxurySwal.fire({
                title: `${actionLabel} Product?`,
                html: `Are you sure you want to <strong>${action}</strong> <strong>"${name}"</strong>?<br><span style="font-size: 13px; color: #a1a1aa;">${isCurrentlyListed ? 'It will be hidden from customer view in the store.' : 'It will become visible to customers in the store.'}</span>`,
                icon: 'info',
                iconColor: '#D48833',
                showCancelButton: true,
                confirmButtonText: `Yes, ${actionLabel}`,
                cancelButtonText: 'Cancel',
                confirmButtonColor: confirmColor
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/products/toggle-status/${id}`, {
                            method: 'POST',
                            headers: { 'Accept': 'application/json' }
                        });
                        const data = await response.json();
                        if (response.ok && data.success) {
                            luxurySwal.fire({
                                icon: 'success',
                                title: 'Status Updated',
                                text: data.message,
                                confirmButtonText: 'OK',
                                confirmButtonColor: '#D48833'
                            }).then(() => window.location.reload());
                        } else {
                            luxurySwal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to update product status.'
                            });
                        }
                    } catch (err) {
                        console.error(err);
                        luxurySwal.fire({ icon: 'error', title: 'Error', text: 'Network error occurred.' });
                    }
                }
            });
        }

        // Quick Adjust Stock from Product Table
        function promptQuickAdjustStock(productId, productName, currentStock) {
            luxurySwal.fire({
                title: 'Adjust Product Stock',
                html: `
                    <div style="text-align: left; margin-bottom: 12px; font-size: 13.5px; color: #a1a1aa;">
                        Adjusting inventory for: <strong style="color: #ffffff;">${productName}</strong><br>
                        Current Count: <strong style="color: #D48833;">${currentStock} units</strong>
                    </div>

                    <div style="display: flex; gap: 8px; margin-bottom: 14px;">
                        <button type="button" onclick="document.getElementById('quickStockInput').value = ${currentStock} + 5" style="flex: 1; padding: 7px; border-radius: 6px; background: #27272a; color: #ffffff; border: 1px solid #3f3f46; font-size: 12px; cursor: pointer;">+5</button>
                        <button type="button" onclick="document.getElementById('quickStockInput').value = ${currentStock} + 10" style="flex: 1; padding: 7px; border-radius: 6px; background: #27272a; color: #ffffff; border: 1px solid #3f3f46; font-size: 12px; cursor: pointer;">+10</button>
                        <button type="button" onclick="document.getElementById('quickStockInput').value = ${currentStock} + 25" style="flex: 1; padding: 7px; border-radius: 6px; background: #27272a; color: #ffffff; border: 1px solid #3f3f46; font-size: 12px; cursor: pointer;">+25</button>
                    </div>

                    <div style="text-align: left; margin-bottom: 6px; font-size: 12.5px; color: #d4d4d8;">New Total Stock:</div>
                    <input id="quickStockInput" 
                           type="number" 
                           min="0" 
                           value="${currentStock}" 
                           style="width: 100%; height: 42px; border-radius: 8px; border: 1px solid #3f3f46; background: #1f1f23; color: #ffffff; padding: 0 12px; font-size: 15px; font-weight: 600;" />
                `,
                icon: 'info',
                iconColor: '#D48833',
                showCancelButton: true,
                confirmButtonText: 'Save Stock',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#D48833',
                preConfirm: () => {
                    const stock = document.getElementById('quickStockInput').value;
                    if (stock === '' || isNaN(stock) || parseInt(stock, 10) < 0) {
                        Swal.showValidationMessage('Please provide a valid non-negative stock quantity');
                        return false;
                    }
                    return parseInt(stock, 10);
                }
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const newStock = result.value;
                    try {
                        const response = await fetch(`/admin/products/${productId}/stock`, {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json',
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ stock: newStock, mode: 'set' })
                        });
                        const data = await response.json();
                        if (response.ok && data.success) {
                            luxurySwal.fire({
                                icon: 'success',
                                title: 'Stock Updated',
                                text: data.message || `Stock updated to ${newStock} units.`,
                                confirmButtonColor: '#D48833'
                            }).then(() => window.location.reload());
                        } else {
                            luxurySwal.fire({
                                icon: 'error',
                                title: 'Notice',
                                text: data.message || 'Unable to update stock.'
                            });
                        }
                    } catch (err) {
                        console.error('Update stock error:', err);
                        luxurySwal.fire({ icon: 'error', title: 'Error', text: 'Network communication failed.' });
                    }
                }
            });
        }
    </script>
</body>

</html>
