<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create New Password - ROYAL IGNITE Admin</title>
    <link rel="stylesheet" href="/css/admin/login.css" />
    <style>
        .req-box {
            background: rgba(241, 240, 237, 0.5);
            border: 0.8px solid rgba(232, 230, 225, 0.6);
            border-radius: 10px;
            padding: 16px 20px;
            margin: 20px 0;
            font-size: 12px;
            color: var(--admin-text-muted);
        }
        .req-title {
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.55px;
            color: var(--admin-text-dark);
            margin-bottom: 10px;
        }
        .req-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .req-list li {
            display: flex;
            align-items: center;
            gap: 8px;
        }
    </style>
</head>

<body>

    <!-- Admin Header Branding -->
    <div class="admin-header">
        <a href="/" class="admin-logo">ROYAL IGNITE</a>
        <span class="admin-badge">ADMIN PANEL</span>
    </div>

    <!-- Reset Password Card -->
    <main class="admin-card">
        
        <h1 class="admin-title">Create New Password</h1>
        <p class="admin-subtitle">
            Set a strong new password to securely access your ROYAL IGNITE admin dashboard.
        </p>

        <% if (typeof error !== "undefined" && error) { %>
            <div class="error-badge"><%= error %></div>
        <% } %>

        <form action="/admin/reset-password" method="POST" id="adminResetForm" novalidate>
            
            <div class="form-group">
                <label for="newPassword">NEW PASSWORD</label>
                <input
                    type="password"
                    id="newPassword"
                    name="newPassword"
                    class="form-input"
                    placeholder="Minimum 8 characters (letters & numbers)"
                    data-validate="password"
                    required
                />
            </div>

            <!-- Password criteria -->
            <div class="req-box">
                <div class="req-title">PASSWORD REQUIREMENTS</div>
                <ul class="req-list">
                    <li><span style="color:#111;">✓</span> Minimum 8 characters</li>
                    <li><span style="color:#111;">✓</span> Must contain at least one letter</li>
                    <li><span style="color:#111;">✓</span> Must contain at least one number</li>
                </ul>
            </div>

            <div class="form-group">
                <label for="confirmPassword">CONFIRM PASSWORD</label>
                <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    class="form-input"
                    placeholder="Confirm new password"
                    data-validate="confirmPassword"
                    required
                />
            </div>

            <button type="submit" class="primary-btn">
                RESET PASSWORD &rarr;
            </button>

        </form>

        <div style="text-align: center; margin-top: 24px;">
            <a href="/admin/login" class="forgot-link" style="display: inline-flex; align-items: center; gap: 6px;">
                &larr; Back to Login
            </a>
        </div>

    </main>

    <!-- Bottom Security Note -->
    <div class="security-note-box">
        <div class="shield-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
        </div>
        <div class="security-note-title">Secure Password Recovery</div>
        <div class="security-note-desc">
            Your new password will immediately update your ROYAL IGNITE admin account security and active sessions.
        </div>
    </div>

    <script src="/js/validation.js"></script>

</body>

</html>
