<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Category Management - ROYAL IGNITE Admin</title>
    <link rel="stylesheet" href="/css/admin/categoryList.css" />
    <!-- SweetAlert2 for Quiet Luxury Confirmations & Alerts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .royal-luxury-swal {
            background: #141312 !important;
            border: 1px solid rgba(212, 136, 51, 0.28) !important;
            border-radius: 16px !important;
            padding: 26px 22px !important;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75) !important;
            color: #f0ece6 !important;
            font-family: 'Instrument Sans', sans-serif !important;
        }
        .royal-swal-title {
            font-family: 'DM Serif Display', serif !important;
            color: #ffffff !important;
            font-size: 22px !important;
            letter-spacing: 0.3px !important;
            margin-bottom: 8px !important;
        }
        .royal-swal-confirm-btn {
            border-radius: 8px !important;
            font-weight: 600 !important;
            font-size: 13px !important;
            letter-spacing: 0.4px !important;
            padding: 10px 22px !important;
            box-shadow: none !important;
            cursor: pointer !important;
        }
        .royal-swal-cancel-btn {
            border-radius: 8px !important;
            font-weight: 500 !important;
            font-size: 13px !important;
            letter-spacing: 0.4px !important;
            padding: 10px 20px !important;
            background: #27272a !important;
            color: #d4d4d8 !important;
            box-shadow: none !important;
            cursor: pointer !important;
        }
        .royal-swal-cancel-btn:hover {
            background: #3f3f46 !important;
            color: #ffffff !important;
        }
    </style>
</head>

<body>

    <!-- Left Sidebar Navigation -->
    <aside class="sidebar">
        <div>
            <div class="sidebar-header">
                <a href="/admin/dashboard" class="sidebar-logo">ROYAL IGNITE</a>
            </div>

            <!-- Overview Section -->
            <div class="nav-section">
                <div class="nav-section-title">Overview</div>
                <ul class="nav-links">
                    <li>
                        <a href="/admin/dashboard" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                            Dashboard
                        </a>
                    </li>
                    <li>
                        <a href="/admin/analytics" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                <line x1="6" y1="20" x2="6" y2="14"></line>
                            </svg>
                            Analytics
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Management Section -->
            <div class="nav-section">
                <div class="nav-section-title">Management</div>
                <ul class="nav-links">
                    <li>
                        <a href="/admin/categories" class="nav-link active">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                            Categories
                        </a>
                    </li>
                    <li>
                        <a href="/admin/products" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            </svg>
                            Products
                        </a>
                    </li>
                    <li>
                        <a href="/admin/inventory" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                <line x1="12" y1="22.08" x2="12" y2="12"></line>
                            </svg>
                            Inventory
                        </a>
                    </li>
                    <li>
                        <a href="/admin/users" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            Customers
                        </a>
                    </li>
                    <li>
                        <a href="/admin/orders" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            Orders
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                            Offers
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                                <line x1="7" y1="7" x2="7.01" y2="7"></line>
                            </svg>
                            Coupons
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                <polyline points="21 15 16 10 5 21"></polyline>
                            </svg>
                            Banner
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <form action="/admin/logout" method="POST">
            <button type="submit" class="btn-logout">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                Logout
            </button>
        </form>
    </aside>

    <!-- Main Wrapper Area -->
    <div class="main-wrapper">
        
        <!-- Top Navbar Header -->
        <header class="top-navbar">
            <h1 class="top-navbar-title">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                </svg>
                Category Management
            </h1>
            <div class="top-navbar-right">
                <div class="avatar-circle">A</div>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="content-padding">

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-box alert-danger">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert-box alert-success">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <span><%= success %></span>
                </div>
            <% } %>

            <!-- Top Metric Cards Row -->
            <div class="metrics-grid">
                
                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-label">Total Categories</span>
                        <div class="icon-badge bg-total">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="metric-value"><%= typeof totalCategories !== 'undefined' ? totalCategories : 0 %></div>
                </div>

                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-label">Active / Listed</span>
                        <div class="icon-badge bg-active">
                            <div class="dot-green"></div>
                        </div>
                    </div>
                    <div class="metric-value"><%= typeof activeCategories !== 'undefined' ? activeCategories : 0 %></div>
                </div>

                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-label">Unlisted</span>
                        <div class="icon-badge bg-unlisted">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                            </svg>
                        </div>
                    </div>
                    <div class="metric-value"><%= typeof unlistedCategories !== 'undefined' ? unlistedCategories : 0 %></div>
                </div>

                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-label">Deleted (Soft-Deleted)</span>
                        <div class="icon-badge bg-deleted">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="metric-value"><%= typeof deletedCategories !== 'undefined' ? deletedCategories : 0 %></div>
                </div>

            </div>

            <!-- Category Directory Container -->
            <div class="directory-card">
                
                <div class="directory-header">
                    <div class="directory-title-area">
                        <h2 class="directory-title">Category Catalog</h2>
                        <button type="button" class="btn-add-category" onclick="openAddModal()">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Add Category
                        </button>
                    </div>
                    
                    <form action="/admin/categories" method="GET" class="filter-bar" id="categoryFilterForm">
                        <div class="search-input-wrap">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input
                                type="text"
                                id="searchInput"
                                name="search"
                                placeholder="Search category or description..."
                                value="<%= search || '' %>"
                                autocomplete="off"
                            />
                            <button type="button" id="clearSearchBtn" class="search-clear-btn" title="Clear search" style="<%= search ? 'display: flex;' : 'display: none;' %>">&times;</button>
                        </div>

                        <select id="statusFilter" name="status" class="filter-select" onchange="this.form.submit()">
                            <option value="all" <%= typeof statusFilter !== 'undefined' && statusFilter === 'all' ? 'selected' : '' %>>All (Excl. Deleted)</option>
                            <option value="active" <%= typeof statusFilter !== 'undefined' && statusFilter === 'active' ? 'selected' : '' %>>Active Only</option>
                            <option value="unlisted" <%= typeof statusFilter !== 'undefined' && statusFilter === 'unlisted' ? 'selected' : '' %>>Unlisted Only</option>
                            <option value="deleted" <%= typeof statusFilter !== 'undefined' && statusFilter === 'deleted' ? 'selected' : '' %>>Deleted Only</option>
                        </select>

                        <select id="limitFilter" name="limit" class="filter-select" onchange="this.form.submit()">
                            <option value="4" <%= typeof limit !== 'undefined' && limit === 4 ? 'selected' : '' %>>4 per page</option>
                            <option value="5" <%= typeof limit !== 'undefined' && limit === 5 ? 'selected' : '' %>>5 per page</option>
                            <option value="8" <%= typeof limit !== 'undefined' && limit === 8 ? 'selected' : '' %>>8 per page</option>
                            <option value="10" <%= typeof limit !== 'undefined' && limit === 10 ? 'selected' : '' %>>10 per page</option>
                            <option value="20" <%= typeof limit !== 'undefined' && limit === 20 ? 'selected' : '' %>>20 per page</option>
                        </select>

                        <button type="submit" class="btn-filter-search">Search</button>

                        <a href="/admin/categories" id="clearFilterLink" class="btn-clear-filter" style="display: <%= (search || (typeof statusFilter !== 'undefined' && statusFilter !== 'all')) ? 'inline-flex' : 'none' %>;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                            Clear
                        </a>
                    </form>
                </div>

                <!-- Directory Table (Sorted in Descending Order) -->
                <div class="table-responsive">
                    <table class="directory-table">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Date Added &darr;</th>
                                <th>Status</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="categoryTableBody">
                            <% if (categories.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="no-results-cell">
                                        <div class="empty-search-container">
                                            <div class="empty-search-icon">
                                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                    <circle cx="11" cy="11" r="8"></circle>
                                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                                    <line x1="8" y1="11" x2="14" y2="11"></line>
                                                </svg>
                                            </div>
                                            <h4 class="empty-search-title">No Categories Found</h4>
                                            <% if (search) { %>
                                                <p class="empty-search-desc">
                                                    No category records found matching "<span class="search-term-highlight"><%= search %></span>".
                                                </p>
                                                <button type="button" class="btn-clear-search" onclick="resetSearch()">Clear Search</button>
                                            <% } else { %>
                                                <p class="empty-search-desc">
                                                    No categories currently match your selected status filter.
                                                </p>
                                                <button type="button" class="btn-clear-search" onclick="openAddModal()">Add Category</button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% categories.forEach(category => { %>
                                    <tr>
                                        <!-- Category Name with luxury icon -->
                                        <td>
                                            <div class="category-cell">
                                                <div class="category-avatar">
                                                    <%= category.name ? category.name.charAt(0).toUpperCase() : 'C' %>
                                                </div>
                                                <span class="category-name-text"><%= category.name %></span>
                                            </div>
                                        </td>

                                        <!-- Description -->
                                        <td>
                                            <div class="category-desc" title="<%= category.description || 'No description provided' %>">
                                                <%= category.description || '—' %>
                                            </div>
                                        </td>

                                        <!-- Date Added (Descending order) -->
                                        <td style="color: #666666; font-size: 13px;">
                                            <%= category.createdAt ? new Date(category.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A' %>
                                        </td>

                                        <!-- Status Badge -->
                                        <td>
                                            <% if (category.isDeleted) { %>
                                                <span class="badge-status badge-deleted">Deleted</span>
                                            <% } else if (!category.isListed) { %>
                                                <span class="badge-status badge-unlisted">Unlisted</span>
                                            <% } else { %>
                                                <span class="badge-status badge-active">Active</span>
                                            <% } %>
                                        </td>

                                        <!-- Actions -->
                                        <td style="text-align: right;">
                                            <div class="action-buttons-group">
                                                <% if (category.isDeleted) { %>
                                                    <!-- Restore Action for Soft-Deleted Categories -->
                                                    <button
                                                        type="button"
                                                        class="btn-pill-action btn-pill-restore"
                                                        onclick="confirmRestore('<%= category._id %>', '<%= category.name.replace(/'/g, '\\\'') %>')">
                                                        Restore
                                                    </button>
                                                <% } else { %>
                                                    <!-- Edit Action -->
                                                    <button
                                                        type="button"
                                                        class="btn-pill-action btn-pill-edit"
                                                        onclick="openEditModal('<%= category._id %>', '<%= category.name.replace(/'/g, '\\\'') %>', '<%= (category.description || '').replace(/'/g, '\\\'').replace(/\n/g, ' ') %>', <%= category.isListed %>)">
                                                        Edit
                                                    </button>

                                                    <!-- List / Unlist Toggle -->
                                                    <button
                                                        type="button"
                                                        class="btn-pill-action <%= category.isListed ? 'btn-pill-unlist' : 'btn-pill-list' %>"
                                                        onclick="confirmToggleStatus('<%= category._id %>', '<%= category.name.replace(/'/g, '\\\'') %>', <%= category.isListed %>)">
                                                        <%= category.isListed ? 'Unlist' : 'List' %>
                                                    </button>

                                                    <!-- Soft Delete Action -->
                                                    <button
                                                        type="button"
                                                        class="btn-pill-action btn-pill-delete"
                                                        onclick="confirmSoftDelete('<%= category._id %>', '<%= category.name.replace(/'/g, '\\\'') %>')">
                                                        Delete
                                                    </button>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Footer Pagination Controls -->
                <div class="directory-footer">
                    <div id="paginationInfo">
                        Showing <strong><%= categories.length > 0 ? (currentPage - 1) * limit + 1 : 0 %></strong> to <strong><%= Math.min(currentPage * limit, totalMatching) %></strong> of <strong><%= totalMatching %></strong> entries
                    </div>

                    <div class="pagination-group" id="paginationGroup">
                        <% if (currentPage > 1) { %>
                            <a href="/admin/categories?page=<%= currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= statusFilter !== 'all' ? '&status=' + statusFilter : '' %>&limit=<%= limit %>" class="page-btn">
                                &larr; Previous
                            </a>
                        <% } else { %>
                            <span class="page-btn" style="opacity: 0.4; cursor: not-allowed;">&larr; Previous</span>
                        <% } %>

                        <% for (let page = 1; page <= totalPages; page++) { %>
                            <a href="/admin/categories?page=<%= page %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= statusFilter !== 'all' ? '&status=' + statusFilter : '' %>&limit=<%= limit %>" class="page-btn <%= page === currentPage ? 'active' : '' %>">
                                <%= page %>
                            </a>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="/admin/categories?page=<%= currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= statusFilter !== 'all' ? '&status=' + statusFilter : '' %>&limit=<%= limit %>" class="page-btn">
                                Next &rarr;
                            </a>
                        <% } else { %>
                            <span class="page-btn" style="opacity: 0.4; cursor: not-allowed;">Next &rarr;</span>
                        <% } %>
                    </div>
                </div>

            </div>

        </main>
    </div>

    <!-- ========================================
         ADD CATEGORY MODAL
         ======================================== -->
    <div class="modal-overlay" id="addCategoryModal" onclick="handleModalOverlayClick(event, 'addCategoryModal')">
        <div class="modal-dialog">
            <div class="modal-header">
                <h3 class="modal-title">Add New Category</h3>
                <button type="button" class="modal-close-btn" onclick="closeModal('addCategoryModal')">&times;</button>
            </div>

            <form id="addCategoryForm" novalidate onsubmit="submitAddCategory(event)">
                <div class="form-group">
                    <label class="form-label" for="addCategoryName">Category Name <span class="req">*</span></label>
                    <input
                        type="text"
                        id="addCategoryName"
                        name="name"
                        class="form-control"
                        placeholder="e.g., Luxury Watches, Fine Fragrances"
                        maxlength="50"
                        required
                        autocomplete="off"
                    />
                    <div class="form-help">
                        <span>Alphanumeric characters, spaces, and &amp; / -</span>
                        <span id="addNameCounter">0/50</span>
                    </div>
                    <div class="form-error-msg" id="addNameError"></div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="addCategoryDesc">Description (Optional)</label>
                    <textarea
                        id="addCategoryDesc"
                        name="description"
                        class="form-control"
                        placeholder="Brief summary of items in this category..."
                        maxlength="500"
                    ></textarea>
                    <div class="form-help">
                        <span>Max 500 characters</span>
                        <span id="addDescCounter">0/500</span>
                    </div>
                    <div class="form-error-msg" id="addDescError"></div>
                </div>

                <div class="form-group">
                    <label class="form-check">
                        <input type="checkbox" id="addCategoryListed" name="isListed" value="true" checked />
                        <span class="form-check-label">List category immediately (visible in catalog)</span>
                    </label>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn-modal-cancel" onclick="closeModal('addCategoryModal')">Cancel</button>
                    <button type="submit" class="btn-modal-submit" id="addCategorySubmitBtn">
                        Create Category
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ========================================
         EDIT CATEGORY MODAL
         ======================================== -->
    <div class="modal-overlay" id="editCategoryModal" onclick="handleModalOverlayClick(event, 'editCategoryModal')">
        <div class="modal-dialog">
            <div class="modal-header">
                <h3 class="modal-title">Edit Category</h3>
                <button type="button" class="modal-close-btn" onclick="closeModal('editCategoryModal')">&times;</button>
            </div>

            <form id="editCategoryForm" novalidate onsubmit="submitEditCategory(event)">
                <input type="hidden" id="editCategoryId" name="id" />

                <div class="form-group">
                    <label class="form-label" for="editCategoryName">Category Name <span class="req">*</span></label>
                    <input
                        type="text"
                        id="editCategoryName"
                        name="name"
                        class="form-control"
                        placeholder="e.g., Luxury Watches"
                        maxlength="50"
                        required
                        autocomplete="off"
                    />
                    <div class="form-help">
                        <span>Alphanumeric characters, spaces, and &amp; / -</span>
                        <span id="editNameCounter">0/50</span>
                    </div>
                    <div class="form-error-msg" id="editNameError"></div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="editCategoryDesc">Description (Optional)</label>
                    <textarea
                        id="editCategoryDesc"
                        name="description"
                        class="form-control"
                        placeholder="Brief summary of items in this category..."
                        maxlength="500"
                    ></textarea>
                    <div class="form-help">
                        <span>Max 500 characters</span>
                        <span id="editDescCounter">0/500</span>
                    </div>
                    <div class="form-error-msg" id="editDescError"></div>
                </div>

                <div class="form-group">
                    <label class="form-check">
                        <input type="checkbox" id="editCategoryListed" name="isListed" value="true" />
                        <span class="form-check-label">List category (visible in catalog)</span>
                    </label>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn-modal-cancel" onclick="closeModal('editCategoryModal')">Cancel</button>
                    <button type="submit" class="btn-modal-submit" id="editCategorySubmitBtn">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Hidden form for Soft Delete & Restore Actions -->
    <form id="actionSubmitForm" method="POST" style="display: none;"></form>

    <!-- Client-side Interaction Scripts -->
    <script>
        // Modal management
        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('open');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('open');
                document.body.style.overflow = '';
            }
        }

        function handleModalOverlayClick(e, id) {
            if (e.target === e.currentTarget) {
                closeModal(id);
            }
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeModal('addCategoryModal');
                closeModal('editCategoryModal');
            }
        });

        // ========================================
        // CATEGORY FORM VALIDATION ENGINE
        // ========================================
        function setCategoryFieldError(inputId, errorId, message) {
            const field = document.getElementById(inputId);
            const errorEl = document.getElementById(errorId);
            if (!field || !errorEl) return;

            field.classList.add('input-error');
            field.setAttribute('aria-invalid', 'true');
            errorEl.innerHTML = `
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>${message}</span>
            `;
            errorEl.classList.add('visible');
            errorEl.style.display = 'flex';
        }

        function clearCategoryFieldError(inputId, errorId) {
            const field = document.getElementById(inputId);
            const errorEl = document.getElementById(errorId);
            if (!field || !errorEl) return;

            field.classList.remove('input-error');
            field.removeAttribute('aria-invalid');
            errorEl.innerHTML = '';
            errorEl.classList.remove('visible');
            errorEl.style.display = 'none';
        }

        // Validate Category Name
        function validateCategoryNameField(inputId, errorId, showUi = true) {
            const field = document.getElementById(inputId);
            if (!field) return true;
            const val = field.value.trim();

            if (!val) {
                if (showUi) setCategoryFieldError(inputId, errorId, 'Category name is required.');
                return false;
            }
            if (val.length < 2) {
                if (showUi) setCategoryFieldError(inputId, errorId, 'Category name must be at least 2 characters long.');
                return false;
            }
            if (val.length > 50) {
                if (showUi) setCategoryFieldError(inputId, errorId, 'Category name cannot exceed 50 characters.');
                return false;
            }
            if (!/[a-zA-Z]/.test(val)) {
                if (showUi) setCategoryFieldError(inputId, errorId, 'Category name must contain at least one letter.');
                return false;
            }
            if (!/^[a-zA-Z0-9\s&/\-_',.]*$/.test(val)) {
                if (showUi) setCategoryFieldError(inputId, errorId, 'Category name contains invalid characters. Use letters, numbers, spaces, and & / - _ \' , .');
                return false;
            }

            clearCategoryFieldError(inputId, errorId);
            return true;
        }

        // Validate Category Description (Optional, max 500)
        function validateCategoryDescField(inputId, errorId, showUi = true) {
            const field = document.getElementById(inputId);
            if (!field) return true;
            const val = field.value;

            if (val && val.trim().length > 500) {
                if (showUi) setCategoryFieldError(inputId, errorId, 'Description cannot exceed 500 characters.');
                return false;
            }

            clearCategoryFieldError(inputId, errorId);
            return true;
        }

        // Open Add Modal with Clean State
        function openAddModal() {
            const form = document.getElementById('addCategoryForm');
            if (form) form.reset();
            document.getElementById('addCategoryListed').checked = true;
            clearCategoryFieldError('addCategoryName', 'addNameError');
            clearCategoryFieldError('addCategoryDesc', 'addDescError');
            document.getElementById('addNameCounter').textContent = '0/50';
            document.getElementById('addDescCounter').textContent = '0/500';
            openModal('addCategoryModal');
            setTimeout(() => {
                const nameInput = document.getElementById('addCategoryName');
                if (nameInput) nameInput.focus();
            }, 150);
        }

        // Open Edit Modal with Pre-filled values and Clean Error State
        function openEditModal(id, name, description, isListed) {
            document.getElementById('editCategoryId').value = id;
            document.getElementById('editCategoryName').value = name;
            document.getElementById('editCategoryDesc').value = description || '';
            document.getElementById('editCategoryListed').checked = Boolean(isListed);
            clearCategoryFieldError('editCategoryName', 'editNameError');
            clearCategoryFieldError('editCategoryDesc', 'editDescError');
            document.getElementById('editNameCounter').textContent = `${(name || '').length}/50`;
            document.getElementById('editDescCounter').textContent = `${(description || '').length}/500`;
            openModal('editCategoryModal');
            setTimeout(() => {
                const nameInput = document.getElementById('editCategoryName');
                if (nameInput) nameInput.focus();
            }, 150);
        }

        // Live Character Counters
        function attachCharCounter(inputId, counterId, max) {
            const input = document.getElementById(inputId);
            const counter = document.getElementById(counterId);
            if (input && counter) {
                input.addEventListener('input', () => {
                    counter.textContent = `${input.value.length}/${max}`;
                });
            }
        }
        attachCharCounter('addCategoryName', 'addNameCounter', 50);
        attachCharCounter('addCategoryDesc', 'addDescCounter', 500);
        attachCharCounter('editCategoryName', 'editNameCounter', 50);
        attachCharCounter('editCategoryDesc', 'editDescCounter', 500);

        // Real-Time Validation Listeners
        const addNameInput = document.getElementById('addCategoryName');
        const addDescInput = document.getElementById('addCategoryDesc');
        const editNameInput = document.getElementById('editCategoryName');
        const editDescInput = document.getElementById('editCategoryDesc');

        if (addNameInput) {
            addNameInput.addEventListener('blur', () => {
                validateCategoryNameField('addCategoryName', 'addNameError', true);
            });
            addNameInput.addEventListener('input', () => {
                if (addNameInput.classList.contains('input-error')) {
                    validateCategoryNameField('addCategoryName', 'addNameError', true);
                }
            });
        }

        if (addDescInput) {
            addDescInput.addEventListener('blur', () => {
                validateCategoryDescField('addCategoryDesc', 'addDescError', true);
            });
            addDescInput.addEventListener('input', () => {
                if (addDescInput.classList.contains('input-error')) {
                    validateCategoryDescField('addCategoryDesc', 'addDescError', true);
                }
            });
        }

        if (editNameInput) {
            editNameInput.addEventListener('blur', () => {
                validateCategoryNameField('editCategoryName', 'editNameError', true);
            });
            editNameInput.addEventListener('input', () => {
                if (editNameInput.classList.contains('input-error')) {
                    validateCategoryNameField('editCategoryName', 'editNameError', true);
                }
            });
        }

        if (editDescInput) {
            editDescInput.addEventListener('blur', () => {
                validateCategoryDescField('editCategoryDesc', 'editDescError', true);
            });
            editDescInput.addEventListener('input', () => {
                if (editDescInput.classList.contains('input-error')) {
                    validateCategoryDescField('editCategoryDesc', 'editDescError', true);
                }
            });
        }

        // Search Input Clear Button Handling
        const searchInput = document.getElementById('searchInput');
        const clearSearchBtn = document.getElementById('clearSearchBtn');

        if (searchInput && clearSearchBtn) {
            searchInput.addEventListener('input', () => {
                clearSearchBtn.style.display = searchInput.value ? 'flex' : 'none';
            });

            clearSearchBtn.addEventListener('click', () => {
                resetSearch();
            });
        }

        function resetSearch() {
            if (searchInput) searchInput.value = '';
            const form = document.getElementById('categoryFilterForm');
            if (form) form.submit();
        }

        // SweetAlert2 helper for luxury confirmations
        const luxurySwal = Swal.mixin({
            customClass: {
                popup: 'royal-luxury-swal',
                title: 'royal-swal-title',
                confirmButton: 'royal-swal-confirm-btn',
                cancelButton: 'royal-swal-cancel-btn'
            },
            buttonsStyling: false
        });

        // Submit Add Category with Full Client-Side Validation
        async function submitAddCategory(e) {
            e.preventDefault();

            // Run full validations
            const isNameValid = validateCategoryNameField('addCategoryName', 'addNameError', true);
            const isDescValid = validateCategoryDescField('addCategoryDesc', 'addDescError', true);

            if (!isNameValid || !isDescValid) {
                if (!isNameValid) {
                    document.getElementById('addCategoryName').focus();
                } else {
                    document.getElementById('addCategoryDesc').focus();
                }
                return;
            }

            const nameInput = document.getElementById('addCategoryName');
            const descInput = document.getElementById('addCategoryDesc');
            const listedInput = document.getElementById('addCategoryListed');
            const submitBtn = document.getElementById('addCategorySubmitBtn');

            const name = nameInput.value.trim();
            const description = descInput.value.trim();
            const isListed = listedInput.checked;

            try {
                submitBtn.disabled = true;
                submitBtn.innerHTML = `
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin">
                        <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                        <path d="M12 2a10 10 0 0 1 10 10"></path>
                    </svg>
                    <span>Creating...</span>
                `;

                const response = await fetch('/admin/categories/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ name, description, isListed })
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    const errorMsg = data.message || 'Failed to add category.';
                    setCategoryFieldError('addCategoryName', 'addNameError', errorMsg);
                    nameInput.focus();
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Create Category';
                    return;
                }

                closeModal('addCategoryModal');
                luxurySwal.fire({
                    icon: 'success',
                    title: 'Category Created',
                    text: data.message || `Category "${name}" added successfully.`,
                    confirmButtonText: 'Done',
                    confirmButtonColor: '#D48833'
                }).then(() => {
                    window.location.reload();
                });
            } catch (err) {
                console.error(err);
                setCategoryFieldError('addCategoryName', 'addNameError', 'An unexpected network error occurred. Please try again.');
                submitBtn.disabled = false;
                submitBtn.textContent = 'Create Category';
            }
        }

        // Submit Edit Category with Full Client-Side Validation
        async function submitEditCategory(e) {
            e.preventDefault();

            // Run full validations
            const isNameValid = validateCategoryNameField('editCategoryName', 'editNameError', true);
            const isDescValid = validateCategoryDescField('editCategoryDesc', 'editDescError', true);

            if (!isNameValid || !isDescValid) {
                if (!isNameValid) {
                    document.getElementById('editCategoryName').focus();
                } else {
                    document.getElementById('editCategoryDesc').focus();
                }
                return;
            }

            const id = document.getElementById('editCategoryId').value;
            const nameInput = document.getElementById('editCategoryName');
            const descInput = document.getElementById('editCategoryDesc');
            const listedInput = document.getElementById('editCategoryListed');
            const submitBtn = document.getElementById('editCategorySubmitBtn');

            const name = nameInput.value.trim();
            const description = descInput.value.trim();
            const isListed = listedInput.checked;

            try {
                submitBtn.disabled = true;
                submitBtn.innerHTML = `
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin">
                        <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                        <path d="M12 2a10 10 0 0 1 10 10"></path>
                    </svg>
                    <span>Saving...</span>
                `;

                const response = await fetch(`/admin/categories/edit/${id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ name, description, isListed })
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    const errorMsg = data.message || 'Failed to update category.';
                    setCategoryFieldError('editCategoryName', 'editNameError', errorMsg);
                    nameInput.focus();
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Save Changes';
                    return;
                }

                closeModal('editCategoryModal');
                luxurySwal.fire({
                    icon: 'success',
                    title: 'Category Updated',
                    text: data.message || `Category "${name}" updated successfully.`,
                    confirmButtonText: 'Done',
                    confirmButtonColor: '#D48833'
                }).then(() => {
                    window.location.reload();
                });
            } catch (err) {
                console.error(err);
                setCategoryFieldError('editCategoryName', 'editNameError', 'An unexpected network error occurred. Please try again.');
                submitBtn.disabled = false;
                submitBtn.textContent = 'Save Changes';
            }
        }

        // Confirm Soft Delete
        function confirmSoftDelete(id, name) {
            luxurySwal.fire({
                title: 'Soft Delete Category?',
                html: `Are you sure you want to delete <strong>"${name}"</strong>?<br><span style="font-size: 13px; color: #a1a1aa;">This category will be marked as deleted and can be restored at any time.</span>`,
                icon: 'warning',
                iconColor: '#ef4444',
                showCancelButton: true,
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#dc2626'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/categories/delete/${id}`, {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json'
                            }
                        });
                        const data = await response.json();
                        if (response.ok && data.success) {
                            luxurySwal.fire({
                                icon: 'success',
                                title: 'Deleted',
                                text: data.message,
                                confirmButtonText: 'OK',
                                confirmButtonColor: '#D48833'
                            }).then(() => window.location.reload());
                        } else {
                            luxurySwal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to delete category.'
                            });
                        }
                    } catch (err) {
                        console.error(err);
                        luxurySwal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Network error occurred while deleting.'
                        });
                    }
                }
            });
        }

        // Confirm Restore
        function confirmRestore(id, name) {
            luxurySwal.fire({
                title: 'Restore Category?',
                html: `Do you want to restore <strong>"${name}"</strong> to the active catalog?`,
                icon: 'question',
                iconColor: '#3b82f6',
                showCancelButton: true,
                confirmButtonText: 'Yes, Restore',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#2563eb'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/categories/restore/${id}`, {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json'
                            }
                        });
                        const data = await response.json();
                        if (response.ok && data.success) {
                            luxurySwal.fire({
                                icon: 'success',
                                title: 'Restored',
                                text: data.message,
                                confirmButtonText: 'OK',
                                confirmButtonColor: '#D48833'
                            }).then(() => window.location.reload());
                        } else {
                            luxurySwal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to restore category.'
                            });
                        }
                    } catch (err) {
                        console.error(err);
                        luxurySwal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Network error occurred while restoring.'
                        });
                    }
                }
            });
        }

        // Confirm Toggle Listed / Unlisted status
        function confirmToggleStatus(id, name, isCurrentlyListed) {
            const action = isCurrentlyListed ? 'unlist' : 'list';
            const actionLabel = isCurrentlyListed ? 'Unlist' : 'List';
            const confirmColor = isCurrentlyListed ? '#d97706' : '#059669';

            luxurySwal.fire({
                title: `${actionLabel} Category?`,
                html: `Are you sure you want to <strong>${action}</strong> <strong>"${name}"</strong>?<br><span style="font-size: 13px; color: #a1a1aa;">${isCurrentlyListed ? 'It will be hidden from the store catalog.' : 'It will become visible in the store catalog.'}</span>`,
                icon: 'info',
                iconColor: '#D48833',
                showCancelButton: true,
                confirmButtonText: `Yes, ${actionLabel}`,
                cancelButtonText: 'Cancel',
                confirmButtonColor: confirmColor
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/categories/toggle-status/${id}`, {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json'
                            }
                        });
                        const data = await response.json();
                        if (response.ok && data.success) {
                            luxurySwal.fire({
                                icon: 'success',
                                title: 'Status Updated',
                                text: data.message,
                                confirmButtonText: 'OK',
                                confirmButtonColor: '#D48833'
                            }).then(() => window.location.reload());
                        } else {
                            luxurySwal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to update category status.'
                            });
                        }
                    } catch (err) {
                        console.error(err);
                        luxurySwal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Network error occurred.'
                        });
                    }
                }
            });
        }
    </script>
</body>

</html>
