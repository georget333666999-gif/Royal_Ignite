<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Vault & Stock Governance — ROYAL IGNITE Admin' %></title>
    <link rel="stylesheet" href="/css/admin/inventoryList.css" />

    <!-- SweetAlert2 for Instant Stock Replenishment -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .royal-luxury-swal {
            background: #141312 !important;
            border: 1px solid rgba(212, 136, 51, 0.28) !important;
            border-radius: 16px !important;
            padding: 26px 22px !important;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75) !important;
            color: #f0ece6 !important;
            font-family: 'Instrument Sans', sans-serif !important;
        }
        .royal-swal-title {
            font-family: 'DM Serif Display', serif !important;
            color: #ffffff !important;
            font-size: 22px !important;
            letter-spacing: 0.3px !important;
            margin-bottom: 8px !important;
        }
        .royal-swal-confirm-btn {
            border-radius: 8px !important;
            font-weight: 600 !important;
            font-size: 13px !important;
            padding: 10px 22px !important;
            background: #D48833 !important;
            color: #ffffff !important;
            border: none !important;
            cursor: pointer !important;
        }
        .royal-swal-cancel-btn {
            border-radius: 8px !important;
            font-weight: 500 !important;
            font-size: 13px !important;
            padding: 10px 20px !important;
            background: #27272a !important;
            color: #d4d4d8 !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            cursor: pointer !important;
        }
    </style>
</head>

<body>

    <!-- Left Sidebar Navigation -->
    <aside class="sidebar">
        <div>
            <div class="sidebar-header">
                <a href="/admin/dashboard" class="sidebar-logo">ROYAL IGNITE</a>
            </div>

            <!-- Overview Section -->
            <div class="nav-section">
                <div class="nav-section-title">Overview</div>
                <ul class="nav-links">
                    <li>
                        <a href="/admin/dashboard" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                            <span class="nav-text">Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/analytics" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                <line x1="6" y1="20" x2="6" y2="14"></line>
                            </svg>
                            <span class="nav-text">Analytics</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Management Section -->
            <div class="nav-section">
                <div class="nav-section-title">Management</div>
                <ul class="nav-links">
                    <li>
                        <a href="/admin/categories" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                            <span class="nav-text">Categories</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/products" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            </svg>
                            <span class="nav-text">Products</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/inventory" class="nav-link active">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                <line x1="12" y1="22.08" x2="12" y2="12"></line>
                            </svg>
                            <span class="nav-text">Inventory</span>
                            <% if (typeof metrics !== 'undefined' && metrics.lowStockCount > 0) { %>
                                <span style="margin-left: auto; font-size: 11px; background: #F59E0B; color: #fff; padding: 2px 7px; border-radius: 10px;"><%= metrics.lowStockCount %></span>
                            <% } %>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/users" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            <span class="nav-text">Customers</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/orders" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            <span class="nav-text">Orders</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div>
            <form action="/admin/logout" method="POST">
                <button type="submit" class="btn-logout">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span class="nav-text">Sign Out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="main-wrapper">

        <!-- Top Navbar Header -->
        <header class="top-navbar">
            <div class="top-navbar-title">
                <span>Atelier Vault</span>
                <span style="font-size: 13px; font-weight: 500; color: var(--text-muted);">/ Stock Governance</span>
            </div>
            <div class="top-navbar-right">
                <div class="avatar-circle">
                    <%= typeof adminUser !== 'undefined' && adminUser.username ? adminUser.username.charAt(0).toUpperCase() : 'A' %>
                </div>
            </div>
        </header>

        <div class="content-padding">

            <!-- Alerts -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert-box alert-success">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                    <span><%= success %></span>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-box alert-error">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <!-- Metrics Cards Grid -->
            <% if (typeof metrics !== 'undefined' && metrics) { %>
                <section class="metrics-grid">
                    <div class="metric-card">
                        <div class="metric-header">
                            <span class="metric-title">Vault Total Units</span>
                            <div class="metric-badge total">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                            </div>
                        </div>
                        <span class="metric-val"><%= Number(metrics.totalUnits || 0).toLocaleString('en-IN') %></span>
                        <span class="metric-sub">Across <%= metrics.totalProducts || 0 %> creations</span>
                    </div>

                    <div class="metric-card">
                        <div class="metric-header">
                            <span class="metric-title">Healthy Inventory</span>
                            <div class="metric-badge healthy">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </div>
                        </div>
                        <span class="metric-val" style="color: var(--stock-healthy);"><%= metrics.healthyStockCount || 0 %></span>
                        <span class="metric-sub">Over 5 pieces in reserve</span>
                    </div>

                    <div class="metric-card">
                        <div class="metric-header">
                            <span class="metric-title">Low Stock Alert</span>
                            <div class="metric-badge low">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            </div>
                        </div>
                        <span class="metric-val" style="color: var(--stock-low);"><%= metrics.lowStockCount || 0 %></span>
                        <span class="metric-sub">Critical: 1–5 pieces remaining</span>
                    </div>

                    <div class="metric-card">
                        <div class="metric-header">
                            <span class="metric-title">Depleted Vault</span>
                            <div class="metric-badge out">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                            </div>
                        </div>
                        <span class="metric-val" style="color: var(--stock-out);"><%= metrics.outOfStockCount || 0 %></span>
                        <span class="metric-sub">Zero inventory pieces</span>
                    </div>
                </section>
            <% } %>

            <!-- Search, Filter & Sort Toolbar -->
            <section class="toolbar-card">
                <form action="/admin/inventory" method="GET" id="inventoryFilterForm">
                    <div class="toolbar-row">
                        <!-- Search Box -->
                        <div class="search-box-wrapper">
                            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input type="text" 
                                   name="search" 
                                   value="<%= typeof search !== 'undefined' ? search : '' %>" 
                                   placeholder="Search edition title..." 
                                   class="search-input" />
                        </div>

                        <!-- Dropdowns -->
                        <div class="controls-group">
                            <!-- Category Filter -->
                            <select name="category" class="filter-select" onchange="this.form.submit()">
                                <option value="all" <%= (!categoryId || categoryId === 'all') ? 'selected' : '' %>>All Categories</option>
                                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                                    <% categories.forEach(function(cat) { %>
                                        <option value="<%= cat._id %>" <%= String(categoryId) === String(cat._id) ? 'selected' : '' %>><%= cat.name %></option>
                                    <% }); %>
                                <% } %>
                            </select>

                            <!-- Stock Filter -->
                            <select name="stockFilter" class="filter-select" onchange="this.form.submit()">
                                <option value="all" <%= (!stockFilter || stockFilter === 'all') ? 'selected' : '' %>>All Stock Levels</option>
                                <option value="lowStock" <%= stockFilter === 'lowStock' ? 'selected' : '' %>>Low Stock Alert (&le; 5)</option>
                                <option value="outOfStock" <%= stockFilter === 'outOfStock' ? 'selected' : '' %>>Out of Stock (0)</option>
                                <option value="inStock" <%= stockFilter === 'inStock' ? 'selected' : '' %>>Healthy Stock (&gt; 5)</option>
                            </select>

                            <!-- Sort -->
                            <select name="sort" class="filter-select" onchange="this.form.submit()">
                                <option value="stock_asc" <%= (!sort || sort === 'stock_asc') ? 'selected' : '' %>>Stock: Low to High (Default)</option>
                                <option value="stock_desc" <%= sort === 'stock_desc' ? 'selected' : '' %>>Stock: High to Low</option>
                                <option value="name_asc" <%= sort === 'name_asc' ? 'selected' : '' %>>Title: A to Z</option>
                                <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Date: Newest First</option>
                            </select>

                            <button type="submit" class="btn-filter-apply">Filter</button>

                            <a href="/admin/inventory" class="btn-filter-clear" title="Reset all inventory filters">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                                <span>Clear</span>
                            </a>
                        </div>
                    </div>
                </form>

                <!-- Quick Filter Pills -->
                <% 
                    const buildPillUrl = (sf) => {
                        const p = new URLSearchParams();
                        if (sf && sf !== 'all') p.set('stockFilter', sf);
                        if (search) p.set('search', search);
                        if (categoryId && categoryId !== 'all') p.set('category', categoryId);
                        if (sort && sort !== 'stock_asc') p.set('sort', sort);
                        return '/admin/inventory?' + p.toString();
                    };
                    const activeSf = stockFilter || 'all';
                %>
                <div class="filter-pills-row">
                    <span style="font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Stock Filter:</span>
                    <a href="<%= buildPillUrl('all') %>" class="status-pill <%= activeSf === 'all' ? 'active' : '' %>">All Editions (<%= metrics ? metrics.totalProducts : products.length %>)</a>
                    <a href="<%= buildPillUrl('lowStock') %>" class="status-pill <%= activeSf === 'lowStock' ? 'active' : '' %>">Low Stock Alert (<%= metrics ? metrics.lowStockCount : 0 %>)</a>
                    <a href="<%= buildPillUrl('outOfStock') %>" class="status-pill <%= activeSf === 'outOfStock' ? 'active' : '' %>">Out of Stock (<%= metrics ? metrics.outOfStockCount : 0 %>)</a>
                    <a href="<%= buildPillUrl('inStock') %>" class="status-pill <%= activeSf === 'inStock' ? 'active' : '' %>">Healthy Stock (<%= metrics ? metrics.healthyStockCount : 0 %>)</a>
                </div>
            </section>

            <!-- Inventory Items Table -->
            <section class="table-card">
                <table class="inventory-table">
                    <thead>
                        <tr>
                            <th>Edition & Details</th>
                            <th>Category</th>
                            <th>Pricing</th>
                            <th>Stock Health & Level</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (Array.isArray(products) && products.length > 0) { %>
                            <% products.forEach(function(product) { %>
                                <% 
                                    const thumb = (product.images && product.images.length > 0) ? product.images[0] : '/images/placeholder-product.png';
                                    let badgeClass = 'healthy';
                                    let badgeLabel = `${product.stock} in stock`;
                                    let barWidth = Math.min(100, (product.stock / 20) * 100);

                                    if (product.stock <= 0) {
                                        badgeClass = 'out';
                                        badgeLabel = 'Depleted (0)';
                                        barWidth = 0;
                                    } else if (product.stock <= 5) {
                                        badgeClass = 'low';
                                        badgeLabel = `Low Stock (${product.stock})`;
                                    }
                                %>
                                <tr id="inventory-row-<%= product._id %>">
                                    <!-- Product Info -->
                                    <td>
                                        <div class="product-info-cell">
                                            <div class="product-thumb-sm">
                                                <img src="<%= thumb %>" alt="<%= product.name %>" onerror="this.src='/images/placeholder-product.png'" />
                                            </div>
                                            <div class="product-text-meta">
                                                <a href="/products/<%= product._id %>" class="product-title-link" target="_blank">
                                                    <%= product.name %>
                                                </a>
                                                <span class="category-tag"><%= product.category ? product.category.name : 'Royal Ignite Edition' %></span>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Category -->
                                    <td>
                                        <span class="category-tag" style="color: #27272a; font-weight: 600;">
                                            <%= product.category ? product.category.name : '—' %>
                                        </span>
                                    </td>

                                    <!-- Pricing -->
                                    <td>
                                        <div>
                                            <% if (product.salePrice && product.salePrice < product.regularPrice) { %>
                                                <strong style="color: var(--text-dark);">₹<%= Number(product.salePrice).toLocaleString('en-IN') %></strong>
                                                <span style="font-size: 12px; color: var(--text-subtle); text-decoration: line-through; margin-left: 4px;">
                                                    ₹<%= Number(product.regularPrice).toLocaleString('en-IN') %>
                                                </span>
                                            <% } else { %>
                                                <strong style="color: var(--text-dark);">₹<%= Number(product.regularPrice).toLocaleString('en-IN') %></strong>
                                            <% } %>
                                        </div>
                                    </td>

                                    <!-- Stock Health & Visual Meter -->
                                    <td>
                                        <div class="stock-level-cell">
                                            <div class="stock-value-text">
                                                <span><%= product.stock %> units</span>
                                                <span class="stock-badge <%= badgeClass %>"><%= badgeLabel %></span>
                                            </div>
                                            <div class="stock-progress-track">
                                                <div class="stock-progress-bar <%= badgeClass %>" style="width: <%= barWidth %>%;"></div>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Action: Quick Adjust / Replenish Button -->
                                    <td style="text-align: right;">
                                        <button type="button" 
                                                class="btn-quick-adjust" 
                                                onclick="promptAdjustStock('<%= product._id %>', '<%= product.name.replace(/'/g, "\\'") %>', <%= product.stock %>)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                            <span>Quick Adjust</span>
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" style="text-align: center; padding: 48px 24px; color: var(--text-muted);">
                                    <div style="font-size: 16px; font-weight: 600; color: var(--text-dark); margin-bottom: 6px;">No Vault Pieces Found</div>
                                    <div>No items match the current stock filter or search criteria.</div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>

                <!-- Pagination -->
                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                    <% 
                        const buildPageUrl = (p) => {
                            const params = new URLSearchParams();
                            if (search) params.set('search', search);
                            if (categoryId && categoryId !== 'all') params.set('category', categoryId);
                            if (stockFilter && stockFilter !== 'all') params.set('stockFilter', stockFilter);
                            if (sort && sort !== 'stock_asc') params.set('sort', sort);
                            params.set('page', p);
                            return '/admin/inventory?' + params.toString();
                        };
                    %>
                    <div class="pagination-wrapper">
                        <span>
                            Showing <%= ((currentPage - 1) * limit) + 1 %>–<%= Math.min(currentPage * limit, totalMatching) %> of <%= totalMatching %> editions
                        </span>

                        <div class="pagination-controls">
                            <a href="<%= buildPageUrl(currentPage - 1) %>" class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>">←</a>
                            <% for (let p = 1; p <= totalPages; p++) { %>
                                <a href="<%= buildPageUrl(p) %>" class="page-btn <%= currentPage === p ? 'active' : '' %>"><%= p %></a>
                            <% } %>
                            <a href="<%= buildPageUrl(currentPage + 1) %>" class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>">→</a>
                        </div>
                    </div>
                <% } %>
            </section>

        </div>
    </main>

    <!-- Quick Stock Adjustment Modal Script -->
    <script>
        function promptAdjustStock(productId, productName, currentStock) {
            Swal.fire({
                title: 'Adjust Vault Inventory',
                html: `
                    <div style="text-align: left; margin-bottom: 12px; font-size: 13.5px; color: #a1a1aa;">
                        Updating stock for: <strong style="color: #ffffff;">${productName}</strong><br>
                        Current Vault Count: <strong style="color: #D48833;">${currentStock} units</strong>
                    </div>

                    <div style="display: flex; gap: 8px; margin-bottom: 14px;">
                        <button type="button" onclick="document.getElementById('stockInputVal').value = ${currentStock} + 5" style="flex: 1; padding: 7px; border-radius: 6px; background: #27272a; color: #ffffff; border: 1px solid #3f3f46; font-size: 12px; cursor: pointer;">+5 units</button>
                        <button type="button" onclick="document.getElementById('stockInputVal').value = ${currentStock} + 10" style="flex: 1; padding: 7px; border-radius: 6px; background: #27272a; color: #ffffff; border: 1px solid #3f3f46; font-size: 12px; cursor: pointer;">+10 units</button>
                        <button type="button" onclick="document.getElementById('stockInputVal').value = ${currentStock} + 25" style="flex: 1; padding: 7px; border-radius: 6px; background: #27272a; color: #ffffff; border: 1px solid #3f3f46; font-size: 12px; cursor: pointer;">+25 units</button>
                        <button type="button" onclick="document.getElementById('stockInputVal').value = ${currentStock} + 50" style="flex: 1; padding: 7px; border-radius: 6px; background: #27272a; color: #ffffff; border: 1px solid #3f3f46; font-size: 12px; cursor: pointer;">+50 units</button>
                    </div>

                    <div style="text-align: left; margin-bottom: 6px; font-size: 12.5px; color: #d4d4d8;">New Total Stock Level:</div>
                    <input id="stockInputVal" 
                           type="number" 
                           min="0" 
                           value="${currentStock}" 
                           style="width: 100%; height: 42px; border-radius: 8px; border: 1px solid #3f3f46; background: #1f1f23; color: #ffffff; padding: 0 12px; font-size: 15px; font-weight: 600;" />
                `,
                icon: 'info',
                iconColor: '#D48833',
                showCancelButton: true,
                confirmButtonText: 'Save New Stock',
                cancelButtonText: 'Cancel',
                customClass: {
                    popup: 'royal-luxury-swal',
                    title: 'royal-swal-title',
                    confirmButton: 'royal-swal-confirm-btn',
                    cancelButton: 'royal-swal-cancel-btn'
                },
                preConfirm: () => {
                    const stock = document.getElementById('stockInputVal').value;
                    if (stock === '' || isNaN(stock) || parseInt(stock, 10) < 0) {
                        Swal.showValidationMessage('Please provide a valid non-negative stock quantity');
                        return false;
                    }
                    return parseInt(stock, 10);
                }
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const newStock = result.value;
                    try {
                        const response = await fetch(`/admin/inventory/${productId}/stock`, {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json',
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ stock: newStock, mode: 'set' })
                        });

                        const data = await response.json();

                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Stock Updated',
                                text: data.message || `Inventory updated to ${newStock} units.`,
                                background: '#141312',
                                color: '#f0ece6',
                                confirmButtonColor: '#D48833'
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Notice',
                                text: data.message || 'Unable to update stock quantity.',
                                background: '#141312',
                                color: '#f0ece6',
                                confirmButtonColor: '#D48833'
                            });
                        }
                    } catch (err) {
                        console.error('Update stock error:', err);
                        Swal.fire({
                            icon: 'error',
                            title: 'Network Error',
                            text: 'Failed to communicate with inventory service.',
                            background: '#141312',
                            color: '#f0ece6',
                            confirmButtonColor: '#D48833'
                        });
                    }
                }
            });
        }
    </script>

</body>
</html>
