<link rel="stylesheet" href="/css/admin/sidebar.css" />

<%
    const curPage = typeof activePage !== 'undefined' ? activePage : '';
    const catBadge = typeof totalCategories !== 'undefined' ? totalCategories : (typeof sidebarCounts !== 'undefined' && sidebarCounts.totalCategories !== undefined ? sidebarCounts.totalCategories : 4);
    const prodBadge = typeof totalProducts !== 'undefined' ? totalProducts : (typeof sidebarCounts !== 'undefined' && sidebarCounts.totalProducts !== undefined ? sidebarCounts.totalProducts : 25);
    const userBadge = typeof totalUsers !== 'undefined' ? totalUsers : (typeof sidebarCounts !== 'undefined' && sidebarCounts.totalUsers !== undefined ? sidebarCounts.totalUsers : 35);
%>

<!-- Universal Left Sidebar Navigation (Executive Suite Styling) -->
<aside class="sidebar">
    <div class="sidebar-top">
        <!-- Brand Identity -->
        <div class="sidebar-header">
            <a href="/admin/dashboard" class="sidebar-brand">
                <div class="brand-emblem-badge">
                    <svg class="emblem-flame-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                        <defs>
                            <linearGradient id="sidebarFlameGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" stop-color="#fbc275" />
                                <stop offset="100%" stop-color="#d48833" />
                            </linearGradient>
                        </defs>
                        <path fill="url(#sidebarFlameGrad)" d="M12 2.5C11.2 5.8 8.5 8.3 8.5 11.8C8.5 14.2 9.9 16.1 11.2 17C10.7 15.3 11.3 13.8 12.3 12.7C13.2 14.2 14.8 15.4 14.8 17.5C14.8 19.4 13.5 21 12 21.8C16.8 21.2 19.5 17.2 19.5 13.2C19.5 7.8 14.2 4.8 12 2.5Z"/>
                    </svg>
                </div>
                <div class="brand-text-col">
                    <span class="sidebar-logo">ROYAL IGNITE</span>
                    <span class="sidebar-suite-tag">ADMINISTRATION</span>
                </div>
            </a>
        </div>

        <!-- Overview Section -->
        <div class="nav-section">
            <div class="nav-section-title">Overview</div>
            <ul class="nav-links">
                <li>
                    <a href="/admin/dashboard" class="nav-link <%= curPage === 'dashboard' ? 'active' : '' %>">
                        <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                        </svg>
                        <span class="nav-text">Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/analytics" class="nav-link <%= curPage === 'analytics' ? 'active' : '' %>">
                        <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <line x1="18" y1="20" x2="18" y2="10"></line>
                            <line x1="12" y1="20" x2="12" y2="4"></line>
                            <line x1="6" y1="20" x2="6" y2="14"></line>
                        </svg>
                        <span class="nav-text">Analytics</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/reports/sales" class="nav-link <%= curPage === 'salesReports' ? 'active' : '' %>">
                        <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        <span class="nav-text">Sales Reports</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Management Section -->
        <div class="nav-section">
            <div class="nav-section-title">Management</div>
            <ul class="nav-links">
                <li>
                    <a href="/admin/categories" class="nav-link <%= curPage === 'categories' ? 'active' : '' %>">
                        <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span class="nav-text">Categories</span>
                        <span class="badge-count"><%= catBadge %></span>
                    </a>
                </li>
                <li>
                    <a href="/admin/products" class="nav-link <%= curPage === 'products' ? 'active' : '' %>">
                        <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        </svg>
                        <span class="nav-text">Products</span>
                        <span class="badge-count"><%= prodBadge %></span>
                    </a>
                </li>
                <li>
                    <a href="/admin/users" class="nav-link <%= curPage === 'customers' ? 'active' : '' %>">
                        <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                        </svg>
                        <span class="nav-text">Customers</span>
                        <span class="badge-count"><%= userBadge %></span>
                    </a>
                </li>
                <li>
                    <a href="/admin/orders" class="nav-link <%= curPage === 'orders' ? 'active' : '' %>">
                        <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        <span class="nav-text">Orders</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/offers" class="nav-link <%= curPage === 'offers' ? 'active' : '' %>">
                        <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        <span class="nav-text">Offers</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/coupons" class="nav-link <%= curPage === 'coupons' ? 'active' : '' %>">
                        <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                            <line x1="7" y1="7" x2="7.01" y2="7"></line>
                        </svg>
                        <span class="nav-text">Coupons</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Sidebar Bottom Footer -->
    <div class="sidebar-bottom">
        <div class="admin-profile-card">
            <div class="admin-avatar-box">
                <span class="avatar-letter">A</span>
                <span class="status-pulse-dot" title="Active"></span>
            </div>
            <div class="admin-meta">
                <div class="admin-name">Administrator</div>
                <div class="admin-role">Store Operations</div>
            </div>
        </div>

        <form action="/admin/logout" method="POST" class="logout-form">
            <button type="submit" class="btn-logout" title="Log out">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Log Out</span>
            </button>
        </form>
    </div>
</aside>
