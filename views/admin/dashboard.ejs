<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/admin/dashboard.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="admin-dashboard-page">

    <!-- Left Sidebar Navigation -->
    <%- include('partials/sidebar', { activePage: 'dashboard' }) %>

    <!-- Main Wrapper Area -->
    <div class="main-wrapper">
        
        <!-- Top Navbar Header -->
        <header class="top-navbar">
            <div class="navbar-left">
                <div class="breadcrumb-trail">
                    <span class="crumb-dim">Portal</span>
                    <span class="crumb-sep">/</span>
                    <span class="crumb-active">Dashboard</span>
                </div>
            </div>

            <div class="navbar-right">
                <div class="search-box">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" placeholder="Search orders, customers..." />
                    <span class="kbd-badge">⌘K</span>
                </div>

                <a href="/" target="_blank" class="nav-action-btn" title="Open Storefront">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    <span>Store</span>
                </a>

                <button class="nav-action-btn notification-btn" title="Notifications" aria-label="Notifications">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span class="unread-dot"></span>
                </button>

                <div class="user-pill-badge">
                    <div class="avatar-circle-sm">A</div>
                    <span class="user-pill-name">Admin</span>
                </div>
            </div>
        </header>

        <!-- Main Content Canvas -->
        <main class="content-padding">
            
            <!-- Calm Executive Header -->
            <section class="page-title-row">
                <div>
                    <h1 class="page-title">Dashboard</h1>
                    <p class="page-desc">Overview of today's store activity and order dispatch.</p>
                </div>

                <div class="title-actions">
                    <a href="/admin/analytics" class="link-analytics-quiet">
                        <span>Analytics Hub</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="/admin/products/add" class="btn-primary-obsidian">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        <span>Add Product</span>
                    </a>
                </div>
            </section>

            <!-- 4 Clean, Airy Hero Vital Signs -->
            <section class="serene-kpi-grid">
                
                <div class="serene-card">
                    <div class="serene-card-label">TODAY'S REVENUE</div>
                    <div class="serene-card-value">
                        <span class="currency">₹</span><%= Number(typeof todayRevenue !== 'undefined' ? todayRevenue : 0).toLocaleString('en-IN') %>
                    </div>
                    <div class="serene-card-trend">
                        <span class="trend-green">Active Acquisitions</span>
                        <span class="trend-sub">Live Atelier Revenue</span>
                    </div>
                </div>

                <div class="serene-card">
                    <div class="serene-card-label">ORDERS TODAY</div>
                    <div class="serene-card-value">
                        <%= typeof todayOrdersCount !== 'undefined' ? todayOrdersCount : 0 %> <span class="unit">orders</span>
                    </div>
                    <div class="serene-card-trend">
                        <span class="trend-neutral">Placed Today</span>
                        <span class="trend-sub">Confirmed Queue</span>
                    </div>
                </div>

                <div class="serene-card">
                    <div class="serene-card-label">PENDING DISPATCH</div>
                    <div class="serene-card-value">
                        <%= typeof pendingOrdersCount !== 'undefined' ? pendingOrdersCount : 0 %> <span class="unit">orders</span>
                    </div>
                    <div class="serene-card-trend">
                        <span class="trend-amber">Awaiting fulfillment</span>
                        <span class="trend-sub">Placed / Processing / Shipped</span>
                    </div>
                </div>

                <div class="serene-card">
                    <div class="serene-card-label">TOTAL CUSTOMERS</div>
                    <div class="serene-card-value">
                        <%= typeof totalUsers !== 'undefined' ? totalUsers : 0 %> <span class="unit">users</span>
                    </div>
                    <div class="serene-card-trend">
                        <span class="trend-green">Active Accounts</span>
                        <span class="trend-sub">Client registry</span>
                    </div>
                </div>

            </section>

            <!-- Interactive Analytics Chart Section (Requirement f.i) -->
            <section class="serene-box" style="margin-bottom: 24px; padding: 22px 26px;">
                <div class="box-header" style="margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: #D48833; font-weight: 700; margin-bottom: 4px;">Historical Trajectory</div>
                        <h2 class="box-title" style="margin: 0; font-size: 19px; color: #ffffff;">Revenue & Volume Velocity</h2>
                        <p class="box-sub" style="margin: 2px 0 0 0; color: #71717a; font-size: 12.5px;">Gross sales settlement curve and order volume trends</p>
                    </div>

                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div class="filter-pills-quiet" id="chartFilterGroup" style="display: flex; gap: 4px; background: #0e0e11; padding: 4px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08);">
                            <button class="fpill" type="button" onclick="updateDashboardChart('weekly', this)" style="padding: 6px 14px; font-size: 12px; cursor: pointer; border-radius: 6px; border: none; background: transparent; color: #a1a1aa;">Weekly</button>
                            <button class="fpill active" type="button" onclick="updateDashboardChart('monthly', this)" style="padding: 6px 14px; font-size: 12px; cursor: pointer; border-radius: 6px; border: none; background: #D48833; color: #ffffff; font-weight: 600;">Monthly</button>
                            <button class="fpill" type="button" onclick="updateDashboardChart('yearly', this)" style="padding: 6px 14px; font-size: 12px; cursor: pointer; border-radius: 6px; border: none; background: transparent; color: #a1a1aa;">Yearly</button>
                        </div>
                        <button type="button" onclick="openLedgerModal()" style="padding: 7px 16px; font-size: 12px; border-radius: 6px; border: 1px solid rgba(212, 136, 51, 0.4); color: #F6BD64; background: rgba(212, 136, 51, 0.08); font-weight: 600; cursor: pointer;">
                            Ledger Summary
                        </button>
                    </div>
                </div>

                <div style="position: relative; width: 100%; height: 260px;">
                    <canvas id="dashboardRevenueChart"></canvas>
                </div>
            </section>

            <!-- Top 10 Best Selling Leaderboards (Requirements f.ii, f.iii, f.iv) -->
            <section class="serene-box" style="margin-bottom: 24px; padding: 22px 26px;">
                <div class="box-header" style="margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: #D48833; font-weight: 700; margin-bottom: 4px;">Performance Leaderboards</div>
                        <h2 class="box-title" style="margin: 0; font-size: 19px; color: #ffffff;">Top 10 Best Sellers</h2>
                        <p class="box-sub" style="margin: 2px 0 0 0; color: #71717a; font-size: 12.5px;">Ranked by units acquired and gross volume</p>
                    </div>

                    <div class="filter-pills-quiet" id="leaderboardTabGroup" style="display: flex; gap: 4px; background: #0e0e11; padding: 4px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08);">
                        <button class="fpill active" type="button" id="tabBtnProducts" onclick="switchLeaderboard('products', this)" style="padding: 6px 14px; font-size: 12px; cursor: pointer; border-radius: 6px; border: none; background: #D48833; color: #ffffff; font-weight: 600;">Top 10 Products</button>
                        <button class="fpill" type="button" id="tabBtnCategories" onclick="switchLeaderboard('categories', this)" style="padding: 6px 14px; font-size: 12px; cursor: pointer; border-radius: 6px; border: none; background: transparent; color: #a1a1aa;">Top 10 Categories</button>
                        <button class="fpill" type="button" id="tabBtnBrands" onclick="switchLeaderboard('brands', this)" style="padding: 6px 14px; font-size: 12px; cursor: pointer; border-radius: 6px; border: none; background: transparent; color: #a1a1aa;">Top 10 Brands</button>
                    </div>
                </div>

                <!-- 1. Top 10 Products Panel (f.ii) -->
                <div id="tabPanelProducts" class="table-wrap-clean">
                    <table class="clean-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;">RANK</th>
                                <th>CREATION EDITION</th>
                                <th>COLLECTION</th>
                                <th>UNIT PRICE</th>
                                <th style="text-align: right;">UNITS SOLD</th>
                                <th style="text-align: right;">TOTAL REVENUE</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof topProducts !== 'undefined' && topProducts.length > 0) { %>
                                <% topProducts.forEach(function(prod, idx) { %>
                                    <tr>
                                        <td>
                                            <span style="font-weight: 700; color: <%= idx === 0 ? '#F6BD64' : (idx === 1 ? '#e4e4e7' : (idx === 2 ? '#cd7f32' : '#71717a')) %>; font-size: 13px;">
                                                #<%= idx + 1 %>
                                            </span>
                                        </td>
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                <img src="<%= prod.image || '/uploads/hero_lighter.png' %>" 
                                                     alt="<%= prod.name %>" 
                                                     style="width: 34px; height: 34px; border-radius: 6px; object-fit: cover; border: 1px solid rgba(255,255,255,0.1);" />
                                                <span style="font-weight: 600; color: #ffffff; font-size: 13px;"><%= prod.name %></span>
                                            </div>
                                        </td>
                                        <td style="color: #a1a1aa; font-size: 12.5px;"><%= prod.categoryName || 'Exclusive' %></td>
                                        <td style="color: #d4d4d8; font-size: 13px;">₹<%= Number(prod.unitPrice || 0).toLocaleString('en-IN') %></td>
                                        <td style="text-align: right; font-weight: 700; color: #D48833; font-size: 13.5px;"><%= prod.totalSold %> pcs</td>
                                        <td style="text-align: right; font-weight: 700; color: #ffffff; font-size: 13.5px;">₹<%= Number(prod.totalRevenue || 0).toLocaleString('en-IN') %></td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" style="text-align: center; padding: 24px; color: #71717a;">No product sales recorded yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- 2. Top 10 Categories Panel (f.iii) -->
                <div id="tabPanelCategories" class="table-wrap-clean" style="display: none;">
                    <table class="clean-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;">RANK</th>
                                <th>CATEGORY / COLLECTION</th>
                                <th style="text-align: right;">ORDERS COUNT</th>
                                <th style="text-align: right;">UNITS SOLD</th>
                                <th style="text-align: right;">TOTAL REVENUE</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof topCategories !== 'undefined' && topCategories.length > 0) { %>
                                <% topCategories.forEach(function(cat, idx) { %>
                                    <tr>
                                        <td>
                                            <span style="font-weight: 700; color: <%= idx === 0 ? '#F6BD64' : '#71717a' %>; font-size: 13px;">
                                                #<%= idx + 1 %>
                                            </span>
                                        </td>
                                        <td style="font-weight: 600; color: #ffffff; font-size: 13px;"><%= cat.categoryName || 'Exclusive Collection' %></td>
                                        <td style="text-align: right; color: #a1a1aa; font-size: 12.5px;"><%= cat.orderCount || 1 %> orders</td>
                                        <td style="text-align: right; font-weight: 700; color: #D48833; font-size: 13.5px;"><%= cat.totalSold %> pcs</td>
                                        <td style="text-align: right; font-weight: 700; color: #ffffff; font-size: 13.5px;">₹<%= Number(cat.totalRevenue || 0).toLocaleString('en-IN') %></td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" style="text-align: center; padding: 24px; color: #71717a;">No category sales recorded yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- 3. Top 10 Brands Panel (f.iv) -->
                <div id="tabPanelBrands" class="table-wrap-clean" style="display: none;">
                    <table class="clean-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;">RANK</th>
                                <th>BRAND / ATELIER LINE</th>
                                <th style="text-align: right;">UNITS SOLD</th>
                                <th style="text-align: right;">TOTAL REVENUE</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof topBrands !== 'undefined' && topBrands.length > 0) { %>
                                <% topBrands.forEach(function(br, idx) { %>
                                    <tr>
                                        <td>
                                            <span style="font-weight: 700; color: <%= idx === 0 ? '#F6BD64' : '#71717a' %>; font-size: 13px;">
                                                #<%= idx + 1 %>
                                            </span>
                                        </td>
                                        <td style="font-weight: 600; color: #ffffff; font-size: 13px;"><%= br.brandName || 'Royal Heritage Edition' %></td>
                                        <td style="text-align: right; font-weight: 700; color: #D48833; font-size: 13.5px;"><%= br.totalSold %> pcs</td>
                                        <td style="text-align: right; font-weight: 700; color: #ffffff; font-size: 13.5px;">₹<%= Number(br.totalRevenue || 0).toLocaleString('en-IN') %></td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" style="text-align: center; padding: 24px; color: #71717a;">No brand sales recorded yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Calm 2-Column Primary Workspace -->
            <div class="dashboard-split-layout">
                
                <!-- Left Area: Recent Orders (68%) -->
                <div class="split-main">
                    <div class="serene-box">
                        <div class="box-header">
                            <div>
                                <h2 class="box-title">Recent Orders</h2>
                                <p class="box-sub">Latest customer transactions and dispatch queue</p>
                            </div>

                            <a href="/admin/orders" class="fpill" style="text-decoration: none; font-size: 12px; color: #F6BD64; background: rgba(246, 189, 100, 0.1); border: 1px solid rgba(246, 189, 100, 0.3);">
                                View All Orders &rarr;
                            </a>
                        </div>

                        <div class="table-wrap-clean">
                            <table class="clean-table">
                                <thead>
                                    <tr>
                                        <th>ORDER</th>
                                        <th>CUSTOMER</th>
                                        <th>ITEMS</th>
                                        <th>TOTAL</th>
                                        <th>STATUS</th>
                                        <th class="text-right">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (typeof recentOrders !== 'undefined' && recentOrders.length > 0) { %>
                                        <% recentOrders.forEach(function(ord) { %>
                                            <tr>
                                                <td class="order-cell">
                                                    <a href="/admin/orders/<%= ord.orderId %>" style="color: #F6BD64; text-decoration: none; font-weight: 600;">
                                                        #<%= ord.orderId %>
                                                    </a>
                                                </td>
                                                <td>
                                                    <div class="cust-flex">
                                                        <span class="cust-avatar-sm">
                                                            <%= ord.shippingAddress?.fullName ? ord.shippingAddress.fullName.charAt(0).toUpperCase() : (ord.user?.name ? ord.user.name.charAt(0).toUpperCase() : 'C') %>
                                                        </span>
                                                        <span class="cust-name-text"><%= ord.shippingAddress?.fullName || ord.user?.name || 'Valued Client' %></span>
                                                    </div>
                                                </td>
                                                <td class="prod-text">
                                                    <%= (ord.items && ord.items[0]) ? ord.items[0].name : 'Creation' %>
                                                    <% if (ord.items && ord.items.length > 1) { %>
                                                        <small style="color: #71717a;">(+<%= ord.items.length - 1 %> more)</small>
                                                    <% } %>
                                                </td>
                                                <td class="amount-text">₹<%= Number(ord.pricing?.totalAmount || 0).toLocaleString('en-IN') %></td>
                                                <td>
                                                    <% const ordStatusClass = (ord.orderStatus || 'placed').toLowerCase().replace(/\s+/g, '-'); %>
                                                    <span class="dot-status-pill status-<%= ordStatusClass === 'delivered' ? 'green' : (ordStatusClass === 'cancelled' ? 'rose' : 'amber') %>">
                                                        <span class="dot"></span>
                                                        <%= ord.orderStatus %>
                                                    </span>
                                                </td>
                                                <td class="text-right">
                                                    <a href="/admin/orders/<%= ord.orderId %>" class="btn-quiet-action" style="text-decoration: none;">View</a>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" style="text-align: center; padding: 24px; color: #71717a;">No orders received yet.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <div class="box-footer-link">
                            <a href="/admin/orders" class="text-link-quiet">Go to complete order dispatch & trajectory &rarr;</a>
                        </div>
                    </div>
                </div>

                <!-- Right Area: Quiet Operational Pulse & Tasks (32%) -->
                <div class="split-side">
                    
                    <!-- Attention Required Card -->
                    <div class="serene-box">
                        <div class="box-header-compact">
                            <h3 class="box-subtitle">Attention Required</h3>
                            <span class="badge-mini">2 items</span>
                        </div>

                        <div class="task-list-quiet">
                            <a href="#orders" class="task-item">
                                <div class="task-dot amber"></div>
                                <div class="task-content">
                                    <span class="task-name">14 Orders Awaiting Dispatch</span>
                                    <span class="task-meta">Awaiting fulfillment & tracking assignment</span>
                                </div>
                                <span class="task-arrow">&rarr;</span>
                            </a>

                            <a href="#" class="task-item">
                                <div class="task-dot rose"></div>
                                <div class="task-content">
                                    <span class="task-name">3 Models Low on Stock</span>
                                    <span class="task-meta">The Royal Monarch Gold (4 units remaining)</span>
                                </div>
                                <span class="task-arrow">&rarr;</span>
                            </a>
                        </div>
                    </div>

                    <!-- Quick Tools -->
                    <div class="serene-box">
                        <div class="box-header-compact">
                            <h3 class="box-subtitle">Quick Actions</h3>
                        </div>

                        <div class="shortcuts-list">
                            <a href="#" class="shortcut-link">
                                <span class="shortcut-name">+ Add New Product</span>
                                <span class="shortcut-tag">Catalog</span>
                            </a>
                            <a href="#" class="shortcut-link">
                                <span class="shortcut-name">Create Discount Coupon</span>
                                <span class="shortcut-tag">Marketing</span>
                            </a>
                            <a href="/admin/users" class="shortcut-link">
                                <span class="shortcut-name">Customer Directory</span>
                                <span class="shortcut-tag">Users</span>
                            </a>
                            <a href="/admin/analytics" class="shortcut-link highlight">
                                <span class="shortcut-name">View Analytics & Reports</span>
                                <span class="shortcut-tag">Insights &rarr;</span>
                            </a>
                        </div>
                    </div>

                    <!-- Infrastructure Status Pill -->
                    <div class="serene-box system-status-card">
                        <div class="status-indicator-flex">
                            <span class="live-dot-green"></span>
                            <span class="status-msg">All store services operational</span>
                        </div>
                        <div class="status-sub">Gateway, database, and notifications online</div>
                    </div>

                </div>

            </div>

        </main>

        <!-- Minimalist Footer -->
        <footer class="serene-footer">
            <span>ROYAL IGNITE &bull; Admin Operations</span>
            <a href="/admin/analytics">Analytics & Business Intelligence &rarr;</a>
        </footer>

    </div>

    <!-- Ledger Book Summary Modal (Requirement f.v) -->
    <div id="ledgerModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(4px); z-index: 1000; align-items: center; justify-content: center; padding: 20px;">
        <div style="background: #141312; border: 1px solid rgba(212, 136, 51, 0.35); border-radius: 16px; width: 100%; max-width: 600px; max-height: 85vh; overflow-y: auto; padding: 28px; box-shadow: 0 25px 60px rgba(0,0,0,0.85); color: #f0ece6;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 14px;">
                <h3 style="margin: 0; font-family: 'DM Serif Display', serif; font-size: 20px; color: #ffffff; display: flex; align-items: center; gap: 8px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D48833" stroke-width="2">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                    </svg>
                    Atelier Ledger Book Summary
                </h3>
                <button type="button" onclick="closeLedgerModal()" style="background: transparent; border: none; color: #71717a; font-size: 22px; cursor: pointer;">&times;</button>
            </div>

            <div id="ledgerModalBody">
                <div style="text-align: center; padding: 30px; color: #a1a1aa;">Loading certified ledger book...</div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.08);">
                <a href="/admin/reports/sales?period=yearly" style="font-size: 12.5px; color: #D48833; text-decoration: none; font-weight: 600;">Full Financial Dossier &rarr;</a>
                <button type="button" onclick="closeLedgerModal()" style="background: #27272a; color: #d4d4d8; border: 1px solid rgba(255,255,255,0.1); padding: 8px 18px; border-radius: 6px; font-size: 13px; cursor: pointer;">Close</button>
            </div>
        </div>
    </div>

    <script>
        let revenueChart = null;
        const initialChartData = <%- JSON.stringify(typeof chartData !== 'undefined' ? chartData : { labels: [], revenues: [], orderCounts: [] }) %>;

        function renderRevenueChart(data) {
            const canvas = document.getElementById('dashboardRevenueChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (revenueChart) {
                revenueChart.destroy();
            }

            const goldGradient = ctx.createLinearGradient(0, 0, 0, 240);
            goldGradient.addColorStop(0, 'rgba(212, 136, 51, 0.35)');
            goldGradient.addColorStop(1, 'rgba(212, 136, 51, 0.0)');

            revenueChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: data.labels,
                    datasets: [
                        {
                            label: 'Revenue (₹)',
                            data: data.revenues,
                            borderColor: '#D48833',
                            backgroundColor: goldGradient,
                            borderWidth: 2.5,
                            fill: true,
                            tension: 0.35,
                            pointBackgroundColor: '#F6BD64',
                            pointBorderColor: '#0E0E12',
                            pointHoverRadius: 6,
                            pointRadius: data.labels.length > 20 ? 1 : 4,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Orders Volume',
                            data: data.orderCounts,
                            borderColor: '#60a5fa',
                            backgroundColor: 'transparent',
                            borderWidth: 1.5,
                            borderDash: [4, 4],
                            tension: 0.35,
                            pointRadius: 0,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: true,
                            labels: {
                                color: '#a1a1aa',
                                font: { size: 11, family: "'Instrument Sans', sans-serif" }
                            }
                        },
                        tooltip: {
                            backgroundColor: '#141312',
                            borderColor: 'rgba(212, 136, 51, 0.4)',
                            borderWidth: 1,
                            titleColor: '#ffffff',
                            bodyColor: '#f0ece6',
                            callbacks: {
                                label: function(context) {
                                    if (context.datasetIndex === 0) {
                                        return `Revenue: ₹${Number(context.raw || 0).toLocaleString('en-IN')}`;
                                    }
                                    return `Volume: ${context.raw} orders`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(255, 255, 255, 0.04)' },
                            ticks: { color: '#71717a', font: { size: 10.5 } }
                        },
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            grid: { color: 'rgba(255, 255, 255, 0.04)' },
                            ticks: {
                                color: '#a1a1aa',
                                font: { size: 10.5 },
                                callback: function(val) {
                                    return '₹' + Number(val).toLocaleString('en-IN');
                                }
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: false,
                            position: 'right',
                            grid: { drawOnChartArea: false }
                        }
                    }
                }
            });
        }

        async function updateDashboardChart(filter, btn) {
            document.querySelectorAll('#chartFilterGroup .fpill').forEach(b => {
                b.classList.remove('active');
                b.style.background = 'transparent';
                b.style.color = '#a1a1aa';
                b.style.fontWeight = 'normal';
            });
            if (btn) {
                btn.classList.add('active');
                btn.style.background = '#D48833';
                btn.style.color = '#ffffff';
                btn.style.fontWeight = '600';
            }

            try {
                const response = await fetch(`/admin/dashboard/chart-data?filter=${filter}`);
                const data = await response.json();
                if (data.success) {
                    renderRevenueChart(data);
                }
            } catch (err) {
                console.error('Update chart error:', err);
            }
        }

        function switchLeaderboard(type, btn) {
            document.querySelectorAll('#leaderboardTabGroup .fpill').forEach(b => {
                b.classList.remove('active');
                b.style.background = 'transparent';
                b.style.color = '#a1a1aa';
                b.style.fontWeight = 'normal';
            });
            if (btn) {
                btn.classList.add('active');
                btn.style.background = '#D48833';
                btn.style.color = '#ffffff';
                btn.style.fontWeight = '600';
            }

            const pProducts = document.getElementById('tabPanelProducts');
            const pCategories = document.getElementById('tabPanelCategories');
            const pBrands = document.getElementById('tabPanelBrands');

            if (pProducts) pProducts.style.display = (type === 'products') ? 'block' : 'none';
            if (pCategories) pCategories.style.display = (type === 'categories') ? 'block' : 'none';
            if (pBrands) pBrands.style.display = (type === 'brands') ? 'block' : 'none';
        }

        async function openLedgerModal() {
            const modal = document.getElementById('ledgerModal');
            modal.style.display = 'flex';

            try {
                const res = await fetch('/admin/dashboard/ledger', {
                    headers: { 'Accept': 'application/json' }
                });
                const data = await res.json();
                if (data.success && data.ledger) {
                    const l = data.ledger;
                    document.getElementById('ledgerModalBody').innerHTML = `
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 20px;">
                            <div style="background: #0e0e11; border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 14px;">
                                <div style="font-size: 11px; text-transform: uppercase; color: #a1a1aa; font-weight: 600;">Total Gross Sales</div>
                                <div style="font-size: 18px; font-weight: 700; color: #ffffff; margin-top: 4px;">₹${Number(l.totalGrossRevenue).toLocaleString('en-IN')}</div>
                                <div style="font-size: 11px; color: #71717a; margin-top: 2px;">${l.ordersCount} acquisitions</div>
                            </div>
                            <div style="background: #0e0e11; border: 1px solid rgba(246, 189, 100, 0.3); border-radius: 10px; padding: 14px;">
                                <div style="font-size: 11px; text-transform: uppercase; color: #F6BD64; font-weight: 600;">Net Settled Revenue</div>
                                <div style="font-size: 18px; font-weight: 700; color: #F6BD64; margin-top: 4px;">₹${Number(l.totalNetSales).toLocaleString('en-IN')}</div>
                                <div style="font-size: 11px; color: #71717a; margin-top: 2px;">Bank & wallet verified</div>
                            </div>
                            <div style="background: #0e0e11; border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 14px;">
                                <div style="font-size: 11px; text-transform: uppercase; color: #10b981; font-weight: 600;">Coupon Deductions</div>
                                <div style="font-size: 16px; font-weight: 700; color: #10b981; margin-top: 4px;">− ₹${Number(l.couponDeductions).toLocaleString('en-IN')}</div>
                                <div style="font-size: 11px; color: #71717a; margin-top: 2px;">Voucher privileges</div>
                            </div>
                            <div style="background: #0e0e11; border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 14px;">
                                <div style="font-size: 11px; text-transform: uppercase; color: #f59e0b; font-weight: 600;">Wallet Settlements</div>
                                <div style="font-size: 16px; font-weight: 700; color: #f59e0b; margin-top: 4px;">₹${Number(l.walletSettlementsUsed).toLocaleString('en-IN')}</div>
                                <div style="font-size: 11px; color: #71717a; margin-top: 2px;">Debited at checkout</div>
                            </div>
                        </div>

                        <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: #a1a1aa; margin-bottom: 8px;">Recent Journal Settlements</div>
                        <div style="max-height: 200px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.08); border-radius: 8px;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                                <tbody>
                                    ${(l.recentEntries || []).map(e => `
                                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
                                            <td style="padding: 8px 12px; color: #F6BD64;">#${e.orderId}</td>
                                            <td style="padding: 8px 12px; color: #a1a1aa;">${new Date(e.createdAt).toLocaleDateString('en-IN')}</td>
                                            <td style="padding: 8px 12px; color: #d4d4d8;">${e.paymentMethod}</td>
                                            <td style="padding: 8px 12px; text-align: right; font-weight: 600; color: #ffffff;">₹${Number(e.pricing?.totalAmount || 0).toLocaleString('en-IN')}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    `;
                }
            } catch (err) {
                document.getElementById('ledgerModalBody').innerHTML = `<div style="color: #ef4444; padding: 20px;">Failed to load ledger summary.</div>`;
            }
        }

        function closeLedgerModal() {
            document.getElementById('ledgerModal').style.display = 'none';
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderRevenueChart(initialChartData);
        });
    </script>

</body>

</html>
