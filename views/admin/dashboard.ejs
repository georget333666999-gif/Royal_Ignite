<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/admin/dashboard.css" />
</head>

<body class="admin-dashboard-page">

    <!-- Left Sidebar Navigation (Preserving all sections with quiet luxury styling) -->
    <aside class="sidebar">
        <div class="sidebar-top">
            <!-- Brand Identity -->
            <div class="sidebar-header">
                <a href="/admin/dashboard" class="sidebar-brand">
                    <div class="brand-emblem-badge">
                        <svg class="emblem-flame-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                            <defs>
                                <linearGradient id="sidebarFlameGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                    <stop offset="0%" stop-color="#fbc275" />
                                    <stop offset="100%" stop-color="#d48833" />
                                </linearGradient>
                            </defs>
                            <path fill="url(#sidebarFlameGrad)" d="M12 2.5C11.2 5.8 8.5 8.3 8.5 11.8C8.5 14.2 9.9 16.1 11.2 17C10.7 15.3 11.3 13.8 12.3 12.7C13.2 14.2 14.8 15.4 14.8 17.5C14.8 19.4 13.5 21 12 21.8C16.8 21.2 19.5 17.2 19.5 13.2C19.5 7.8 14.2 4.8 12 2.5Z"/>
                        </svg>
                    </div>
                    <div class="brand-text-col">
                        <span class="sidebar-logo">ROYAL IGNITE</span>
                        <span class="sidebar-suite-tag">ADMINISTRATION</span>
                    </div>
                </a>
            </div>

            <!-- Overview Section -->
            <div class="nav-section">
                <div class="nav-section-title">Overview</div>
                <ul class="nav-links">
                    <li>
                        <a href="/admin/dashboard" class="nav-link active">
                            <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                            </svg>
                            <span class="nav-text">Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/analytics" class="nav-link">
                            <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                <line x1="6" y1="20" x2="6" y2="14"></line>
                            </svg>
                            <span class="nav-text">Analytics</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Management Section -->
            <div class="nav-section">
                <div class="nav-section-title">Management</div>
                <ul class="nav-links">
                    <li>
                        <a href="/admin/categories" class="nav-link">
                            <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                            <span class="nav-text">Categories</span>
                            <span class="badge-count"><%= typeof totalCategories !== 'undefined' ? totalCategories : 0 %></span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/products" class="nav-link">
                            <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            </svg>
                            <span class="nav-text">Products</span>
                            <span class="badge-count"><%= typeof totalProducts !== 'undefined' ? totalProducts : 0 %></span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/inventory" class="nav-link">
                            <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                <line x1="12" y1="22.08" x2="12" y2="12"></line>
                            </svg>
                            <span class="nav-text">Inventory</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/users" class="nav-link">
                            <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                            </svg>
                            <span class="nav-text">Customers</span>
                            <span class="badge-count"><%= typeof totalUsers !== 'undefined' ? totalUsers : 0 %></span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/orders" class="nav-link">
                            <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            <span class="nav-text">Orders</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                            <span class="nav-text">Offers</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                                <line x1="7" y1="7" x2="7.01" y2="7"></line>
                            </svg>
                            <span class="nav-text">Coupons</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg class="nav-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                <polyline points="21 15 16 10 5 21"></polyline>
                            </svg>
                            <span class="nav-text">Banner</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Sidebar Bottom Footer -->
        <div class="sidebar-bottom">
            <div class="admin-profile-card">
                <div class="admin-avatar-box">
                    <span class="avatar-letter">A</span>
                    <span class="status-pulse-dot" title="Active"></span>
                </div>
                <div class="admin-meta">
                    <div class="admin-name">Administrator</div>
                    <div class="admin-role">Store Operations</div>
                </div>
            </div>

            <form action="/admin/logout" method="POST" class="logout-form">
                <button type="submit" class="btn-logout" title="Log out">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Log Out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Wrapper Area -->
    <div class="main-wrapper">
        
        <!-- Top Navbar Header -->
        <header class="top-navbar">
            <div class="navbar-left">
                <div class="breadcrumb-trail">
                    <span class="crumb-dim">Portal</span>
                    <span class="crumb-sep">/</span>
                    <span class="crumb-active">Dashboard</span>
                </div>
            </div>

            <div class="navbar-right">
                <div class="search-box">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" placeholder="Search orders, customers..." />
                    <span class="kbd-badge">⌘K</span>
                </div>

                <a href="/" target="_blank" class="nav-action-btn" title="Open Storefront">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    <span>Store</span>
                </a>

                <button class="nav-action-btn notification-btn" title="Notifications" aria-label="Notifications">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span class="unread-dot"></span>
                </button>

                <div class="user-pill-badge">
                    <div class="avatar-circle-sm">A</div>
                    <span class="user-pill-name">Admin</span>
                </div>
            </div>
        </header>

        <!-- Main Content Canvas -->
        <main class="content-padding">
            
            <!-- Calm Executive Header -->
            <section class="page-title-row">
                <div>
                    <h1 class="page-title">Dashboard</h1>
                    <p class="page-desc">Overview of today's store activity and order dispatch.</p>
                </div>

                <div class="title-actions">
                    <a href="/admin/analytics" class="link-analytics-quiet">
                        <span>Analytics Hub</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="/admin/products/add" class="btn-primary-obsidian">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        <span>Add Product</span>
                    </a>
                </div>
            </section>

            <!-- 4 Clean, Airy Hero Vital Signs -->
            <section class="serene-kpi-grid">
                
                <div class="serene-card">
                    <div class="serene-card-label">TODAY'S REVENUE</div>
                    <div class="serene-card-value">
                        <span class="currency">₹</span>42,850
                    </div>
                    <div class="serene-card-trend">
                        <span class="trend-green">+18.2%</span>
                        <span class="trend-sub">vs yesterday</span>
                    </div>
                </div>

                <div class="serene-card">
                    <div class="serene-card-label">ORDERS TODAY</div>
                    <div class="serene-card-value">
                        38 <span class="unit">orders</span>
                    </div>
                    <div class="serene-card-trend">
                        <span class="trend-neutral">12 shipped</span>
                        <span class="trend-sub">26 in queue</span>
                    </div>
                </div>

                <div class="serene-card">
                    <div class="serene-card-label">PENDING DISPATCH</div>
                    <div class="serene-card-value">
                        14 <span class="unit">orders</span>
                    </div>
                    <div class="serene-card-trend">
                        <span class="trend-amber">Awaiting fulfillment</span>
                    </div>
                </div>

                <div class="serene-card">
                    <div class="serene-card-label">TOTAL CUSTOMERS</div>
                    <div class="serene-card-value">
                        <%= typeof totalUsers !== 'undefined' ? totalUsers : 0 %> <span class="unit">users</span>
                    </div>
                    <div class="serene-card-trend">
                        <span class="trend-green">Active Accounts</span>
                        <span class="trend-sub">Client registry</span>
                    </div>
                </div>

            </section>

            <!-- Calm 2-Column Primary Workspace -->
            <div class="dashboard-split-layout">
                
                <!-- Left Area: Recent Orders (68%) -->
                <div class="split-main">
                    <div class="serene-box">
                        <div class="box-header">
                            <div>
                                <h2 class="box-title">Recent Orders</h2>
                                <p class="box-sub">Latest customer transactions and dispatch queue</p>
                            </div>

                            <div class="filter-pills-quiet">
                                <button class="fpill active" type="button">All</button>
                                <button class="fpill" type="button">Pending</button>
                                <button class="fpill" type="button">Delivered</button>
                            </div>
                        </div>

                        <div class="table-wrap-clean">
                            <table class="clean-table">
                                <thead>
                                    <tr>
                                        <th>ORDER</th>
                                        <th>CUSTOMER</th>
                                        <th>PRODUCT</th>
                                        <th>TOTAL</th>
                                        <th>STATUS</th>
                                        <th class="text-right">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="order-cell">#ORD-3291</td>
                                        <td>
                                            <div class="cust-flex">
                                                <span class="cust-avatar-sm">JD</span>
                                                <span class="cust-name-text">Jane Doe</span>
                                            </div>
                                        </td>
                                        <td class="prod-text">The Monarch Gold</td>
                                        <td class="amount-text">₹29,000</td>
                                        <td>
                                            <span class="dot-status-pill status-green">
                                                <span class="dot"></span>
                                                Delivered
                                            </span>
                                        </td>
                                        <td class="text-right">
                                            <button class="btn-quiet-action">Invoice</button>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="order-cell">#ORD-3290</td>
                                        <td>
                                            <div class="cust-flex">
                                                <span class="cust-avatar-sm">MS</span>
                                                <span class="cust-name-text">Michael Smith</span>
                                            </div>
                                        </td>
                                        <td class="prod-text">Obsidian Halo Jet</td>
                                        <td class="amount-text">₹9,500</td>
                                        <td>
                                            <span class="dot-status-pill status-amber">
                                                <span class="dot"></span>
                                                Pending
                                            </span>
                                        </td>
                                        <td class="text-right">
                                            <button class="btn-quiet-action primary">Ship</button>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="order-cell">#ORD-3289</td>
                                        <td>
                                            <div class="cust-flex">
                                                <span class="cust-avatar-sm">SJ</span>
                                                <span class="cust-name-text">Sarah Johnson</span>
                                            </div>
                                        </td>
                                        <td class="prod-text">The Aather Imperial</td>
                                        <td class="amount-text">₹17,950</td>
                                        <td>
                                            <span class="dot-status-pill status-amber">
                                                <span class="dot"></span>
                                                Pending
                                            </span>
                                        </td>
                                        <td class="text-right">
                                            <button class="btn-quiet-action primary">Ship</button>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="order-cell">#ORD-3288</td>
                                        <td>
                                            <div class="cust-flex">
                                                <span class="cust-avatar-sm">RB</span>
                                                <span class="cust-name-text">Robert Brown</span>
                                            </div>
                                        </td>
                                        <td class="prod-text">Signature Twin Jet</td>
                                        <td class="amount-text">₹8,500</td>
                                        <td>
                                            <span class="dot-status-pill status-rose">
                                                <span class="dot"></span>
                                                Cancelled
                                            </span>
                                        </td>
                                        <td class="text-right">
                                            <button class="btn-quiet-action">Invoice</button>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="order-cell">#ORD-3287</td>
                                        <td>
                                            <div class="cust-flex">
                                                <span class="cust-avatar-sm">EL</span>
                                                <span class="cust-name-text">Emily Lewis</span>
                                            </div>
                                        </td>
                                        <td class="prod-text">The Nova Dual Arc</td>
                                        <td class="amount-text">₹14,500</td>
                                        <td>
                                            <span class="dot-status-pill status-green">
                                                <span class="dot"></span>
                                                Delivered
                                            </span>
                                        </td>
                                        <td class="text-right">
                                            <button class="btn-quiet-action">Invoice</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="box-footer-link">
                            <a href="/admin/users" class="text-link-quiet">View all customers & registry &rarr;</a>
                        </div>
                    </div>
                </div>

                <!-- Right Area: Quiet Operational Pulse & Tasks (32%) -->
                <div class="split-side">
                    
                    <!-- Attention Required Card -->
                    <div class="serene-box">
                        <div class="box-header-compact">
                            <h3 class="box-subtitle">Attention Required</h3>
                            <span class="badge-mini">2 items</span>
                        </div>

                        <div class="task-list-quiet">
                            <a href="#orders" class="task-item">
                                <div class="task-dot amber"></div>
                                <div class="task-content">
                                    <span class="task-name">14 Orders Awaiting Dispatch</span>
                                    <span class="task-meta">Awaiting fulfillment & tracking assignment</span>
                                </div>
                                <span class="task-arrow">&rarr;</span>
                            </a>

                            <a href="#" class="task-item">
                                <div class="task-dot rose"></div>
                                <div class="task-content">
                                    <span class="task-name">3 Models Low on Stock</span>
                                    <span class="task-meta">The Royal Monarch Gold (4 units remaining)</span>
                                </div>
                                <span class="task-arrow">&rarr;</span>
                            </a>
                        </div>
                    </div>

                    <!-- Quick Tools -->
                    <div class="serene-box">
                        <div class="box-header-compact">
                            <h3 class="box-subtitle">Quick Actions</h3>
                        </div>

                        <div class="shortcuts-list">
                            <a href="#" class="shortcut-link">
                                <span class="shortcut-name">+ Add New Product</span>
                                <span class="shortcut-tag">Catalog</span>
                            </a>
                            <a href="#" class="shortcut-link">
                                <span class="shortcut-name">Create Discount Coupon</span>
                                <span class="shortcut-tag">Marketing</span>
                            </a>
                            <a href="/admin/users" class="shortcut-link">
                                <span class="shortcut-name">Customer Directory</span>
                                <span class="shortcut-tag">Users</span>
                            </a>
                            <a href="/admin/analytics" class="shortcut-link highlight">
                                <span class="shortcut-name">View Analytics & Reports</span>
                                <span class="shortcut-tag">Insights &rarr;</span>
                            </a>
                        </div>
                    </div>

                    <!-- Infrastructure Status Pill -->
                    <div class="serene-box system-status-card">
                        <div class="status-indicator-flex">
                            <span class="live-dot-green"></span>
                            <span class="status-msg">All store services operational</span>
                        </div>
                        <div class="status-sub">Gateway, database, and notifications online</div>
                    </div>

                </div>

            </div>

        </main>

        <!-- Minimalist Footer -->
        <footer class="serene-footer">
            <span>ROYAL IGNITE &bull; Admin Operations</span>
            <a href="/admin/analytics">Analytics & Business Intelligence &rarr;</a>
        </footer>

    </div>

    <script>
        // Table filter tab interaction
        document.querySelectorAll('.fpill').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.fpill').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            });
        });
    </script>

</body>

</html>
