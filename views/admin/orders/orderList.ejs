<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Order Management — ROYAL IGNITE Admin' %></title>
    <link rel="stylesheet" href="/css/admin/orderList.css" />

    <!-- SweetAlert2 library -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .royal-luxury-swal {
            background: #141312 !important;
            border: 1px solid rgba(212, 136, 51, 0.28) !important;
            border-radius: 16px !important;
            padding: 26px 22px !important;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75) !important;
            color: #f0ece6 !important;
            font-family: 'Instrument Sans', sans-serif !important;
        }
        .royal-swal-title {
            font-family: 'DM Serif Display', serif !important;
            color: #ffffff !important;
            font-size: 22px !important;
            letter-spacing: 0.3px !important;
            margin-bottom: 8px !important;
        }
        .royal-swal-confirm-btn {
            border-radius: 8px !important;
            font-weight: 600 !important;
            font-size: 13px !important;
            padding: 10px 22px !important;
            background: #D48833 !important;
            color: #ffffff !important;
            border: none !important;
            cursor: pointer !important;
        }
        .royal-swal-cancel-btn {
            border-radius: 8px !important;
            font-weight: 500 !important;
            font-size: 13px !important;
            padding: 10px 20px !important;
            background: #27272a !important;
            color: #d4d4d8 !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            cursor: pointer !important;
        }
    </style>
</head>

<body>

    <!-- Left Sidebar Navigation -->
    <%- include('../partials/sidebar', { activePage: 'orders' }) %>

    <!-- Main Content Area -->
    <main class="main-wrapper">

        <!-- Top Navbar Header -->
        <header class="top-navbar">
            <div class="top-navbar-title">
                <span>Acquisitions & Orders</span>
                <span style="font-size: 13px; font-weight: 500; color: var(--text-muted);">/ Order Management</span>
            </div>
            <div class="top-navbar-right">
                <div class="avatar-circle">
                    <%= typeof adminUser !== 'undefined' && adminUser.username ? adminUser.username.charAt(0).toUpperCase() : 'A' %>
                </div>
            </div>
        </header>

        <div class="content-padding">

            <!-- Alerts -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert-box alert-success">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                    <span><%= success %></span>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-box alert-error">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <!-- Summary Statistics Cards Row -->
            <% if (typeof stats !== 'undefined' && stats) { %>
                <section class="stats-grid">
                    <div class="stat-card">
                        <span class="stat-label">Total Acquisitions</span>
                        <span class="stat-value"><%= stats.totalOrdersCount || 0 %></span>
                        <span class="stat-subtext">Lifetime client records</span>
                    </div>

                    <div class="stat-card">
                        <span class="stat-label">Placed</span>
                        <span class="stat-value" style="color: var(--status-placed);"><%= (stats.placedCount || stats.pendingCount || 0) %></span>
                        <span class="stat-subtext">Awaiting fulfillment</span>
                    </div>

                    <div class="stat-card">
                        <span class="stat-label">In Transit</span>
                        <span class="stat-value" style="color: var(--status-shipped);"><%= (stats.shippedCount || 0) + (stats.outForDeliveryCount || 0) %></span>
                        <span class="stat-subtext">Dispatched via concierge</span>
                    </div>

                    <div class="stat-card">
                        <span class="stat-label">Delivered Safely</span>
                        <span class="stat-value" style="color: var(--status-delivered);"><%= stats.deliveredCount || 0 %></span>
                        <span class="stat-subtext">Completed acquisitions</span>
                    </div>

                    <div class="stat-card">
                        <span class="stat-label">Gross Revenue</span>
                        <span class="stat-value" style="color: var(--accent-gold);">₹<%= Number(stats.grossRevenue || 0).toLocaleString('en-IN') %></span>
                        <span class="stat-subtext">From active & delivered</span>
                    </div>
                </section>
            <% } %>

            <!-- Search, filter, and sort toolbar -->
            <section class="toolbar-card">
                <form action="/admin/orders" method="GET" id="orderFilterForm">
                    <div class="toolbar-row">
                        <!-- Search Box -->
                        <div class="search-box-wrapper">
                            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input type="text" 
                                   name="search" 
                                   value="<%= typeof search !== 'undefined' ? search : '' %>" 
                                   placeholder="Search by Order ID, customer, email, piece..." 
                                   class="search-input" />
                        </div>

                        <!-- Dropdown Controls -->
                        <div class="controls-group">
                            <!-- Status Filter Dropdown -->
                            <select name="status" class="filter-select" onchange="this.form.submit()">
                                <option value="all" <%= (!status || status === 'all') ? 'selected' : '' %>>All Statuses</option>
                                <option value="Placed" <%= (status === 'Placed' || status === 'Pending') ? 'selected' : '' %>>Placed</option>
                                <option value="Processing" <%= status === 'Processing' ? 'selected' : '' %>>Processing</option>
                                <option value="Shipped" <%= status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                                <option value="Out for Delivery" <%= status === 'Out for Delivery' ? 'selected' : '' %>>Out for Delivery</option>
                                <option value="Delivered" <%= status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                                <option value="Cancelled" <%= status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                                <option value="Return Requested" <%= status === 'Return Requested' ? 'selected' : '' %>>Return Requested</option>
                                <option value="Returned" <%= status === 'Returned' ? 'selected' : '' %>>Returned (Approved)</option>
                                <option value="Return Rejected" <%= status === 'Return Rejected' ? 'selected' : '' %>>Return Rejected</option>
                            </select>

                            <!-- Sort Dropdown (newest first by default) -->
                            <select name="sort" class="sort-select" onchange="this.form.submit()">
                                <option value="newest" <%= (!sort || sort === 'newest') ? 'selected' : '' %>>Date: Newest First (Default)</option>
                                <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Date: Oldest First</option>
                                <option value="amount_desc" <%= sort === 'amount_desc' ? 'selected' : '' %>>Amount: High to Low</option>
                                <option value="amount_asc" <%= sort === 'amount_asc' ? 'selected' : '' %>>Amount: Low to High</option>
                            </select>

                            <!-- Apply Button -->
                            <button type="submit" class="btn-filter-apply">Filter</button>

                            <!-- Clear Filters Button -->
                            <a href="/admin/orders" class="btn-filter-clear" title="Reset all search queries and filters">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                                <span>Clear</span>
                            </a>
                        </div>
                    </div>
                </form>

                <!-- Status Filter Pills Quick Links -->
                <% 
                    const buildPillUrl = (st) => {
                        const p = new URLSearchParams();
                        if (st && st !== 'all') p.set('status', st);
                        if (search) p.set('search', search);
                        if (sort && sort !== 'newest') p.set('sort', sort);
                        return '/admin/orders?' + p.toString();
                    };
                    const activeSt = status || 'all';
                %>
                <div class="filter-pills-row">
                    <span style="font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Quick Filter:</span>
                    <a href="<%= buildPillUrl('all') %>" class="status-pill <%= activeSt === 'all' ? 'active' : '' %>">All (<%= (search && activeSt === 'all') ? totalOrders : (stats ? stats.totalOrdersCount : orders.length) %>)</a>
                    <a href="<%= buildPillUrl('Placed') %>" class="status-pill <%= (activeSt === 'Placed' || activeSt === 'Pending') ? 'active' : '' %>">Placed (<%= stats ? (stats.placedCount || stats.pendingCount || 0) : 0 %>)</a>
                    <a href="<%= buildPillUrl('Processing') %>" class="status-pill <%= activeSt === 'Processing' ? 'active' : '' %>">Processing (<%= stats ? stats.processingCount : 0 %>)</a>
                    <a href="<%= buildPillUrl('Shipped') %>" class="status-pill <%= activeSt === 'Shipped' ? 'active' : '' %>">Shipped (<%= stats ? stats.shippedCount : 0 %>)</a>
                    <a href="<%= buildPillUrl('Out for Delivery') %>" class="status-pill <%= activeSt === 'Out for Delivery' ? 'active' : '' %>">Out for Delivery (<%= stats ? stats.outForDeliveryCount : 0 %>)</a>
                    <a href="<%= buildPillUrl('Delivered') %>" class="status-pill <%= activeSt === 'Delivered' ? 'active' : '' %>">Delivered (<%= stats ? stats.deliveredCount : 0 %>)</a>
                    <a href="<%= buildPillUrl('Cancelled') %>" class="status-pill <%= activeSt === 'Cancelled' ? 'active' : '' %>">Cancelled (<%= stats ? stats.cancelledCount : 0 %>)</a>
                    <a href="<%= buildPillUrl('Return Requested') %>" class="status-pill <%= activeSt === 'Return Requested' ? 'active' : '' %>" style="color: #f59e0b; border-color: rgba(245, 158, 11, 0.4);">Returns Requested (<%= stats ? stats.returnRequestedCount : 0 %>)</a>
                    <a href="<%= buildPillUrl('Returned') %>" class="status-pill <%= activeSt === 'Returned' ? 'active' : '' %>">Returned (<%= stats ? stats.returnedCount : 0 %>)</a>
                    <a href="<%= buildPillUrl('Return Rejected') %>" class="status-pill <%= activeSt === 'Return Rejected' ? 'active' : '' %>" style="color: #ef4444; border-color: rgba(239, 68, 68, 0.4);">Return Rejected (<%= stats ? stats.returnRejectedCount : 0 %>)</a>
                </div>
            </section>

            <!-- Orders listing table -->
            <section class="table-card">
                <div class="table-responsive">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>Order Identifier & Date</th>
                                <th>Client Details</th>
                                <th>Reserved Creations</th>
                                <th>Payable Amount</th>
                                <th>Fulfillment Status</th>
                                <th style="text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (Array.isArray(orders) && orders.length > 0) { %>
                                <% orders.forEach(function(order) { %>
                                    <% 
                                        const statusSlug = (order.orderStatus || 'placed').toLowerCase().replace(/\s+/g, '-');
                                        const customerName = (order.user && order.user.name) || order.shippingAddress.fullName || 'Valued Client';
                                        const customerEmail = (order.user && order.user.email) || 'No email provided';
                                        const customerPhone = (order.user && order.user.phone) || order.shippingAddress.phone || '—';
                                        const firstLetter = customerName.charAt(0).toUpperCase();
                                    %>
                                    <tr id="order-row-<%= order.orderId %>">
                                        <!-- Order ID and Date -->
                                        <td>
                                            <div class="order-id-cell">
                                                <span class="order-id-code">#<%= order.orderId %></span>
                                                <span class="order-date-text">
                                                    <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                                    • <%= new Date(order.createdAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %>
                                                </span>
                                            </div>
                                        </td>

                                        <!-- Customer Details -->
                                        <td>
                                            <div class="user-info-cell">
                                                <div class="user-avatar-mini"><%= firstLetter %></div>
                                                <div class="user-text-col">
                                                    <span class="user-name"><%= customerName %></span>
                                                    <span class="user-subtext"><%= customerEmail %></span>
                                                    <span class="user-subtext" style="color: #a1a1aa;"><%= customerPhone %></span>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Creations Count & Preview -->
                                        <td>
                                            <div class="items-summary-cell">
                                                <span class="items-count-badge">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                                    </svg>
                                                    <%= order.items ? order.items.length : 0 %> <%= order.items && order.items.length === 1 ? 'Piece' : 'Pieces' %>
                                                </span>
                                                <span class="items-preview-text">
                                                    <%= order.items && order.items[0] ? order.items[0].name : '—' %>
                                                    <%= order.items && order.items.length > 1 ? ` +${order.items.length - 1} more` : '' %>
                                                </span>
                                            </div>
                                        </td>

                                        <!-- Total Amount & Payment Method -->
                                        <td>
                                            <div class="amount-cell">
                                                <span class="amount-value">₹<%= Number(order.pricing ? order.pricing.totalAmount : 0).toLocaleString('en-IN') %></span>
                                                <span class="payment-method-pill">
                                                    <%= order.paymentMethod %> (<%= order.paymentStatus %>)
                                                </span>
                                            </div>
                                        </td>

                                        <!-- Fulfillment Status Badge + Quick Action -->
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <span class="status-badge <%= statusSlug %>">
                                                    <span class="status-dot"></span>
                                                    <span><%= order.orderStatus %></span>
                                                </span>
                                                <% 
                                                    const canEditStatus = ['Placed', 'Pending', 'Processing', 'Shipped', 'Out for Delivery', 'Return Requested'].includes(order.orderStatus);
                                                %>
                                                <% if (canEditStatus) { %>
                                                    <button type="button" 
                                                            class="btn-status-quick" 
                                                            title="Quick change status"
                                                            onclick="promptChangeStatus('<%= order.orderId %>', '<%= order.orderStatus %>')">
                                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M12 20h9"></path>
                                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                                        </svg>
                                                    </button>
                                                <% } %>
                                            </div>
                                        </td>

                                        <!-- View Detail Button -->
                                        <td style="text-align: right;">
                                            <div class="actions-cell" style="justify-content: flex-end;">
                                                <a href="/admin/orders/<%= order.orderId %>" class="btn-view-detail" title="Inspect full order dossier">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                        <circle cx="12" cy="12" r="3"></circle>
                                                    </svg>
                                                    <span>View Detail</span>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <!-- Empty State -->
                                <tr>
                                    <td colspan="6">
                                        <div class="empty-state-box">
                                            <div class="empty-icon">
                                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                    <circle cx="11" cy="11" r="8"></circle>
                                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                                </svg>
                                            </div>
                                            <h3 class="empty-title">No Orders Located</h3>
                                            <p class="empty-desc">
                                                <%= (search || (status && status !== 'all')) ? 'No orders match your current search queries or filter selections.' : 'There are currently no customer acquisitions recorded in the database.' %>
                                            </p>
                                            <% if (search || (status && status !== 'all')) { %>
                                                <a href="/admin/orders" class="btn-filter-clear" style="margin-top: 6px;">
                                                    Clear All Filters
                                                </a>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Toolbar -->
                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                    <% 
                        const buildPageUrl = (p) => {
                            const params = new URLSearchParams();
                            if (search) params.set('search', search);
                            if (status && status !== 'all') params.set('status', status);
                            if (sort && sort !== 'newest') params.set('sort', sort);
                            params.set('page', p);
                            return '/admin/orders?' + params.toString();
                        };
                    %>
                    <div class="pagination-wrapper">
                        <span>
                            Showing <%= ((currentPage - 1) * limit) + 1 %>–<%= Math.min(currentPage * limit, totalOrders) %> of <%= totalOrders %> orders
                        </span>

                        <div class="pagination-controls">
                            <!-- Previous -->
                            <a href="<%= buildPageUrl(currentPage - 1) %>" 
                               class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>" 
                               title="Previous Page">
                                ←
                            </a>

                            <!-- Page Numbers -->
                            <% for (let p = 1; p <= totalPages; p++) { %>
                                <a href="<%= buildPageUrl(p) %>" 
                                   class="page-btn <%= currentPage === p ? 'active' : '' %>">
                                    <%= p %>
                                </a>
                            <% } %>

                            <!-- Next -->
                            <a href="<%= buildPageUrl(currentPage + 1) %>" 
                               class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>" 
                               title="Next Page">
                                →
                            </a>
                        </div>
                    </div>
                <% } %>
            </section>

        </div>
    </main>

    <!-- Status Dialog Script -->
    <script>
        function promptChangeStatus(orderId, currentStatus) {
            const transitions = <%- JSON.stringify(allowedTransitions) %>;

            const nextStatuses = transitions[currentStatus] || [];
            if (nextStatuses.length === 0) {
                Swal.fire({
                    icon: 'info',
                    title: 'Status Final',
                    text: currentStatus === 'Delivered' 
                        ? 'Delivered orders cannot be reverted to previous statuses.'
                        : `Orders in "${currentStatus}" status cannot be modified.`,
                    background: '#141312',
                    color: '#f0ece6',
                    confirmButtonColor: '#D48833'
                });
                return;
            }

            let optionsHtml = `<option value="${currentStatus}" selected>${currentStatus} (Current)</option>`;
            nextStatuses.forEach(st => {
                const label = st === 'Returned' ? 'Returned (Approve Return)' : (st === 'Return Rejected' ? 'Return Rejected (Decline Return)' : st);
                optionsHtml += `<option value="${st}">${label}</option>`;
            });

            Swal.fire({
                title: 'Update Fulfillment Status',
                html: `
                    <div style="text-align: left; margin-bottom: 12px; font-size: 13.5px; color: #a1a1aa;">
                        Updating status for order <strong style="color: #ffffff;">#${orderId}</strong>:
                    </div>
                    <select id="swal-status-select" style="width: 100%; height: 42px; border-radius: 8px; border: 1px solid #3f3f46; background: #1f1f23; color: #ffffff; padding: 0 12px; font-size: 14px; margin-bottom: 14px;">
                        ${optionsHtml}
                    </select>
                    <input id="swal-notes-input" type="text" placeholder="Administrative notes (rejection reason if rejecting)..." style="width: 100%; height: 40px; border-radius: 8px; border: 1px solid #3f3f46; background: #1f1f23; color: #ffffff; padding: 0 12px; font-size: 13px;" />
                `,
                icon: 'question',
                iconColor: '#D48833',
                showCancelButton: true,
                confirmButtonText: 'Save Status',
                cancelButtonText: 'Cancel',
                customClass: {
                    popup: 'royal-luxury-swal',
                    title: 'royal-swal-title',
                    confirmButton: 'royal-swal-confirm-btn',
                    cancelButton: 'royal-swal-cancel-btn'
                },
                preConfirm: () => {
                    const status = document.getElementById('swal-status-select').value;
                    const notes = document.getElementById('swal-notes-input').value;
                    if (status === 'Return Rejected' && (!notes || !notes.trim())) {
                        Swal.showValidationMessage('A reason is mandatory when rejecting a return request.');
                        return false;
                    }
                    return { status, notes };
                }
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const { status, notes } = result.value;
                    try {
                        const response = await fetch(`/admin/orders/${orderId}/status`, {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json',
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ status, notes })
                        });

                        const data = await response.json();

                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Status Updated',
                                text: data.message || 'Order status updated successfully.',
                                background: '#141312',
                                color: '#f0ece6',
                                confirmButtonColor: '#D48833'
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Notice',
                                text: data.message || 'Unable to update status.',
                                background: '#141312',
                                color: '#f0ece6',
                                confirmButtonColor: '#D48833'
                            });
                        }
                    } catch (err) {
                        console.error('Update status error:', err);
                        Swal.fire({
                            icon: 'error',
                            title: 'Network Error',
                            text: 'Failed to communicate with administration server.',
                            background: '#141312',
                            color: '#f0ece6',
                            confirmButtonColor: '#D48833'
                        });
                    }
                }
            });
        }
    </script>

</body>
</html>
