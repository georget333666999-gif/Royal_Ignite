<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Store Analytics - ROYAL IGNITE Admin</title>
    <link rel="stylesheet" href="/css/admin/dashboard.css" />
</head>

<body class="admin-dashboard-page">

    <!-- Left Sidebar Navigation -->
    <aside class="sidebar">
        <div class="sidebar-top">
            <!-- Brand Identity -->
            <div class="sidebar-header">
                <a href="/admin/dashboard" class="sidebar-brand">
                    <div class="brand-emblem-badge">
                        <svg class="emblem-flame-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                            <defs>
                                <linearGradient id="sidebarFlameGrad2" x1="0%" y1="0%" x2="0%" y2="100%">
                                    <stop offset="0%" stop-color="#fbc275" />
                                    <stop offset="100%" stop-color="#d48833" />
                                </linearGradient>
                            </defs>
                            <path fill="url(#sidebarFlameGrad2)" d="M12 2.5C11.2 5.8 8.5 8.3 8.5 11.8C8.5 14.2 9.9 16.1 11.2 17C10.7 15.3 11.3 13.8 12.3 12.7C13.2 14.2 14.8 15.4 14.8 17.5C14.8 19.4 13.5 21 12 21.8C16.8 21.2 19.5 17.2 19.5 13.2C19.5 7.8 14.2 4.8 12 2.5Z"/>
                        </svg>
                    </div>
                    <div class="brand-text-col">
                        <span class="sidebar-logo">ROYAL IGNITE</span>
                        <span class="sidebar-suite-tag">EXECUTIVE SUITE</span>
                    </div>
                </a>
            </div>

            <!-- Overview Section -->
            <div class="nav-section">
                <div class="nav-section-title">Overview</div>
                <ul class="nav-links">
                    <li>
                        <a href="/admin/dashboard" class="nav-link">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                            </svg>
                            <span class="nav-text">Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/analytics" class="nav-link active">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                <line x1="6" y1="20" x2="6" y2="14"></line>
                            </svg>
                            <span class="nav-text">Analytics</span>
                            <span class="nav-indicator-dot"></span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Management Section -->
            <div class="nav-section">
                <div class="nav-section-title">Management</div>
                <ul class="nav-links">
                    <li>
                        <a href="/admin/categories" class="nav-link">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                            <span class="nav-text">Categories</span>
                            <span class="badge-count"><%= typeof totalCategories !== 'undefined' ? totalCategories : 0 %></span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/products" class="nav-link">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            </svg>
                            <span class="nav-text">Products</span>
                            <span class="badge-count"><%= typeof totalProducts !== 'undefined' ? totalProducts : 0 %></span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/inventory" class="nav-link">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                <line x1="12" y1="22.08" x2="12" y2="12"></line>
                            </svg>
                            <span class="nav-text">Inventory</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/users" class="nav-link">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            <span class="nav-text">Customers</span>
                            <span class="badge-count"><%= typeof totalUsers !== 'undefined' ? totalUsers : 0 %></span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/orders" class="nav-link">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            <span class="nav-text">Orders</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                            <span class="nav-text">Offers</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                                <line x1="7" y1="7" x2="7.01" y2="7"></line>
                            </svg>
                            <span class="nav-text">Coupons</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                <polyline points="21 15 16 10 5 21"></polyline>
                            </svg>
                            <span class="nav-text">Banner</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Sidebar Bottom Footer -->
        <div class="sidebar-bottom">
            <div class="admin-profile-card">
                <div class="admin-avatar-box">
                    <span class="avatar-letter">A</span>
                    <span class="status-pulse-dot" title="Admin Session Active"></span>
                </div>
                <div class="admin-meta">
                    <div class="admin-name">Super Administrator</div>
                    <div class="admin-role">System Operations</div>
                </div>
            </div>

            <form action="/admin/logout" method="POST" class="logout-form">
                <button type="submit" class="btn-logout" title="Safely log out of administrative panel">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Sign Out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Wrapper Area -->
    <div class="main-wrapper">
        
        <!-- Top Navbar Header -->
        <header class="top-navbar">
            <div class="navbar-left">
                <div class="breadcrumb-trail">
                    <span class="crumb-dim">Portal</span>
                    <span class="crumb-sep">/</span>
                    <span class="crumb-active">Business Intelligence & Analytics</span>
                </div>
            </div>

            <div class="navbar-right">
                <div class="search-box">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" placeholder="Search metrics, reports, SKUs..." />
                    <span class="kbd-badge">⌘K</span>
                </div>

                <a href="/" target="_blank" class="nav-action-btn store-link" title="Open Storefront">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    <span>Live Store</span>
                </a>

                <button class="nav-action-btn notification-btn" title="View Notifications" aria-label="Notifications">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span class="unread-dot"></span>
                </button>

                <div class="user-pill-badge">
                    <div class="avatar-circle-sm">A</div>
                    <span class="user-pill-name">Admin</span>
                </div>
            </div>
        </header>

        <!-- Main Content Canvas -->
        <main class="content-padding">
            
            <!-- Executive Analytics Header -->
            <section class="executive-welcome-bar">
                <div class="welcome-text-col">
                    <div class="welcome-tag-row">
                        <span class="live-security-badge">
                            <span class="pulse-emerald"></span>
                            INTELLIGENCE ENGINE ACTIVE
                        </span>
                        <span class="date-chip">Updated 5 minutes ago</span>
                    </div>
                    <h1 class="executive-title">Revenue & Growth Intelligence</h1>
                    <p class="executive-subtitle">
                        Historical sales trends, collection performance, customer cohort retention, and operational conversion metrics.
                    </p>
                </div>

                <div class="welcome-actions-col">
                    <div class="timeframe-selector" role="tablist">
                        <button class="time-tab" type="button">Last 7 Days</button>
                        <button class="time-tab active" type="button">Last 30 Days</button>
                        <button class="time-tab" type="button">Quarter</button>
                        <button class="time-tab" type="button">Year 2026</button>
                    </div>
                    <a href="#" class="btn-export-luxury">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        <span>Download Report</span>
                    </a>
                </div>
            </section>

            <!-- 4 Strategic Business Intelligence KPIs -->
            <section class="kpi-grid">
                
                <div class="kpi-card highlight-gold">
                    <div class="kpi-card-header">
                        <span class="kpi-label">GROSS STORE SALES</span>
                        <div class="kpi-icon-wrap icon-gold">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                                <line x1="2" y1="10" x2="22" y2="10"></line>
                            </svg>
                        </div>
                    </div>
                    <div class="kpi-body">
                        <div class="kpi-value-row">
                            <span class="currency-symbol">₹</span>
                            <span class="kpi-amount">12,48,500</span>
                        </div>
                        <div class="kpi-footer-flex">
                            <span class="trend-badge positive">+14.5%</span>
                            <span class="trend-note">vs previous 30 days</span>
                        </div>
                    </div>
                    <div class="kpi-sparkline">
                        <svg width="100%" height="24" viewBox="0 0 120 24" preserveAspectRatio="none">
                            <path d="M0,20 Q20,16 40,18 T80,8 T120,4" fill="none" stroke="#D48833" stroke-width="2" />
                        </svg>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-card-header">
                        <span class="kpi-label">AVERAGE ORDER VALUE (AOV)</span>
                        <div class="kpi-icon-wrap">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="1" x2="12" y2="23"></line>
                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="kpi-body">
                        <div class="kpi-value-row">
                            <span class="currency-symbol">₹</span>
                            <span class="kpi-amount">998</span>
                        </div>
                        <div class="kpi-footer-flex">
                            <span class="trend-badge positive">+8.2%</span>
                            <span class="trend-note">Cart size 1.4 items</span>
                        </div>
                    </div>
                    <div class="kpi-sparkline">
                        <svg width="100%" height="24" viewBox="0 0 120 24" preserveAspectRatio="none">
                            <path d="M0,18 Q30,19 60,11 T100,7 T120,3" fill="none" stroke="#171513" stroke-width="2" />
                        </svg>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-card-header">
                        <span class="kpi-label">STORE CONVERSION RATE</span>
                        <div class="kpi-icon-wrap">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                                <polyline points="17 6 23 6 23 12"></polyline>
                            </svg>
                        </div>
                    </div>
                    <div class="kpi-body">
                        <div class="kpi-value-row">
                            <span class="kpi-amount">3.84%</span>
                        </div>
                        <div class="kpi-footer-flex">
                            <span class="trend-badge positive">+0.4%</span>
                            <span class="trend-note">Industry benchmark 2.5%</span>
                        </div>
                    </div>
                    <div class="kpi-sparkline">
                        <svg width="100%" height="24" viewBox="0 0 120 24" preserveAspectRatio="none">
                            <path d="M0,22 Q35,15 70,12 T105,6 T120,2" fill="none" stroke="#10B981" stroke-width="2" />
                        </svg>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-card-header">
                        <span class="kpi-label">REPEAT CUSTOMER RATE</span>
                        <div class="kpi-icon-wrap">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="kpi-body">
                        <div class="kpi-value-row">
                            <span class="kpi-amount">32.6%</span>
                        </div>
                        <div class="kpi-footer-flex">
                            <span class="trend-badge positive">+3.1%</span>
                            <span class="trend-note">High brand loyalty</span>
                        </div>
                    </div>
                    <div class="kpi-sparkline">
                        <svg width="100%" height="24" viewBox="0 0 120 24" preserveAspectRatio="none">
                            <path d="M0,14 Q30,12 60,14 T90,13 T120,12" fill="none" stroke="#847E74" stroke-width="2" />
                        </svg>
                    </div>
                </div>

            </section>

            <!-- Deep-Dive Analytics Row: Vector Revenue Curve + Category Distribution Donut -->
            <section class="analytics-row">
                
                <!-- Left Chart: Revenue Performance Vector -->
                <div class="luxury-card chart-large-card">
                    <div class="card-header-flex">
                        <div>
                            <div class="card-badge-tag">HISTORICAL TRAJECTORY</div>
                            <h2 class="card-headline">Revenue & Volume Trends</h2>
                            <p class="card-subtext">Monthly gross sales compared against volume velocity</p>
                        </div>

                        <div class="chart-controls">
                            <div class="chart-legend">
                                <span class="legend-item"><span class="dot-gold"></span> Revenue (₹)</span>
                                <span class="legend-item"><span class="dot-dark"></span> Orders Volume</span>
                            </div>
                            <select class="luxury-select">
                                <option>Last 6 Months (2026)</option>
                                <option>Full Year 2025</option>
                            </select>
                        </div>
                    </div>

                    <div class="chart-viewport-container">
                        <div class="chart-stat-strip">
                            <div class="chart-micro-stat">
                                <span class="stat-lbl">PEAK SALES DAY</span>
                                <span class="stat-val">₹68,400 <small>(May 18)</small></span>
                            </div>
                            <div class="chart-micro-stat">
                                <span class="stat-lbl">DAILY AVERAGE</span>
                                <span class="stat-val">₹41,600 / day</span>
                            </div>
                            <div class="chart-micro-stat">
                                <span class="stat-lbl">REFUND RATIO</span>
                                <span class="stat-val">0.82% <small>(Low)</small></span>
                            </div>
                        </div>

                        <div class="svg-chart-wrapper">
                            <svg class="analytics-svg" viewBox="0 0 700 230" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="goldAreaGradient2" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#D48833" stop-opacity="0.28"/>
                                        <stop offset="70%" stop-color="#D48833" stop-opacity="0.04"/>
                                        <stop offset="100%" stop-color="#D48833" stop-opacity="0.0"/>
                                    </linearGradient>
                                    <linearGradient id="darkAreaGradient2" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#141312" stop-opacity="0.10"/>
                                        <stop offset="100%" stop-color="#141312" stop-opacity="0.0"/>
                                    </linearGradient>
                                </defs>

                                <line x1="40" y1="30" x2="680" y2="30" stroke="#EDE8E0" stroke-width="1" stroke-dasharray="4 4" />
                                <line x1="40" y1="80" x2="680" y2="80" stroke="#EDE8E0" stroke-width="1" stroke-dasharray="4 4" />
                                <line x1="40" y1="130" x2="680" y2="130" stroke="#EDE8E0" stroke-width="1" stroke-dasharray="4 4" />
                                <line x1="40" y1="180" x2="680" y2="180" stroke="#EDE8E0" stroke-width="1" />

                                <text x="32" y="34" text-anchor="end" class="chart-axis-text">₹15L</text>
                                <text x="32" y="84" text-anchor="end" class="chart-axis-text">₹10L</text>
                                <text x="32" y="134" text-anchor="end" class="chart-axis-text">₹5L</text>
                                <text x="32" y="184" text-anchor="end" class="chart-axis-text">0</text>

                                <path d="M50,160 C140,150 200,120 280,135 C360,150 440,105 520,115 C600,125 640,80 670,75 L670,180 L50,180 Z" fill="url(#darkAreaGradient2)" />
                                <path d="M50,160 C140,150 200,120 280,135 C360,150 440,105 520,115 C600,125 640,80 670,75" fill="none" stroke="#7A746B" stroke-width="2" stroke-dasharray="3 3" />

                                <path d="M50,140 C140,145 210,95 290,110 C370,125 450,65 530,70 C610,75 640,40 670,35 L670,180 L50,180 Z" fill="url(#goldAreaGradient2)" />
                                <path d="M50,140 C140,145 210,95 290,110 C370,125 450,65 530,70 C610,75 640,40 670,35" fill="none" stroke="#D48833" stroke-width="3" stroke-linecap="round" />

                                <circle cx="50" cy="140" r="4" fill="#FFFFFF" stroke="#D48833" stroke-width="2.5" />
                                <circle cx="175" cy="120" r="4" fill="#FFFFFF" stroke="#D48833" stroke-width="2.5" />
                                <circle cx="290" cy="110" r="4" fill="#FFFFFF" stroke="#D48833" stroke-width="2.5" />
                                <circle cx="410" cy="90" r="4" fill="#FFFFFF" stroke="#D48833" stroke-width="2.5" />
                                <circle cx="530" cy="70" r="4" fill="#FFFFFF" stroke="#D48833" stroke-width="2.5" />
                                <circle cx="670" cy="35" r="5" fill="#D48833" stroke="#FFFFFF" stroke-width="2" />
                            </svg>
                        </div>

                        <div class="chart-x-axis">
                            <span>Jan</span>
                            <span>Feb</span>
                            <span>Mar</span>
                            <span>Apr</span>
                            <span>May</span>
                            <span>Jun</span>
                            <span class="active-month">Jul (Current)</span>
                        </div>
                    </div>
                </div>

                <!-- Right Card: Category Share Donut & Breakdown -->
                <div class="luxury-card chart-side-card">
                    <div class="card-header-flex">
                        <div>
                            <div class="card-badge-tag">CATEGORY SHARE</div>
                            <h2 class="card-headline">Revenue by Collection</h2>
                        </div>
                    </div>

                    <div class="donut-chart-container">
                        <div class="donut-svg-wrapper">
                            <svg class="donut-svg" viewBox="0 0 160 160">
                                <circle cx="80" cy="80" r="60" fill="none" stroke="#F1EFE9" stroke-width="18" />
                                <circle cx="80" cy="80" r="60" fill="none" stroke="#D48833" stroke-width="18"
                                        stroke-dasharray="158 377" stroke-dashoffset="0" />
                                <circle cx="80" cy="80" r="60" fill="none" stroke="#171513" stroke-width="18"
                                        stroke-dasharray="105 377" stroke-dashoffset="-158" />
                                <circle cx="80" cy="80" r="60" fill="none" stroke="#10B981" stroke-width="18"
                                        stroke-dasharray="68 377" stroke-dashoffset="-263" />
