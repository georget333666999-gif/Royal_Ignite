<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Management - ROYAL IGNITE Admin</title>
    <link rel="stylesheet" href="/css/admin/userList.css" />
</head>

<body>

    <!-- Admin Navigation Header -->
    <header class="admin-navbar">
        <a href="/admin/users" class="brand-title">ROYAL IGNITE</a>
        <span class="admin-panel-badge">ADMIN CONTROL PANEL</span>
    </header>

    <main class="user-management">

        <!-- Page Header Title -->
        <div class="page-header">
            <div>
                <h1 class="page-title">User Management</h1>
                <p class="page-subtitle">View, search, and manage registered customer accounts & permissions.</p>
            </div>
        </div>

        <!-- Search Form -->
        <form action="/admin/users" method="GET" class="search-form">
            <input
                type="text"
                name="search"
                class="search-input"
                placeholder="Search users by name, email, or phone..."
                value="<%= search || '' %>"
            />

            <button type="submit" class="btn-search">Search</button>

            <% if (search) { %>
                <a href="/admin/users" class="btn-clear">Clear Search</a>
            <% } %>
        </form>

        <!-- User Table Container -->
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Verification</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (users.length === 0) { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 40px; color: #666666;">
                                No customer accounts found matching your search.
                            </td>
                        </tr>
                    <% } else { %>
                        <% users.forEach(user => { %>
                            <tr>
                                <!-- Name -->
                                <td style="font-weight: 500;"><%= user.name %></td>

                                <!-- Email -->
                                <td><%= user.email %></td>

                                <!-- Phone -->
                                <td><%= user.phone || "N/A" %></td>

                                <!-- Verification -->
                                <td>
                                    <% if (user.isVerified) { %>
                                        <span class="badge-verified">✓ Verified</span>
                                    <% } else { %>
                                        <span class="badge-unverified">✕ Pending</span>
                                    <% } %>
                                </td>

                                <!-- Status -->
                                <td>
                                    <% if (user.isBlocked) { %>
                                        <span class="badge-status badge-blocked">Blocked</span>
                                    <% } else { %>
                                        <span class="badge-status badge-active">Active</span>
                                    <% } %>
                                </td>

                                <!-- Created At -->
                                <td style="color: #666666;">
                                    <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-GB') : 'N/A' %>
                                </td>

                                <!-- Action -->
                                <td>
                                    <% if (user.isBlocked) { %>
                                        <form action="/admin/users/<%= user._id %>/unblock" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to unblock <%= user.name %>?');">
                                            <input type="hidden" name="search" value="<%= search || '' %>">
                                            <input type="hidden" name="page" value="<%= currentPage %>">
                                            <button type="submit" class="btn-unblock">Unblock</button>
                                        </form>
                                    <% } else { %>
                                        <form action="/admin/users/<%= user._id %>/block" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to block <%= user.name %>?');">
                                            <input type="hidden" name="search" value="<%= search || '' %>">
                                            <input type="hidden" name="page" value="<%= currentPage %>">
                                            <button type="submit" class="btn-block">Block</button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="pagination">
                    <% if (currentPage > 1) { %>
                        <a href="/admin/users?page=<%= currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="pagination-button">
                            &larr; Prev
                        </a>
                    <% } %>

                    <% for (let page = 1; page <= totalPages; page++) { %>
                        <a href="/admin/users?page=<%= page %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="pagination-button <%= page === currentPage ? 'active-page' : '' %>">
                            <%= page %>
                        </a>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <a href="/admin/users?page=<%= currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="pagination-button">
                            Next &rarr;
                        </a>
                    <% } %>
                </div>
            <% } %>

        </div>

    </main>

</body>

</html>