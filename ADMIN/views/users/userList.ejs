<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Customer Management - ROYAL IGNITE Admin</title>
    <link rel="stylesheet" href="/css/admin/userList.css" />
</head>

<body>

    <!-- Left Sidebar Navigation -->
    <aside class="sidebar">
        <div>
            <div class="sidebar-header">
                <a href="/admin/dashboard" class="sidebar-logo">ROYAL IGNITE</a>
            </div>

            <!-- Overview Section -->
            <div class="nav-section">
                <div class="nav-section-title">Overview</div>
                <ul class="nav-links">
                    <li>
                        <a href="/admin/dashboard" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                            Dashboard
                        </a>
                    </li>
                    <li>
                        <a href="/admin/analytics" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                <line x1="6" y1="20" x2="6" y2="14"></line>
                            </svg>
                            Analytics
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Management Section -->
            <div class="nav-section">
                <div class="nav-section-title">Management</div>
                <ul class="nav-links">
                    <li>
                        <a href="#" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                            Categories
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                            </svg>
                            Subcategories
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            </svg>
                            Products
                        </a>
                    </li>
                    <li>
                        <a href="/admin/users" class="nav-link active">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            Customers
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            Orders
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                            Offers
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                                <line x1="7" y1="7" x2="7.01" y2="7"></line>
                            </svg>
                            Coupons
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                <polyline points="21 15 16 10 5 21"></polyline>
                            </svg>
                            Banner
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <form action="/admin/logout" method="POST">
            <button type="submit" class="btn-logout">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                Logout
            </button>
        </form>
    </aside>

    <!-- Main Wrapper Area -->
    <div class="main-wrapper">
        
        <!-- Top Navbar Header -->
        <header class="top-navbar">
            <h1 class="top-navbar-title">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                Customer Management
            </h1>
            <div class="top-navbar-right">
                <div class="avatar-circle">A</div>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="content-padding">

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-box alert-danger">
                    <strong>Error:</strong> <%= error %>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert-box alert-success">
                    <strong>Success:</strong> <%= success %>
                </div>
            <% } %>

            <!-- Top Metric Cards Row -->
            <div class="metrics-grid">
                
                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-label">Total Customers</span>
                        <div class="icon-badge bg-customers">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                            </svg>
                        </div>
                    </div>
                    <div class="metric-value"><%= typeof totalCustomers !== 'undefined' ? totalCustomers : 0 %></div>
                </div>

                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-label">Active Users</span>
                        <div class="icon-badge bg-active">
                            <div class="dot-green"></div>
                        </div>
                    </div>
                    <div class="metric-value"><%= typeof activeUsers !== 'undefined' ? activeUsers : 0 %></div>
                </div>

                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-label">Blocked Users</span>
                        <div class="icon-badge bg-blocked">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="metric-value"><%= typeof blockedUsers !== 'undefined' ? blockedUsers : 0 %></div>
                </div>

                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-label">Inactive Users</span>
                        <div class="icon-badge bg-inactive">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                        </div>
                    </div>
                    <div class="metric-value"><%= typeof inactiveUsers !== 'undefined' ? inactiveUsers : 0 %></div>
                </div>

            </div>

            <!-- Customer Directory Container -->
            <div class="directory-card">
                
                <div class="directory-header">
                    <h2 class="directory-title">Customer Directory</h2>
                    
                    <form action="/admin/users" method="GET" class="filter-bar" id="userFilterForm">
                        <div class="search-input-wrap">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input
                                type="text"
                                id="searchInput"
                                name="search"
                                placeholder="Search by name, email, or starting letter..."
                                value="<%= search || '' %>"
                                autocomplete="off"
                            />
                            <button type="button" id="clearSearchBtn" class="search-clear-btn" title="Clear search" style="<%= search ? 'display: flex;' : 'display: none;' %>">&times;</button>
                        </div>

                        <select id="statusFilter" name="status" class="filter-select">
                            <option value="all" <%= typeof statusFilter !== 'undefined' && statusFilter === 'all' ? 'selected' : '' %>>All Status</option>
                            <option value="active" <%= typeof statusFilter !== 'undefined' && statusFilter === 'active' ? 'selected' : '' %>>Active</option>
                            <option value="blocked" <%= typeof statusFilter !== 'undefined' && statusFilter === 'blocked' ? 'selected' : '' %>>Blocked</option>
                            <option value="inactive" <%= typeof statusFilter !== 'undefined' && statusFilter === 'inactive' ? 'selected' : '' %>>Inactive</option>
                        </select>

                        <select id="limitFilter" name="limit" class="filter-select">
                            <option value="4" <%= typeof limit !== 'undefined' && limit === 4 ? 'selected' : '' %>>4 per page</option>
                            <option value="8" <%= typeof limit !== 'undefined' && limit === 8 ? 'selected' : '' %>>8 per page</option>
                            <option value="10" <%= typeof limit !== 'undefined' && limit === 10 ? 'selected' : '' %>>10 per page</option>
                            <option value="20" <%= typeof limit !== 'undefined' && limit === 20 ? 'selected' : '' %>>20 per page</option>
                        </select>

                        <button type="submit" class="btn-filter-search">Search</button>

                        <a href="/admin/users" id="clearFilterLink" class="btn-filter-search" style="text-decoration: none; display: <%= (search || (typeof statusFilter !== 'undefined' && statusFilter !== 'all')) ? 'inline-flex' : 'none' %>; align-items: center;">Clear</a>
                    </form>
                </div>

                <!-- Directory Table -->
                <div class="table-responsive">
                    <table class="directory-table">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Email</th>
                                <th>Joined Date</th>
                                <th>Status</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="userTableBody">
                            <% if (users.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="no-results-cell">
                                        <div class="empty-search-container">
                                            <div class="empty-search-icon">
                                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                    <circle cx="11" cy="11" r="8"></circle>
                                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                                    <line x1="8" y1="11" x2="14" y2="11"></line>
                                                </svg>
                                            </div>
                                            <h4 class="empty-search-title">No Users Found</h4>
                                            <% if (search) { %>
                                                <p class="empty-search-desc">
                                                    No customer accounts found starting with or matching "<span class="search-term-highlight"><%= search %></span>".
                                                </p>
                                                <button type="button" class="btn-clear-search" onclick="clearLiveSearch()">Clear Search</button>
                                            <% } else { %>
                                                <p class="empty-search-desc">
                                                    No customer accounts found matching your selected filters.
                                                </p>
                                                <button type="button" class="btn-clear-search" onclick="resetAllFilters()">Reset Filters</button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% users.forEach(user => { %>
                                    <tr>
                                        <!-- User Name & Avatar -->
                                        <td>
                                            <div class="user-cell">
                                                <% if (user.imgUrl) { %>
                                                    <img src="<%= user.imgUrl %>" alt="<%= user.name %>" class="user-avatar" />
                                                <% } else { %>
                                                    <div class="user-avatar"><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %></div>
                                                <% } %>
                                                <span class="user-name"><%= user.name %></span>
                                            </div>
                                        </td>

                                        <!-- Email -->
                                        <td style="color: #666666;"><%= user.email %></td>

                                        <!-- Joined Date -->
                                        <td><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A' %></td>

                                        <!-- Status -->
                                        <td>
                                            <% if (user.isBlocked) { %>
                                                <span class="badge-status badge-blocked">Blocked</span>
                                            <% } else if (!user.isVerified) { %>
                                                <span class="badge-status badge-inactive">Inactive</span>
                                            <% } else { %>
                                                <span class="badge-status badge-active">Active</span>
                                            <% } %>
                                        </td>

                                        <!-- Actions (Block/Unblock) -->
                                        <td style="text-align: right;">
                                            <div class="action-buttons-group">
                                                <% if (user.isBlocked) { %>
                                                    <form action="/admin/users/<%= user._id %>/unblock" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to unblock <%= user.name %>?');">
                                                        <input type="hidden" name="search" value="<%= search || '' %>">
                                                        <input type="hidden" name="status" value="<%= typeof statusFilter !== 'undefined' ? statusFilter : 'all' %>">
                                                        <input type="hidden" name="limit" value="<%= typeof limit !== 'undefined' ? limit : 4 %>">
                                                        <input type="hidden" name="page" value="<%= currentPage %>">
                                                        <button type="submit" class="btn-pill-unblock">Unblock</button>
                                                    </form>
                                                <% } else { %>
                                                    <form action="/admin/users/<%= user._id %>/block" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to block <%= user.name %>?');">
                                                        <input type="hidden" name="search" value="<%= search || '' %>">
                                                        <input type="hidden" name="status" value="<%= typeof statusFilter !== 'undefined' ? statusFilter : 'all' %>">
                                                        <input type="hidden" name="limit" value="<%= typeof limit !== 'undefined' ? limit : 4 %>">
                                                        <input type="hidden" name="page" value="<%= currentPage %>">
                                                        <button type="submit" class="btn-pill-block">Block</button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Footer Pagination Controls -->
                <div class="directory-footer">
                    <div id="paginationInfo">
                        Showing <strong><%= users.length > 0 ? (currentPage - 1) * limit + 1 : 0 %></strong> to <strong><%= Math.min(currentPage * limit, totalUsers) %></strong> of <strong><%= totalUsers %></strong> entries
                    </div>

                    <div class="pagination-group" id="paginationGroup">
                        <% if (currentPage > 1) { %>
                            <a href="/admin/users?page=<%= currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= statusFilter !== 'all' ? '&status=' + statusFilter : '' %>&limit=<%= limit %>" class="page-btn">
                                &larr; Previous
                            </a>
                        <% } else { %>
                            <span class="page-btn" style="opacity: 0.4; cursor: not-allowed;">&larr; Previous</span>
                        <% } %>

                        <% for (let page = 1; page <= totalPages; page++) { %>
                            <a href="/admin/users?page=<%= page %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= statusFilter !== 'all' ? '&status=' + statusFilter : '' %>&limit=<%= limit %>" class="page-btn <%= page === currentPage ? 'active' : '' %>">
                                <%= page %>
                            </a>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="/admin/users?page=<%= currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= statusFilter !== 'all' ? '&status=' + statusFilter : '' %>&limit=<%= limit %>" class="page-btn">
                                Next &rarr;
                            </a>
                        <% } else { %>
                            <span class="page-btn" style="opacity: 0.4; cursor: not-allowed;">Next &rarr;</span>
                        <% } %>
                    </div>
                </div>

            </div>

        </main>

    </div>

    <!-- Live Dynamic Search & Filter Script -->
    <script>
        const searchInput = document.getElementById('searchInput');
        const clearSearchBtn = document.getElementById('clearSearchBtn');
        const statusFilter = document.getElementById('statusFilter');
        const limitFilter = document.getElementById('limitFilter');
        const clearFilterLink = document.getElementById('clearFilterLink');
        const userTableBody = document.getElementById('userTableBody');
        const paginationInfo = document.getElementById('paginationInfo');
        const paginationGroup = document.getElementById('paginationGroup');
        const userFilterForm = document.getElementById('userFilterForm');

        let debounceTimeout = null;
        let currentAbortController = null;

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        async function fetchUsers(page = 1) {
            const query = searchInput ? searchInput.value.trim() : '';
            const status = statusFilter ? statusFilter.value : 'all';
            const limit = limitFilter ? limitFilter.value : '4';

            // Toggle clear button and link visibility
            if (clearSearchBtn) {
                clearSearchBtn.style.display = searchInput && searchInput.value.length > 0 ? 'flex' : 'none';
            }
            if (clearFilterLink) {
                clearFilterLink.style.display = (query || status !== 'all') ? 'inline-flex' : 'none';
            }

            // Sync URL parameters in browser history
            const params = new URLSearchParams();
            if (query) params.set('search', query);
            if (status && status !== 'all') params.set('status', status);
            if (limit && limit !== '4') params.set('limit', limit);
            if (page > 1) params.set('page', page);
            const newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
            window.history.replaceState(null, '', newUrl);

            // Abort previous in-flight request if user keeps typing
            if (currentAbortController) {
                currentAbortController.abort();
            }
            currentAbortController = new AbortController();

            try {
                const fetchParams = new URLSearchParams({
                    search: query,
                    status: status,
                    limit: limit,
                    page: page,
                    format: 'json'
                });

                const res = await fetch(`/admin/users?${fetchParams.toString()}`, {
                    signal: currentAbortController.signal,
                    headers: { 'Accept': 'application/json' }
                });

                if (!res.ok) return;
                const data = await res.json();
                if (!data.success) return;

                renderTable(data);
                renderPagination(data);
            } catch (err) {
                if (err.name !== 'AbortError') {
                    console.error('Dynamic search fetch error:', err);
                }
            }
        }

        function renderTable(data) {
            const users = data.users || [];
            const query = data.search || '';

            if (users.length === 0) {
                userTableBody.innerHTML = `
                    <tr>
                        <td colspan="5" class="no-results-cell">
                            <div class="empty-search-container">
                                <div class="empty-search-icon">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <circle cx="11" cy="11" r="8"></circle>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                        <line x1="8" y1="11" x2="14" y2="11"></line>
                                    </svg>
                                </div>
                                <h4 class="empty-search-title">No Users Found</h4>
                                ${query ? `
                                    <p class="empty-search-desc">
                                        No customer accounts found starting with or matching "<span class="search-term-highlight">${escapeHtml(query)}</span>".
                                    </p>
                                    <button type="button" class="btn-clear-search" onclick="clearLiveSearch()">Clear Search</button>
                                ` : `
                                    <p class="empty-search-desc">
                                        No customer accounts found matching your selected filters.
                                    </p>
                                    <button type="button" class="btn-clear-search" onclick="resetAllFilters()">Reset Filters</button>
                                `}
                            </div>
                        </td>
                    </tr>
                `;
                return;
            }

            let rowsHtml = '';
            users.forEach(user => {
                const initial = user.name ? escapeHtml(user.name.charAt(0).toUpperCase()) : 'U';
                const avatarHtml = user.imgUrl
                    ? `<img src="${escapeHtml(user.imgUrl)}" alt="${escapeHtml(user.name)}" class="user-avatar" />`
                    : `<div class="user-avatar">${initial}</div>`;

                const createdDate = user.createdAt
                    ? new Date(user.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
                    : 'N/A';

                let statusBadge = '';
                if (user.isBlocked) {
                    statusBadge = '<span class="badge-status badge-blocked">Blocked</span>';
                } else if (!user.isVerified) {
                    statusBadge = '<span class="badge-status badge-inactive">Inactive</span>';
                } else {
                    statusBadge = '<span class="badge-status badge-active">Active</span>';
                }

                const actionForm = user.isBlocked ? `
                    <form action="/admin/users/${user._id}/unblock" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to unblock ${escapeHtml(user.name)}?');">
                        <input type="hidden" name="search" value="${escapeHtml(data.search || '')}">
                        <input type="hidden" name="status" value="${escapeHtml(data.statusFilter || 'all')}">
                        <input type="hidden" name="limit" value="${data.limit}">
                        <input type="hidden" name="page" value="${data.currentPage}">
                        <button type="submit" class="btn-pill-unblock">Unblock</button>
                    </form>
                ` : `
                    <form action="/admin/users/${user._id}/block" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to block ${escapeHtml(user.name)}?');">
                        <input type="hidden" name="search" value="${escapeHtml(data.search || '')}">
                        <input type="hidden" name="status" value="${escapeHtml(data.statusFilter || 'all')}">
                        <input type="hidden" name="limit" value="${data.limit}">
                        <input type="hidden" name="page" value="${data.currentPage}">
                        <button type="submit" class="btn-pill-block">Block</button>
                    </form>
                `;

                rowsHtml += `
                    <tr>
                        <td>
                            <div class="user-cell">
                                ${avatarHtml}
                                <span class="user-name">${escapeHtml(user.name)}</span>
                            </div>
                        </td>
                        <td style="color: #666666;">${escapeHtml(user.email)}</td>
                        <td>${createdDate}</td>
                        <td>${statusBadge}</td>
                        <td style="text-align: right;">
                            <div class="action-buttons-group">
                                ${actionForm}
                            </div>
                        </td>
                    </tr>
                `;
            });

            userTableBody.innerHTML = rowsHtml;
        }

        function renderPagination(data) {
            const { users, currentPage, totalPages, totalUsers, limit } = data;
            const start = users.length > 0 ? (currentPage - 1) * limit + 1 : 0;
            const end = Math.min(currentPage * limit, totalUsers);

            if (paginationInfo) {
                paginationInfo.innerHTML = `Showing <strong>${start}</strong> to <strong>${end}</strong> of <strong>${totalUsers}</strong> entries`;
            }

            if (!paginationGroup) return;

            if (totalPages <= 1) {
                paginationGroup.innerHTML = '';
                return;
            }

            let paginationHtml = '';
            if (currentPage > 1) {
                paginationHtml += `<button type="button" class="page-btn" onclick="fetchUsers(${currentPage - 1})">&larr; Previous</button>`;
            } else {
                paginationHtml += `<span class="page-btn" style="opacity: 0.4; cursor: not-allowed;">&larr; Previous</span>`;
            }

            for (let p = 1; p <= totalPages; p++) {
                if (p === currentPage) {
                    paginationHtml += `<button type="button" class="page-btn active">${p}</button>`;
                } else {
                    paginationHtml += `<button type="button" class="page-btn" onclick="fetchUsers(${p})">${p}</button>`;
                }
            }

            if (currentPage < totalPages) {
                paginationHtml += `<button type="button" class="page-btn" onclick="fetchUsers(${currentPage + 1})">Next &rarr;</button>`;
            } else {
                paginationHtml += `<span class="page-btn" style="opacity: 0.4; cursor: not-allowed;">Next &rarr;</span>`;
            }

            paginationGroup.innerHTML = paginationHtml;
        }

        function clearLiveSearch() {
            if (searchInput) {
                searchInput.value = '';
                searchInput.focus();
            }
            if (clearSearchBtn) {
                clearSearchBtn.style.display = 'none';
            }
            fetchUsers(1);
        }

        function resetAllFilters() {
            if (searchInput) searchInput.value = '';
            if (statusFilter) statusFilter.value = 'all';
            if (limitFilter) limitFilter.value = '4';
            if (clearSearchBtn) clearSearchBtn.style.display = 'none';
            fetchUsers(1);
        }

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                const val = searchInput.value;
                if (clearSearchBtn) {
                    clearSearchBtn.style.display = val.length > 0 ? 'flex' : 'none';
                }
                clearTimeout(debounceTimeout);
                const delay = val.length === 0 ? 0 : 200;
                debounceTimeout = setTimeout(() => {
                    fetchUsers(1);
                }, delay);
            });

            searchInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    clearTimeout(debounceTimeout);
                    fetchUsers(1);
                }
            });
        }

        if (clearSearchBtn) {
            clearSearchBtn.addEventListener('click', clearLiveSearch);
        }

        if (statusFilter) {
            statusFilter.addEventListener('change', () => fetchUsers(1));
        }

        if (limitFilter) {
            limitFilter.addEventListener('change', () => fetchUsers(1));
        }

        if (userFilterForm) {
            userFilterForm.addEventListener('submit', (e) => {
                e.preventDefault();
                clearTimeout(debounceTimeout);
                fetchUsers(1);
            });
        }
    </script>
</body>

</html>