<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OTP Verification - ROYAL IGNITE Admin</title>
    <link rel="stylesheet" href="/css/admin/login.css" />
    <style>
        .otp-inputs {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin: 24px 0;
        }
        .otp-box {
            width: 52px;
            height: 60px;
            text-align: center;
            font-size: 24px;
            font-weight: 600;
            border: 1px solid var(--admin-border);
            border-radius: 8px;
            background: rgba(253, 252, 251, 0.8);
        }
        .otp-box:focus {
            outline: none;
            border-color: #000000;
            background: #FFFFFF;
            box-shadow: 0 0 0 2px rgba(0,0,0,0.1);
        }
        .timer-badge {
            text-align: center;
            font-size: 13px;
            color: var(--admin-text-muted);
            margin-bottom: 24px;
        }
        .timer-badge strong {
            color: var(--admin-text-dark);
        }
    </style>
</head>

<body>

    <!-- Admin Header Branding -->
    <div class="admin-header">
        <a href="/" class="admin-logo">ROYAL IGNITE</a>
        <span class="admin-badge">ADMIN PANEL</span>
    </div>

    <!-- OTP Card -->
    <main class="admin-card">
        
        <h1 class="admin-title">OTP Verification</h1>
        <p class="admin-subtitle">
            Enter the 6-digit verification code sent to your registered admin email address to continue securely.
        </p>

        <% if (typeof success !== "undefined" && success) { %>
            <div class="success-badge" style="background: #ECFDF5; border: 1px solid #A7F3D0; color: #065F46; padding: 10px 14px; border-radius: 8px; font-size: 13px; font-weight: 500; margin-bottom: 16px;">
                <%= success %>
            </div>
        <% } %>

        <% if (typeof error !== "undefined" && error) { %>
            <div class="error-badge"><%= error %></div>
        <% } %>

        <form action="/admin/verify-otp" method="POST" id="otpForm">
            
            <input type="hidden" name="otpCode" id="fullOtp" />

            <div class="otp-inputs" id="otpInputsContainer">
                <input type="text" maxlength="1" class="otp-box" pattern="[0-9]*" inputmode="numeric" autofocus />
                <input type="text" maxlength="1" class="otp-box" pattern="[0-9]*" inputmode="numeric" />
                <input type="text" maxlength="1" class="otp-box" pattern="[0-9]*" inputmode="numeric" />
                <input type="text" maxlength="1" class="otp-box" pattern="[0-9]*" inputmode="numeric" />
                <input type="text" maxlength="1" class="otp-box" pattern="[0-9]*" inputmode="numeric" />
                <input type="text" maxlength="1" class="otp-box" pattern="[0-9]*" inputmode="numeric" />
            </div>

            <div class="timer-badge">
                ⏱ Code expires in <strong id="timer">10:00</strong>
            </div>

            <button type="submit" class="primary-btn">
                VERIFY OTP &rarr;
            </button>

        </form>

        <div style="text-align: center; margin-top: 24px; font-size: 13px; color: var(--admin-text-muted);">
            Didn't receive the code? 
            <form action="/admin/resend-otp" method="POST" style="display: inline;">
                <button type="submit" style="background: none; border: none; font-weight: 600; color: var(--gold-dark); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; font-family: inherit; font-size: 13px; transition: color 0.2s;" onmouseover="this.style.color='var(--gold-primary)'" onmouseout="this.style.color='var(--gold-dark)'">Resend OTP</button>
            </form>
        </div>

        <div style="text-align: center; margin-top: 16px;">
            <a href="/admin/login" class="forgot-link" style="display: inline-flex; align-items: center; gap: 6px;">
                &larr; Back to Login
            </a>
        </div>

    </main>

    <!-- Bottom Security Note -->
    <div class="security-note-box">
        <div class="shield-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
        </div>
        <div class="security-note-title">Secure Verification</div>
        <div class="security-note-desc">
            Your OTP helps ensure secure access to the ROYAL IGNITE admin panel.
        </div>
    </div>

    <script>
        const boxes = document.querySelectorAll('.otp-box');
        const fullOtp = document.getElementById('fullOtp');
        const form = document.getElementById('otpForm');

        function combineOtp() {
            fullOtp.value = Array.from(boxes).map(b => b.value).join('');
        }

        boxes.forEach((box, idx) => {
            box.addEventListener('input', (e) => {
                if (e.target.value && idx < boxes.length - 1) {
                    boxes[idx + 1].focus();
                }
                combineOtp();
            });

            box.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !box.value && idx > 0) {
                    boxes[idx - 1].focus();
                }
            });

            box.addEventListener('paste', (e) => {
                e.preventDefault();
                const pasteData = (e.clipboardData || window.clipboardData).getData('text').trim();
                if (pasteData.length === 6 && /^\d+$/.test(pasteData)) {
                    boxes.forEach((b, i) => {
                        b.value = pasteData[i] || '';
                    });
                    combineOtp();
                    boxes[5].focus();
                }
            });
        });

        form.addEventListener('submit', function(e) {
            combineOtp();
            if (!fullOtp.value || fullOtp.value.length !== 6) {
                e.preventDefault();
                alert('Please enter all 6 digits of the OTP code.');
            }
        });

        // Timer Countdown (10 Minutes)
        let duration = 600;
        const timerEl = document.getElementById('timer');
        const interval = setInterval(() => {
            const min = String(Math.floor(duration / 60)).padStart(2, '0');
            const sec = String(duration % 60).padStart(2, '0');
            if (timerEl) timerEl.textContent = `${min}:${sec}`;
            if (--duration < 0) {
                clearInterval(interval);
                if (timerEl) timerEl.textContent = 'Expired';
            }
        }, 1000);
    </script>

</body>

</html>
