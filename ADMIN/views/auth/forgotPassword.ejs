<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - ROYAL IGNITE Admin</title>
    <link rel="stylesheet" href="/css/admin/login.css" />
</head>

<body>

    <!-- Admin Header Branding -->
    <div class="admin-header">
        <a href="/" class="admin-logo">ROYAL IGNITE</a>
        <span class="admin-badge">ADMIN PANEL</span>
    </div>

    <!-- Forgot Password Card -->
    <main class="admin-card">
        
        <h1 class="admin-title">Forgot Password?</h1>
        <p class="admin-subtitle">
            Enter your registered admin email address to receive a secure OTP verification code.
        </p>

        <% if (typeof error !== "undefined" && error) { %>
            <div class="error-badge"><%= error %></div>
        <% } %>

        <form action="/admin/forgot-password" method="POST" id="adminForgotPasswordForm" novalidate>
            
            <div class="form-group">
                <label for="email">EMAIL ADDRESS</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    class="form-input"
                    placeholder="Enter your admin email"
                    value="<%= typeof email !== 'undefined' ? email : '' %>"
                    data-validate="email"
                    required
                />
            </div>

            <button type="submit" class="primary-btn">
                SEND OTP
            </button>

        </form>

        <div style="text-align: center; margin-top: 24px;">
            <a href="/admin/login" class="forgot-link" style="display: inline-flex; align-items: center; gap: 6px;">
                &larr; Back to Login
            </a>
        </div>

    </main>

    <!-- Bottom Security Note -->
    <div class="security-note-box">
        <div class="shield-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
        </div>
        <div class="security-note-title">Secure Password Recovery</div>
        <div class="security-note-desc">
            OTP verification helps protect your ROYAL IGNITE management panel access.
        </div>
    </div>

    <script src="/js/validation.js"></script>

</body>

</html>
