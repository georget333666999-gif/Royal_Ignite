<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/admin/login.css" />
</head>

<body>

    <!-- Admin Header Branding -->
    <div class="admin-header">
        <a href="/" class="admin-logo">ROYAL IGNITE</a>
        <span class="admin-badge">ADMIN PANEL</span>
    </div>

    <!-- Login Card -->
    <main class="admin-card">
        
        <h1 class="admin-title">Welcome Back</h1>
        <p class="admin-subtitle">
            Sign in to manage products, orders, customers, and store analytics.
        </p>

        <% if (typeof error !== "undefined" && error) { %>
            <div class="error-badge"><%= error %></div>
        <% } %>

        <form action="/admin/login" method="POST">
            
            <div class="form-group">
                <label for="email">EMAIL ADDRESS</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    class="form-input"
                    placeholder="Enter your admin email"
                    value="<%= typeof email !== 'undefined' ? email : '' %>"
                    required
                />
            </div>

            <div class="form-group">
                <div class="form-header-flex">
                    <label for="password">PASSWORD</label>
                    <a href="/admin/forgot-password" class="forgot-link">Forgot Password?</a>
                </div>
                <input
                    type="password"
                    id="password"
                    name="password"
                    class="form-input"
                    placeholder="Enter your password"
                    required
                />
            </div>

            <button type="submit" class="primary-btn">
                LOGIN TO DASHBOARD
            </button>

        </form>

        <div class="divider-container">
            <div class="divider-line"></div>
            <span class="divider-text">OR CONTINUE WITH</span>
            <div class="divider-line"></div>
        </div>

        <a href="/auth/google" class="google-btn">
            <svg width="18" height="18" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            Sign in with Google
        </a>

    </main>

    <!-- Bottom Security Note -->
    <div class="security-note-box">
        <div class="shield-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
        </div>
        <div class="security-note-title">Protected Admin Access</div>
        <div class="security-note-desc">
            Only authorized administrators can access the ROYAL IGNITE management panel.
        </div>
    </div>

    <div class="admin-footer-links">
        <a href="#">Help Center</a> &bull; <a href="#">Contact Support</a>
    </div>

</body>

</html>