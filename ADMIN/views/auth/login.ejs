<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - ROYAL IGNITE</title>
    <link rel="stylesheet" href="/css/admin/login.css" />
</head>

<body class="admin-auth-page">

    <!-- Ambient Glow Background Canvas -->
    <div class="admin-ambient-glow" aria-hidden="true"></div>
    <div class="admin-pattern-overlay" aria-hidden="true"></div>

    <div class="admin-page-container">
        
        <!-- Admin Header Branding -->
        <header class="admin-header">
            <a href="/" class="admin-logo-link" title="Royal Ignite Homepage">
                <div class="admin-emblem-badge">
                    <svg class="emblem-flame-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                        <defs>
                            <linearGradient id="adminFlameGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" stop-color="#fbc275" />
                                <stop offset="100%" stop-color="#d48833" />
                            </linearGradient>
                        </defs>
                        <path fill="url(#adminFlameGrad)" d="M12 2.5C11.2 5.8 8.5 8.3 8.5 11.8C8.5 14.2 9.9 16.1 11.2 17C10.7 15.3 11.3 13.8 12.3 12.7C13.2 14.2 14.8 15.4 14.8 17.5C14.8 19.4 13.5 21 12 21.8C16.8 21.2 19.5 17.2 19.5 13.2C19.5 7.8 14.2 4.8 12 2.5Z"/>
                    </svg>
                </div>
                <span class="admin-logo">ROYAL IGNITE</span>
            </a>
            <div class="admin-badge-row">
                <span class="admin-badge">
                    <span class="pulse-indicator"></span>
                    EXECUTIVE PORTAL
                </span>
            </div>
        </header>

        <!-- Login Card -->
        <main class="admin-card">
            
            <div class="card-accent-line"></div>

            <div class="card-headings">
                <h1 class="admin-title">Welcome Back</h1>
                <p class="admin-subtitle">
                    Enter your administrative credentials to manage orders, catalog, customers, and analytics.
                </p>
            </div>

            <% if (typeof error !== "undefined" && error) { %>
                <div class="error-badge">
                    <svg class="error-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/admin/login" method="POST" id="adminLoginForm" novalidate>
                
                <div class="form-group">
                    <label for="email">ADMINISTRATOR EMAIL</label>
                    <div class="input-wrapper">
                        <svg class="field-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-input has-icon"
                            placeholder="admin@royalignite.com"
                            value="<%= typeof email !== 'undefined' ? email : '' %>"
                            data-validate="email"
                            required
                            autocomplete="username"
                        />
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-header-flex">
                        <label for="password">SECURE PASSWORD</label>
                        <a href="/admin/forgot-password" class="forgot-link">Forgot Password?</a>
                    </div>
                    <div class="password-wrap">
                        <svg class="field-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-input has-icon"
                            placeholder="Enter password"
                            data-validate="password"
                            required
                            autocomplete="current-password"
                        />
                    </div>
                </div>

                <button type="submit" class="primary-btn" id="loginSubmitBtn">
                    <span class="btn-text">SIGN IN TO DASHBOARD</span>
                    <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>

            </form>

            <div class="divider-container">
                <div class="divider-line"></div>
                <span class="divider-text">OR CONTINUE WITH</span>
                <div class="divider-line"></div>
            </div>

            <a href="/auth/google" class="google-btn">
                <svg class="google-svg" width="18" height="18" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                </svg>
                <span>Sign in with Google Workspace</span>
            </a>

            <!-- Security Footer inside Card -->
            <div class="card-security-footer">
                <div class="security-chip">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    <span>256-Bit SSL Encrypted Admin Access</span>
                </div>
            </div>

        </main>

        <!-- Bottom Security & Navigation Info -->
        <footer class="admin-page-footer">
            <div class="security-note-box">
                <div class="shield-badge">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#b87328" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <div class="security-note-content">
                    <div class="security-note-title">Authorized Personnel Only</div>
                    <div class="security-note-desc">
                        Unauthorized access attempts to the ROYAL IGNITE executive panel are monitored and logged for security compliance.
                    </div>
                </div>
            </div>

            <div class="admin-footer-links">
                <a href="#">System Status</a>
                <span class="bullet-sep">&bull;</span>
                <a href="#">Security Protocol</a>
                <span class="bullet-sep">&bull;</span>
                <a href="#">Contact Support</a>
            </div>
            <p class="admin-copyright">&copy; <%= new Date().getFullYear() %> ROYAL IGNITE. All rights reserved.</p>
        </footer>

    </div>

    <script src="/js/validation.js"></script>

</body>

</html>