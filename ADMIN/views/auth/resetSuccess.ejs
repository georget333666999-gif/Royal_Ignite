<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful - ROYAL IGNITE Admin</title>
    <link rel="stylesheet" href="/css/admin/login.css" />
    <style>
        .success-circle {
            width: 74px;
            height: 74px;
            background: #ECFDF5;
            border: 1px solid #D0FAE5;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            color: #009966;
        }
    </style>
</head>

<body>

    <!-- Admin Header Branding -->
    <div class="admin-header">
        <a href="/" class="admin-logo">ROYAL IGNITE</a>
        <span class="admin-badge">ADMIN PANEL</span>
    </div>

    <!-- Success Card -->
    <main class="admin-card" style="text-align: center;">
        
        <div class="success-circle">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </div>

        <h1 class="admin-title">Password Reset Successful</h1>
        <p class="admin-subtitle">
            Your admin password has been updated securely. You can now access your ROYAL IGNITE management dashboard using your new credentials.
        </p>

        <a href="/admin/login" class="google-btn" style="background: #000000; color: #FFFFFF; height: 56px; text-decoration: none;">
            Back to Login &rarr;
        </a>

    </main>

    <!-- Bottom Security Note -->
    <div class="security-note-box">
        <div class="shield-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
        </div>
        <div class="security-note-title">Protected Admin Access</div>
        <div class="security-note-desc">
            Your ROYAL IGNITE account security has been verified and updated.
        </div>
    </div>

    <div class="admin-footer-links">
        <a href="#">Help Center</a> &bull; <a href="#">Contact Support</a>
    </div>

</body>

</html>
